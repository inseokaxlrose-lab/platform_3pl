# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# 브라우저 테스트(Playwright) 결과·빌드 폴더
/test-results/
/playwright-report/
/.next-e2e/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generate로 만들어지는 코드
/src/generated/

# 지역 마스터 원본 파일 (주소DB·법정동코드, npm run region:load가 읽는다 — 크고 공공 원본이라 저장소에 두지 않는다)
/data/region/
