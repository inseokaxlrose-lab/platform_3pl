// DB 구조 설계도
// 문서: https://pris.ly/d/prisma-schema
// 데이터 구조 결정: docs/decisions/0003-domain-model.md, 0010-auth-and-permission-model.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// 연결 주소는 prisma.config.ts(명령어용)와 src/lib/prisma.ts(앱 실행용)에서 지정한다
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증 (Better Auth)
// user / session / account / verification 은 Better Auth가 사용하는 표다.
// `npx auth generate`로 만든 뒤 우리 정보(userType, isActive, 권한 연결)를 더했다.
// Better Auth 필드 이름·구조는 바꾸지 않는다.
// ─────────────────────────────────────────────

// 사용자 유형: 데이터 범위(볼 수 있는 데이터)를 정하는 기준
enum UserType {
  OPERATOR // 운영사 → 전체
  CENTER // 센터 운영자·작업자 → 소속 센터
  SHIPPER // 화주사 사용자 → 자기 화주사
}

model User {
  id              BigInt   @id @default(autoincrement()) @map("user_id")
  name            String   @map("user_nm")
  // 아이디 로그인을 쓰므로 이메일이 없는 사용자는 내부용 주소를 자동으로 채운다 (사용자 관리 작업에서)
  email           String
  emailVerified   Boolean  @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy       String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy       String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion      Int      @default(1) @map("row_version")
  // 로그인 아이디 (username 플러그인)
  username        String?
  displayUsername String?  @map("display_username")
  userType        UserType @map("user_type_cd")
  // false면 로그인·사용 불가 (퇴사자 등). 기록 보존을 위해 계정을 지우지 않고 막는다
  isActive        Boolean  @default(true) @map("is_active")
  // 화주사 사용자의 소속 화주사 (화주사 사용자만, DB 검사 조건으로 강제: tb_user_shipper_matches_type)
  shipperId       BigInt?  @map("shipper_id")
  shipper         Shipper? @relation(fields: [shipperId], references: [id], onDelete: Restrict)

  sessions            Session[]
  accounts            Account[]
  permissionGroups    UserPermissionGroup[]
  permissionOverrides UserPermissionOverride[]
  // 센터 직원의 소속 센터 (여러 개 가능)
  centers             UserCenter[]
  // 목록 그리드 개인 설정 (숨긴 컬럼·순서·너비 등)
  gridSettings        UserGridSetting[]
  // 사이드바 즐겨찾기 메뉴
  favoriteMenus       UserFavoriteMenu[]
  // 운영사 정보를 마지막으로 고친 기록

  @@unique([email])
  @@unique([username])
  @@index([shipperId])
  @@map("tb_user")
}

model Session {
  id        BigInt   @id @default(autoincrement()) @map("session_id")
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("tb_session")
}

// 로그인 수단: 아이디·비밀번호 로그인의 비밀번호(암호화된 값)가 여기에 저장된다
model Account {
  id                    BigInt    @id @default(autoincrement()) @map("acct_id")
  accountId             String    @map("provider_account_id")
  providerId            String    @map("provider_id")
  userId                BigInt    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("tb_account")
}

model Verification {
  id         BigInt   @id @default(autoincrement()) @map("verification_id")
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("tb_verification")
}

// ─────────────────────────────────────────────
// 권한 (0003 결정 7)
// 최종 권한 = 그룹 권한 합 + 사용자 추가(GRANT) − 사용자 제외(DENY)
// 권한 코드(예: inbound.asn.create)는 코드 한 곳에서 목록으로 관리하고, DB에는 코드 글자만 저장한다
// ─────────────────────────────────────────────

// 화면 영역: ADMIN = 운영사 화면(/admin), PORTAL = 화주 포털(/portal)
enum AppArea {
  ADMIN
  PORTAL
}

// 권한그룹: 권한 코드 묶음 (예: "센터 운영자", "화주 담당자")
model PermissionGroup {
  id          BigInt   @id @default(autoincrement()) @map("perm_group_id")
  name        String   @unique @map("perm_group_nm")
  // 이 그룹이 다루는 영역: 그 영역의 권한만 담고, 맞는 유형의 사용자에게만 배정한다 (등록 후 변경 불가)
  area        AppArea  @default(ADMIN) @map("app_area_cd")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int      @default(1) @map("row_version")

  permissions PermissionGroupPermission[]
  users       UserPermissionGroup[]

  @@map("tb_perm_group")
}

// 권한그룹에 들어 있는 권한 코드 (그룹을 지우면 함께 지워진다)
model PermissionGroupPermission {
  groupId        BigInt          @map("group_id")
  permissionCode String          @map("perm_cd")
  group          PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionCode])
  @@map("tb_perm_group_perm")
}

// 사용자 ↔ 권한그룹 (한 사용자가 여러 그룹에 속할 수 있다)
// 사용자가 남아 있는 그룹은 지울 수 없다 (Restrict): 실수로 여러 사람의 권한이 사라지는 것을 막는다
model UserPermissionGroup {
  userId    BigInt          @map("user_id")
  groupId   BigInt          @map("group_id")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("tb_user_perm_group")
}

enum PermissionEffect {
  GRANT // 그룹에 없어도 이 사용자에게 추가
  DENY // 그룹에 있어도 이 사용자에게서 제외
}

// 사용자별 권한 예외: 같은 사용자·같은 코드에는 하나만 (추가와 제외가 동시에 있을 수 없다)
model UserPermissionOverride {
  userId         BigInt           @map("user_id")
  permissionCode String           @map("perm_cd")
  effect         PermissionEffect @map("effect_cd")
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("tb_user_perm_override")
}

// ─────────────────────────────────────────────
// 조직 (0003 결정 1) — 데이터 범위에 필요한 최소 정보만. 자세한 정보는 M2(센터)·M3(화주사)에서 추가
// ─────────────────────────────────────────────

// 센터: 운영사의 물류센터
// 센터: 운영사의 물류센터 (docs/decisions/0026)
// 코드 3층 (0025): systemCode(자동·불변) / code(사용자 코드, 전체에서 중복 금지) / 외부 코드(ExternalCode)
model Center {
  id            BigInt   @id @default(autoincrement()) @map("center_id")
  // 시스템 코드: CT000001 (라벨·문서·이력에 쓰는 불변 코드)
  systemCode    String   @unique @map("sys_cd")
  // 사용자 코드: 화면 검색·표시용 (바꿀 수 있음)
  code          String   @unique @map("center_cd")
  name          String   @map("center_nm")
  // 전화번호는 하이픈 없이 숫자만 (0029)
  phone         String?  @map("tel_no")
  fax           String?  @map("fax_no")
  managerName   String?  @map("manager_nm")
  managerPhone  String?  @map("manager_tel_no")
  zipCode       String?  @map("zip_cd")
  address       String?  @map("addr1")
  addressDetail String?  @map("addr2")
  // false면 데이터 범위에서 빠진다 (소속 직원도 이 센터 데이터를 볼 수 없음)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy     String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy     String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion    Int      @default(1) @map("row_version")

  users         UserCenter[]
  warehouses    Warehouse[]
  deliveryZones DeliveryZone[]
  shippers      ShipperCenter[]

  @@map("tb_center")
}

// 창고 보관 조건 (docs/decisions/0027): 냉장 물건을 상온 창고에 적치하는 실수를 나중에 경고하는 데 쓴다
enum StorageCondition {
  // 상온
  AMBIENT
  // 냉장
  CHILLED
  // 냉동
  FROZEN
}

enum WarehouseType {
  // 일반 보관 창고
  GENERAL
  // 입고대기 창고: 입고 확정 후 적치 전까지 재고가 머무는 곳 (센터마다 1개, 센터 등록 시 자동 생성)
  INBOUND_STAGING
}

// 창고: 센터 안의 보관 구역 (관리 화면은 "센터별 창고 관리" 작업에서)
model Warehouse {
  id               BigInt           @id @default(autoincrement()) @map("warehouse_id")
  centerId         BigInt           @map("center_id")
  // 시스템 코드: WH000001
  systemCode       String           @unique @map("sys_cd")
  // 사용자 코드: 같은 센터 안에서 중복 금지
  code             String           @map("warehouse_cd")
  name             String           @map("warehouse_nm")
  type             WarehouseType    @default(GENERAL) @map("warehouse_type_cd")
  storageCondition StorageCondition @default(AMBIENT) @map("temp_zone_cd")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy        String           @default("system") @map("created_by") @db.VarChar(50)
  updatedBy        String           @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion       Int              @default(1) @map("row_version")
  center           Center           @relation(fields: [centerId], references: [id], onDelete: Restrict)
  locations        Location[]

  // 센터마다 입고대기 창고 1개: 마이그레이션 SQL의 부분 고유 인덱스 tb_warehouse_one_inbound_per_center
  @@unique([centerId, code])
  @@index([centerId])
  @@map("tb_warehouse")
}

// 로케이션: 창고 안의 보관 위치. 코드 자체가 위치라 시스템 코드는 없다 (0025)
// 코드는 등록 후 바꿀 수 없다 (재고·적치 기록이 이 주소를 가리킨다, 0028)
model Location {
  id          BigInt    @id @default(autoincrement()) @map("location_id")
  warehouseId BigInt    @map("warehouse_id")
  // 같은 창고 안에서 중복 금지 (예: A-01-01, DEFAULT)
  code        String    @map("location_cd")
  // 일괄 생성으로 만들면 함께 저장: 구역(A) / 열(01) / 단(02) — 구역별 거르기·정렬용 (docs/decisions/0028)
  zone        String?   @map("zone_cd")
  aisle       String?   @map("aisle_cd")
  level       String?   @map("level_cd")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int       @default(1) @map("row_version")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, code])
  @@index([warehouseId, zone])
  @@map("tb_location")
}

// 화주사: 운영사에 물건 보관·배송을 맡기는 회사
// 라벨 단위: 입고 라벨을 붙이는 단위 (0003 결정 7)
enum LabelUnit {
  PLT
  BOX
}

// 화주사 (docs/decisions/0035)
// 코드 3층 (0025): systemCode SH000001(자동·불변) / code(사용자 코드, 전체에서 중복 금지) / 외부 코드(ExternalCode)
model Shipper {
  id             BigInt    @id @default(autoincrement()) @map("shipper_id")
  systemCode     String    @unique @map("sys_cd")
  code           String    @unique @map("shipper_cd")
  name           String    @map("shipper_nm")
  // 사업자등록번호·전화번호는 하이픈 없이 숫자만 (0029)
  businessNumber String?   @map("biz_reg_no")
  ceoName        String?   @map("ceo_nm")
  businessType   String?   @map("biz_condition")
  businessItem   String?   @map("biz_item")
  phone          String?   @map("tel_no")
  fax            String?   @map("fax_no")
  email          String?
  zipCode        String?   @map("zip_cd")
  address        String?   @map("addr1")
  addressDetail  String?   @map("addr2")
  // 품목 기본값: 품목에서 그대로 쓰거나 개별 지정한다 (0003 결정 2)
  useLot         String    @default("N") @map("lot_mgmt_yn") @db.Char(1)
  useExpiry      String    @default("N") @map("expiry_mgmt_yn") @db.Char(1)
  labelUnit      LabelUnit @default(PLT) @map("label_unit_cd")
  // false면 데이터 범위에서 빠진다 (소속 사용자도 데이터를 볼 수 없음)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy      String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy      String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion     Int       @default(1) @map("row_version")

  users    User[]
  centers  ShipperCenter[]
  contacts ShipperContact[]

  @@map("tb_shipper")
}

// 화주사의 이용 센터 (화주사 ↔ 센터, 1개 이상) — 센터 직원은 자기 센터를 이용하는 화주사만 본다
model ShipperCenter {
  shipperId BigInt  @map("shipper_id")
  centerId  BigInt  @map("center_id")
  shipper   Shipper @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([shipperId, centerId])
  @@index([centerId])
  @@map("tb_shipper_center")
}

// 화주사 담당자 (운영사 담당자와 같은 모양: 최대 5명, 대표 1명, 담당 업무는 공통코드 CONTACT_DUTY)
model ShipperContact {
  id        BigInt  @id @default(autoincrement()) @map("contact_id")
  shipperId BigInt  @map("shipper_id")
  sortOrder Int     @map("sort_seq")
  duty      String  @map("role_cd")
  name      String  @map("contact_nm")
  phone     String? @map("tel_no")
  email     String?
  isPrimary String  @default("N") @map("primary_yn") @db.Char(1)
  shipper   Shipper @relation(fields: [shipperId], references: [id], onDelete: Cascade)

  @@index([shipperId, sortOrder])
  @@map("tb_shipper_contact")
}

// 센터 직원 ↔ 소속 센터 (한 직원이 여러 센터를 맡을 수 있다)
// 직원이 소속된 센터는 지울 수 없다 (Restrict)
model UserCenter {
  userId    BigInt   @map("user_id")
  centerId  BigInt   @map("center_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([userId, centerId])
  @@index([centerId])
  @@map("tb_user_center")
}

// 사용자별 목록 그리드 설정: 사용자 + 그리드 이름(DataGrid id) 하나에 한 줄 (docs/decisions/0021)
// settings 모양은 src/components/data-grid/settings.ts의 gridSettingsSchema (읽을 때 검사, 깨지면 기본값)
model UserGridSetting {
  userId    BigInt   @map("user_id")
  gridId    String   @map("grid_cd")
  settings  Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gridId])
  @@map("tb_user_grid_setting")
}

// 사용자별 사이드바 즐겨찾기 메뉴 (docs/decisions/0022)
// 메뉴는 주소(href)로 구분한다 (메뉴 목록: src/config/navigation.ts). 추가한 순서(createdAt)대로 보여준다
// 권한이 사라지거나 목록에서 없어진 메뉴는 화면에서만 숨기고 기록은 남긴다 (권한이 돌아오면 다시 보임)
model UserFavoriteMenu {
  userId    BigInt   @map("user_id")
  href      String   @map("menu_href")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, href])
  @@map("tb_user_favorite_menu")
}

// 운영사 정보 (docs/decisions/0024)
// MVP는 운영사 1곳 → 고정 키 1 한 줄 (M2.5 3단계 멀티테넌트에서 여러 줄로). 여러 운영사 SaaS로 바뀌면 회사 단위 기준이 된다
model Company {
  id             BigInt           @id @default(autoincrement()) @map("operator_id")
  name           String           @map("operator_nm")
  // 사업자등록번호·전화번호는 하이픈 없이 숫자만 (검증번호 확인 후, 0029)
  businessNumber String           @map("biz_reg_no")
  ceoName        String?          @map("ceo_nm")
  // 업태 / 종목 (거래명세서·세금계산서용)
  businessType   String?          @map("biz_condition")
  businessItem   String?          @map("biz_item")
  phone          String?          @map("tel_no")
  fax            String?          @map("fax_no")
  email          String?
  // 주소: 카카오 우편번호 서비스로 검색해 채우고, 상세주소만 직접 입력
  zipCode        String?          @map("zip_cd")
  address        String?          @map("addr1")
  addressDetail  String?          @map("addr2")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy      String           @default("system") @map("created_by") @db.VarChar(50)
  updatedBy      String           @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion     Int              @default(1) @map("row_version")
  contacts       CompanyContact[]

  @@map("tb_operator")
}

// 운영사 담당자 (최대 5명, 화면에서 정한 순서대로)
model CompanyContact {
  id        BigInt  @id @default(autoincrement()) @map("contact_id")
  companyId BigInt  @map("company_id")
  sortOrder Int     @map("sort_seq")
  // 담당 업무: 공통코드 CONTACT_DUTY의 코드 (예: INBOUND, 0030)
  duty      String  @map("role_cd")
  name      String  @map("contact_nm")
  phone     String? @map("tel_no")
  email     String?
  // 대표 담당자 (담당자가 있으면 정확히 1명)
  isPrimary String  @default("N") @map("primary_yn") @db.Char(1)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
  @@map("tb_operator_contact")
}

// 외부 코드 매핑 (docs/decisions/0025): 우리 기준정보 ↔ SAP·ERP 등 외부 시스템 코드
// 한 줄 = 연동 상대 + 대상 종류 + 대상 id + 외부 코드
// - 같은 연동 상대·같은 종류 안에서 외부 코드 중복 금지
// - 한 대상은 연동 상대마다 외부 코드 1개
model ExternalCode {
  id         BigInt             @id @default(autoincrement()) @map("ext_code_id")
  // 연동 상대 키 (src/config/external-systems.ts)
  system     String             @map("ext_system_cd")
  entityType ExternalEntityType @map("entity_type_cd")
  entityId   BigInt             @map("entity_id")
  code       String             @map("ext_cd")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([system, entityType, code])
  @@unique([system, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tb_ext_code")
}

enum ExternalEntityType {
  CENTER
  WAREHOUSE
  LOCATION
  SHIPPER
  ITEM
  CUSTOMER
  DELIVERY_ZONE
  UNIT
}

// ── 공통코드 (docs/decisions/0030): 코드 그룹(서랍) → 코드(서랍 속 물건) 2단계
// 분류·표시용 값만 공통코드로 관리한다. 프로그램이 값에 따라 동작을 바꾸는 값(창고 유형 등)은 enum으로 둔다
// 업무 표에는 코드 글자(CodeItem.code)를 그대로 저장한다 (예: 담당자 업무 'INBOUND')

model CodeGroup {
  id          BigInt     @id @default(autoincrement()) @map("group_id")
  // 그룹 코드: 영문 대문자·숫자·밑줄 (예: CONTACT_DUTY), 등록 후 변경 불가
  code        String     @unique @map("group_cd")
  name        String     @map("group_nm")
  description String?
  sortOrder   Int        @default(0) @map("sort_seq")
  isActive    Boolean    @default(true) @map("is_active")
  // 시스템 그룹: 프로그램이 직접 쓰는 그룹 (시드가 만들고, 삭제할 수 없다)
  isSystem    String     @default("N") @map("system_yn") @db.Char(1)
  items       CodeItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String     @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String     @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int        @default(1) @map("row_version")

  @@map("tb_code_group")
}

model CodeItem {
  id          BigInt    @id @default(autoincrement()) @map("code_item_id")
  groupId     BigInt    @map("group_id")
  // 코드: 그룹 안에서 중복 금지, 등록 후 변경 불가 (업무 표에 이 글자가 저장되므로)
  code        String    @map("code_item_cd")
  name        String    @map("code_item_nm")
  description String?
  sortOrder   Int       @default(0) @map("sort_seq")
  // 사용 중지: 새로 고를 때만 숨기고, 이미 저장된 값은 이름으로 계속 보여준다
  isActive    Boolean   @default(true) @map("is_active")
  group       CodeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int       @default(1) @map("row_version")

  @@unique([groupId, code])
  @@index([groupId, sortOrder])
  @@map("tb_code_item")
}

// ── 배송권역 (docs/decisions/0033): 센터가 배송을 담당하는 지역 묶음
// 코드 3층 (0025): systemCode DZ000001(자동·불변) / code(사용자 코드, 같은 센터 안 중복 금지) / 외부 코드(ExternalCode)
model DeliveryZone {
  id          BigInt               @id @default(autoincrement()) @map("zone_id")
  centerId    BigInt               @map("center_id")
  systemCode  String               @unique @map("sys_cd")
  code        String               @map("zone_cd")
  name        String               @map("zone_nm")
  description String?
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String               @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String               @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int                  @default(1) @map("row_version")
  center      Center               @relation(fields: [centerId], references: [id], onDelete: Restrict)
  regions     DeliveryZoneRegion[]

  @@unique([centerId, code])
  @@index([centerId])
  @@map("tb_delivery_zone")
}

// 배송권역의 담당 지역: 법정동코드 앞자리 (시·도 2자리 = 그 시·도 전체, 시·군·구 5자리)
// 같은 센터 안에서는 한 지역이 권역 하나에만 (서울 전체 + 서울 종로구처럼 겹치는 것도 금지) — 저장할 때 검사
// 센터끼리는 겹쳐도 된다 (출고 때 화주사 이용 센터 기준으로 고른다)
model DeliveryZoneRegion {
  id         BigInt       @id @default(autoincrement()) @map("zone_region_id")
  zoneId     BigInt       @map("zone_id")
  regionCode String       @map("region_cd")
  zone       DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, regionCode])
  @@index([regionCode])
  @@map("tb_delivery_zone_region")
}

// ── 단위 (docs/decisions/0034): 품목의 기본단위·환산단위로 고르는 목록
// 시스템 코드 없이 표준 코드(EA·KG·BOX…)를 그대로 쓴다 (0025). 외부 코드는 ExternalCode(UNIT)
enum UnitKind {
  // 기본단위: 재고를 세는 단위 (재고는 항상 이 단위로 저장)
  BASE
  // 환산단위: 기본단위를 묶은 단위 (품목마다 입수량을 정한다)
  PACK
}

model Unit {
  id         BigInt   @id @default(autoincrement()) @map("unit_id")
  // 등록 후 바꿀 수 없다 (품목·재고에 이 글자가 저장된다)
  code       String   @unique @map("unit_cd")
  name       String   @map("unit_nm")
  kind       UnitKind @map("unit_kind_cd")
  // 소수 자리수: 기본단위의 수량 입력·검사 기준 (EA 0, KG 3). 환산단위는 0
  decimals   Int      @default(0) @map("decimal_cnt")
  sortOrder  Int      @default(0) @map("sort_seq")
  isActive   Boolean  @default(true) @map("is_active")
  // 시스템 단위: 프로그램이 직접 쓰는 단위 (EA, 라벨 단위 BOX·PLT) — 삭제·사용 중지·종류 변경 불가
  isSystem   String   @default("N") @map("system_yn") @db.Char(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  @@map("tb_unit")
}
