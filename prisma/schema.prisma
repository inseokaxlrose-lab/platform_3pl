// DB 구조 설계도
// 문서: https://pris.ly/d/prisma-schema
// 데이터 구조 결정: docs/decisions/0003-domain-model.md, 0010-auth-and-permission-model.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// 연결 주소는 prisma.config.ts(명령어용)와 src/lib/prisma.ts(앱 실행용)에서 지정한다
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증 (Better Auth)
// user / session / account / verification 은 Better Auth가 사용하는 표다.
// `npx auth generate`로 만든 뒤 우리 정보(userType, isActive, 권한 연결)를 더했다.
// Better Auth 필드 이름·구조는 바꾸지 않는다.
// ─────────────────────────────────────────────

// 사용자 유형: 데이터 범위(볼 수 있는 데이터)를 정하는 기준
enum UserType {
  OPERATOR // 운영사 → 전체
  CENTER // 센터 운영자·작업자 → 소속 센터
  SHIPPER // 화주사 사용자 → 자기 화주사
}

model User {
  id              String   @id
  name            String
  // 아이디 로그인을 쓰므로 이메일이 없는 사용자는 내부용 주소를 자동으로 채운다 (사용자 관리 작업에서)
  email           String
  emailVerified   Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // 로그인 아이디 (username 플러그인)
  username        String?
  displayUsername String?
  userType        UserType
  // false면 로그인·사용 불가 (퇴사자 등). 기록 보존을 위해 계정을 지우지 않고 막는다
  isActive        Boolean  @default(true)
  // 화주사 사용자의 소속 화주사 (화주사 사용자만, DB 검사 조건으로 강제: user_shipper_matches_type)
  shipperId       String?
  shipper         Shipper? @relation(fields: [shipperId], references: [id], onDelete: Restrict)

  sessions            Session[]
  accounts            Account[]
  permissionGroups    UserPermissionGroup[]
  permissionOverrides UserPermissionOverride[]
  // 센터 직원의 소속 센터 (여러 개 가능)
  centers             UserCenter[]
  // 목록 그리드 개인 설정 (숨긴 컬럼·순서·너비 등)
  gridSettings        UserGridSetting[]
  // 사이드바 즐겨찾기 메뉴
  favoriteMenus       UserFavoriteMenu[]
  // 운영사 정보를 마지막으로 고친 기록
  companyUpdates      Company[]

  @@unique([email])
  @@unique([username])
  @@index([shipperId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// 로그인 수단: 아이디·비밀번호 로그인의 비밀번호(암호화된 값)가 여기에 저장된다
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────
// 권한 (0003 결정 7)
// 최종 권한 = 그룹 권한 합 + 사용자 추가(GRANT) − 사용자 제외(DENY)
// 권한 코드(예: inbound.asn.create)는 코드 한 곳에서 목록으로 관리하고, DB에는 코드 글자만 저장한다
// ─────────────────────────────────────────────

// 화면 영역: ADMIN = 운영사 화면(/admin), PORTAL = 화주 포털(/portal)
enum AppArea {
  ADMIN
  PORTAL
}

// 권한그룹: 권한 코드 묶음 (예: "센터 운영자", "화주 담당자")
model PermissionGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  // 이 그룹이 다루는 영역: 그 영역의 권한만 담고, 맞는 유형의 사용자에게만 배정한다 (등록 후 변경 불가)
  area        AppArea  @default(ADMIN)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PermissionGroupPermission[]
  users       UserPermissionGroup[]

  @@map("permission_group")
}

// 권한그룹에 들어 있는 권한 코드 (그룹을 지우면 함께 지워진다)
model PermissionGroupPermission {
  groupId        String
  permissionCode String
  group          PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionCode])
  @@map("permission_group_permission")
}

// 사용자 ↔ 권한그룹 (한 사용자가 여러 그룹에 속할 수 있다)
// 사용자가 남아 있는 그룹은 지울 수 없다 (Restrict): 실수로 여러 사람의 권한이 사라지는 것을 막는다
model UserPermissionGroup {
  userId    String
  groupId   String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_permission_group")
}

enum PermissionEffect {
  GRANT // 그룹에 없어도 이 사용자에게 추가
  DENY // 그룹에 있어도 이 사용자에게서 제외
}

// 사용자별 권한 예외: 같은 사용자·같은 코드에는 하나만 (추가와 제외가 동시에 있을 수 없다)
model UserPermissionOverride {
  userId         String
  permissionCode String
  effect         PermissionEffect
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("user_permission_override")
}

// ─────────────────────────────────────────────
// 조직 (0003 결정 1) — 데이터 범위에 필요한 최소 정보만. 자세한 정보는 M2(센터)·M3(화주사)에서 추가
// ─────────────────────────────────────────────

// 센터: 운영사의 물류센터
// 센터: 운영사의 물류센터 (docs/decisions/0026)
// 코드 3층 (0025): systemCode(자동·불변) / code(사용자 코드, 전체에서 중복 금지) / 외부 코드(ExternalCode)
model Center {
  id            String   @id @default(cuid())
  // 시스템 코드: CT000001 (라벨·문서·이력에 쓰는 불변 코드)
  systemCode    String   @unique
  // 사용자 코드: 화면 검색·표시용 (바꿀 수 있음)
  code          String   @unique
  name          String
  phone         String?
  fax           String?
  managerName   String?
  managerPhone  String?
  zipCode       String?
  address       String?
  addressDetail String?
  // false면 데이터 범위에서 빠진다 (소속 직원도 이 센터 데이터를 볼 수 없음)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users      UserCenter[]
  warehouses Warehouse[]

  @@map("center")
}

// 창고 보관 조건 (docs/decisions/0027): 냉장 물건을 상온 창고에 적치하는 실수를 나중에 경고하는 데 쓴다
enum StorageCondition {
  // 상온
  AMBIENT
  // 냉장
  CHILLED
  // 냉동
  FROZEN
}

enum WarehouseType {
  // 일반 보관 창고
  GENERAL
  // 입고대기 창고: 입고 확정 후 적치 전까지 재고가 머무는 곳 (센터마다 1개, 센터 등록 시 자동 생성)
  INBOUND_STAGING
}

// 창고: 센터 안의 보관 구역 (관리 화면은 "센터별 창고 관리" 작업에서)
model Warehouse {
  id               String           @id @default(cuid())
  centerId         String
  // 시스템 코드: WH000001
  systemCode       String           @unique
  // 사용자 코드: 같은 센터 안에서 중복 금지
  code             String
  name             String
  type             WarehouseType    @default(GENERAL)
  storageCondition StorageCondition @default(AMBIENT)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  center           Center           @relation(fields: [centerId], references: [id], onDelete: Restrict)
  locations        Location[]

  // 센터마다 입고대기 창고 1개: 마이그레이션 SQL의 부분 고유 인덱스 warehouse_one_inbound_staging_per_center
  @@unique([centerId, code])
  @@index([centerId])
  @@map("warehouse")
}

// 로케이션: 창고 안의 보관 위치. 코드 자체가 위치라 시스템 코드는 없다 (0025)
model Location {
  id          String    @id @default(cuid())
  warehouseId String
  // 같은 창고 안에서 중복 금지 (예: A-01-01, DEFAULT)
  code        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, code])
  @@map("location")
}

// 화주사: 운영사에 물건 보관·배송을 맡기는 회사
model Shipper {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  // false면 데이터 범위에서 빠진다 (소속 사용자도 데이터를 볼 수 없음)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("shipper")
}

// 센터 직원 ↔ 소속 센터 (한 직원이 여러 센터를 맡을 수 있다)
// 직원이 소속된 센터는 지울 수 없다 (Restrict)
model UserCenter {
  userId    String
  centerId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([userId, centerId])
  @@index([centerId])
  @@map("user_center")
}

// 사용자별 목록 그리드 설정: 사용자 + 그리드 이름(DataGrid id) 하나에 한 줄 (docs/decisions/0021)
// settings 모양은 src/components/data-grid/settings.ts의 gridSettingsSchema (읽을 때 검사, 깨지면 기본값)
model UserGridSetting {
  userId    String
  gridId    String
  settings  Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gridId])
  @@map("user_grid_setting")
}

// 사용자별 사이드바 즐겨찾기 메뉴 (docs/decisions/0022)
// 메뉴는 주소(href)로 구분한다 (메뉴 목록: src/config/navigation.ts). 추가한 순서(createdAt)대로 보여준다
// 권한이 사라지거나 목록에서 없어진 메뉴는 화면에서만 숨기고 기록은 남긴다 (권한이 돌아오면 다시 보임)
model UserFavoriteMenu {
  userId    String
  href      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, href])
  @@map("user_favorite_menu")
}

// 운영사 정보 (docs/decisions/0024)
// MVP는 운영사 1곳 → 고정 id('default') 한 줄. 여러 운영사 SaaS로 바뀌면 회사 단위 기준이 된다
model Company {
  id             String           @id @default("default")
  name           String
  // 000-00-00000 모양으로 저장 (검증번호 확인 후)
  businessNumber String
  ceoName        String?
  // 업태 / 종목 (거래명세서·세금계산서용)
  businessType   String?
  businessItem   String?
  phone          String?
  fax            String?
  email          String?
  // 주소: 카카오 우편번호 서비스로 검색해 채우고, 상세주소만 직접 입력
  zipCode        String?
  address        String?
  addressDetail  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // 마지막으로 고친 사람
  updatedById    String?
  updatedBy      User?            @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  contacts       CompanyContact[]

  @@map("company")
}

// 운영사 담당자 (최대 5명, 화면에서 정한 순서대로)
model CompanyContact {
  id        String  @id @default(cuid())
  companyId String
  sortOrder Int
  // 담당 업무 (예: 입고 문의, 정산)
  duty      String
  name      String
  phone     String?
  email     String?
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
  @@map("company_contact")
}

// 외부 코드 매핑 (docs/decisions/0025): 우리 기준정보 ↔ SAP·ERP 등 외부 시스템 코드
// 한 줄 = 연동 상대 + 대상 종류 + 대상 id + 외부 코드
// - 같은 연동 상대·같은 종류 안에서 외부 코드 중복 금지
// - 한 대상은 연동 상대마다 외부 코드 1개
model ExternalCode {
  id         String             @id @default(cuid())
  // 연동 상대 키 (src/config/external-systems.ts)
  system     String
  entityType ExternalEntityType
  entityId   String
  code       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([system, entityType, code])
  @@unique([system, entityType, entityId])
  @@index([entityType, entityId])
  @@map("external_code")
}

enum ExternalEntityType {
  CENTER
  WAREHOUSE
  LOCATION
  SHIPPER
  ITEM
  CUSTOMER
  DELIVERY_ZONE
  UNIT
}
