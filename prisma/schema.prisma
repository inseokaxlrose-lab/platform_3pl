// DB 구조 설계도
// 문서: https://pris.ly/d/prisma-schema
// 데이터 구조 결정: docs/decisions/0003-domain-model.md, 0010-auth-and-permission-model.md

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// 연결 주소는 prisma.config.ts(명령어용)와 src/lib/prisma.ts(앱 실행용)에서 지정한다
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증 (Better Auth)
// user / session / account / verification 은 Better Auth가 사용하는 표다.
// `npx auth generate`로 만든 뒤 우리 정보(userType, status, 권한 연결)를 더했다.
// Better Auth 필드 이름·구조는 바꾸지 않는다.
// ─────────────────────────────────────────────

// 사용자 유형: 데이터 범위(볼 수 있는 데이터)를 정하는 기준
enum UserType {
  OPERATOR // 운영사 관리자 → 자기 운영사 전체
  CENTER // 센터 운영자·작업자 → 소속 센터
  SHIPPER // 화주사 사용자 → 자기 화주사
  PLATFORM // 플랫폼 관리자 → 운영사에 속하지 않음, /platform (운영사를 골라 그 운영사로 작업할 수 있다, 0039)
}

model User {
  id              BigInt    @id @default(autoincrement()) @map("user_id")
  // 운영사 (멀티테넌트, 0039). 플랫폼 관리자만 비어 있고 나머지 유형은 반드시 있다 (DB 검사 조건 tb_user_operator_matches_type)
  operatorId      BigInt?   @map("operator_id")
  operator        Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  name            String    @map("user_nm")
  // 아이디 로그인을 쓰므로 이메일이 없는 사용자는 내부용 주소를 자동으로 채운다 (사용자 관리 작업에서)
  email           String
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy       String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy       String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion      Int       @default(1) @map("row_version")
  // 로그인 아이디 (username 플러그인)
  username        String?
  displayUsername String?   @map("display_username")
  userType        UserType  @map("user_type_cd")
  // false면 로그인·사용 불가 (퇴사자 등). 기록 보존을 위해 계정을 지우지 않고 막는다
  status          String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 화주사 사용자의 소속 화주사 (화주사 사용자만, DB 검사 조건으로 강제: tb_user_shipper_matches_type)
  shipperId       BigInt?   @map("shipper_id")
  shipper         Shipper?  @relation(fields: [shipperId], references: [id], onDelete: Restrict)

  sessions            Session[]
  accounts            Account[]
  permissionGroups    UserPermissionGroup[]
  permissionOverrides UserPermissionOverride[]
  // 센터 직원의 소속 센터 (여러 개 가능)
  centers             UserCenter[]
  // 목록 그리드 개인 설정 (숨긴 컬럼·순서·너비 등)
  gridSettings        UserGridSetting[]
  prefs               UserPref[]
  // 사이드바 즐겨찾기 메뉴
  favoriteMenus       UserFavoriteMenu[]
  // 관리 담당 창고 (0074)
  managedWarehouses   Warehouse[]

  @@unique([email])
  @@unique([username])
  @@index([shipperId])
  @@index([operatorId])
  @@map("tb_user")
}

model Session {
  id        BigInt   @id @default(autoincrement()) @map("session_id")
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("tb_session")
}

// 로그인 수단: 아이디·비밀번호 로그인의 비밀번호(암호화된 값)가 여기에 저장된다
model Account {
  id                    BigInt    @id @default(autoincrement()) @map("acct_id")
  accountId             String    @map("provider_account_id")
  providerId            String    @map("provider_id")
  userId                BigInt    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("tb_account")
}

model Verification {
  id         BigInt   @id @default(autoincrement()) @map("verification_id")
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("tb_verification")
}

// ─────────────────────────────────────────────
// 권한 (0003 결정 7)
// 최종 권한 = 그룹 권한 합 + 사용자 추가(GRANT) − 사용자 제외(DENY)
// 권한 코드(예: inbound.asn.create)는 코드 한 곳에서 목록으로 관리하고, DB에는 코드 글자만 저장한다
// ─────────────────────────────────────────────

// 화면 영역: ADMIN = 운영사 화면(/admin), PORTAL = 화주 포털(/portal)
enum AppArea {
  ADMIN
  PORTAL
}

// 권한그룹: 권한 코드 묶음 (예: "센터 운영자", "화주 담당자")
model PermissionGroup {
  id          BigInt   @id @default(autoincrement()) @map("perm_group_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt   @map("operator_id")
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  name        String   @map("perm_group_nm")
  // 이 그룹이 다루는 영역: 그 영역의 권한만 담고, 맞는 유형의 사용자에게만 배정한다 (등록 후 변경 불가)
  area        AppArea  @default(ADMIN) @map("app_area_cd")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int      @default(1) @map("row_version")

  permissions PermissionGroupPermission[]
  users       UserPermissionGroup[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 이름는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, name], where: raw("del_yn = 'N'"), map: "tb_perm_group_operator_id_perm_group_nm_key")
  @@map("tb_perm_group")
}

// 권한그룹에 들어 있는 권한 코드 (그룹을 지우면 함께 지워진다)
model PermissionGroupPermission {
  groupId        BigInt          @map("group_id")
  permissionCode String          @map("perm_cd")
  group          PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionCode])
  @@map("tb_perm_group_perm")
}

// 사용자 ↔ 권한그룹 (한 사용자가 여러 그룹에 속할 수 있다)
// 사용자가 남아 있는 그룹은 지울 수 없다 (Restrict): 실수로 여러 사람의 권한이 사라지는 것을 막는다
model UserPermissionGroup {
  userId    BigInt          @map("user_id")
  groupId   BigInt          @map("group_id")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("tb_user_perm_group")
}

enum PermissionEffect {
  GRANT // 그룹에 없어도 이 사용자에게 추가
  DENY // 그룹에 있어도 이 사용자에게서 제외
}

// 사용자별 권한 예외: 같은 사용자·같은 코드에는 하나만 (추가와 제외가 동시에 있을 수 없다)
model UserPermissionOverride {
  userId         BigInt           @map("user_id")
  permissionCode String           @map("perm_cd")
  effect         PermissionEffect @map("effect_cd")
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("tb_user_perm_override")
}

// ─────────────────────────────────────────────
// 조직 (0003 결정 1) — 데이터 범위에 필요한 최소 정보만. 자세한 정보는 M2(센터)·M3(화주사)에서 추가
// ─────────────────────────────────────────────

// 센터: 운영사의 물류센터
// 센터: 운영사의 물류센터 (docs/decisions/0026)
// 코드 3층 (0025): systemCode(자동·불변) / code(사용자 코드, 같은 운영사 안에서 중복 금지) / 외부 코드(ExternalCode)
model Center {
  id                   BigInt    @id @default(autoincrement()) @map("center_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId           BigInt    @map("operator_id")
  operator             Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 시스템 코드: CT000001 (내부용 불변 코드)
  systemCode           String    @unique @map("sys_cd")
  // ① 기본 정보 (docs/decisions/0073, docs/specs/center.md)
  // 센터코드: 영문 대문자·숫자 1~20자, 필수, 등록 후 바꿀 수 없음 (라벨·문서에 찍힌다)
  code                 String    @map("center_cd") @db.VarChar(20)
  name                 String    @map("center_nm") @db.VarChar(100)
  nameEn               String?   @map("center_nm_en") @db.VarChar(100)
  shortName            String?   @map("center_short_nm") @db.VarChar(30)
  // 센터 유형 (상수 CENTER_TYPE): OWN 자가 / LEASE 임차 / PARTNER 협력·위탁 / VIRTUAL 가상
  type                 String    @default("LEASE") @map("center_type_cd") @db.VarChar(20)
  // 운영 상태 (상수 CENTER_STATUS): PREPARING 준비중 / ACTIVE 운영중 / SUSPENDED 일시중지 / CLOSED 폐쇄
  // 폐쇄만 데이터 범위에서 빠지고, 새 업무(입고·재고 등) 고르기는 운영중만
  status               String    @default("PREPARING") @map("status_cd") @db.VarChar(20)
  statusReason         String?   @map("status_reason") @db.VarChar(200)
  openedOn             DateTime? @map("open_dt") @db.Date
  closedOn             DateTime? @map("close_dt") @db.Date
  // 운영사와 다를 때만 (NULL = 운영사 값), 숫자만
  businessNumber       String?   @map("biz_reg_no") @db.Char(10)
  subBizNo             String?   @map("sub_biz_no") @db.Char(4)
  sortOrder            Int       @default(0) @map("sort_seq")
  remark               String?   @db.VarChar(1000)
  extAttr              Json?     @map("ext_attr")
  // ② 위치·연락처 (전화번호는 하이픈 없이 숫자만, 0029)
  countryCode          String    @default("KR") @map("country_cd") @db.Char(2)
  zipCode              String?   @map("zip_cd") @db.VarChar(10)
  address              String?   @map("addr1") @db.VarChar(200)
  addressDetail        String?   @map("addr2") @db.VarChar(200)
  addressJibun         String?   @map("addr_jibun") @db.VarChar(200)
  regionName           String?   @map("region_nm") @db.VarChar(50)
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  phone                String?   @map("tel_no") @db.VarChar(15)
  fax                  String?   @map("fax_no") @db.VarChar(15)
  email                String?   @db.VarChar(100)
  directions           String?   @db.VarChar(1000)
  // 예전 센터장 칸 (사용자 결정으로 유지, 담당자 표와 별개)
  managerName          String?   @map("manager_nm")
  managerPhone         String?   @map("manager_tel_no")
  // ③ 시설 정보 (1차: 연면적·보관면적·도크 / 2차: 나머지)
  floorAreaM2          Decimal?  @map("floor_area_m2") @db.Decimal(12, 2)
  storageAreaM2        Decimal?  @map("storage_area_m2") @db.Decimal(12, 2)
  dockCount            Int?      @map("dock_cnt")
  landAreaM2           Decimal?  @map("land_area_m2") @db.Decimal(12, 2)
  floorCount           Int?      @map("floor_cnt")
  ceilingHeightM       Decimal?  @map("ceiling_height_m") @db.Decimal(5, 2)
  palletCapacity       Int?      @map("pallet_capa_cnt")
  // ④ 시설 자격 (1차: 보세 여부 / 2차: 나머지 — 보세 칸은 나중에 tb_center_bonded로 옮길 수 있다)
  bondedYn             String    @default("N") @map("bonded_yn") @db.Char(1)
  warehouseRegNo       String?   @map("warehouse_reg_no") @db.VarChar(30)
  glnCode              String?   @map("gln_cd") @db.VarChar(13)
  bondedType           String?   @map("bonded_type_cd") @db.VarChar(20)
  bondedLicenseNo      String?   @map("bonded_license_no") @db.VarChar(30)
  bondedAreaCode       String?   @map("bonded_area_cd") @db.VarChar(20)
  customsOfficeCode    String?   @map("customs_office_cd") @db.VarChar(10)
  hazmatYn             String    @default("N") @map("hazmat_yn") @db.Char(1)
  foodStorageYn        String    @default("N") @map("food_storage_yn") @db.Char(1)
  pharmaYn             String    @default("N") @map("pharma_yn") @db.Char(1)
  // ⑤ 운영 설정 — 상속 칸(출고 마감·타임존·할당 규칙·로트·유통기한·시리얼)은 NULL = 운영사 값
  workStartTime        DateTime? @map("work_start_time") @db.Time(0)
  workEndTime          DateTime? @map("work_end_time") @db.Time(0)
  // 월~일 Y/N 7글자
  workDays             String    @default("YYYYYNN") @map("work_days") @db.Char(7)
  inboundCutoffTime    DateTime? @map("inbound_cutoff_time") @db.Time(0)
  shipCutoffTime       DateTime? @map("ship_cutoff_time") @db.Time(0)
  // 기본 로케이션 3개: 센터 생성·보정 때 입고대기·출고대기·반품대기 창고의 DEFAULT를 연결 (ensureCenterDefaults)
  defaultInboundLocId  BigInt?   @map("default_inbound_loc_id")
  defaultOutboundLocId BigInt?   @map("default_outbound_loc_id")
  defaultReturnLocId   BigInt?   @map("default_return_loc_id")
  defaultInboundLoc    Location? @relation("CenterDefaultInbound", fields: [defaultInboundLocId], references: [id], onDelete: Restrict)
  defaultOutboundLoc   Location? @relation("CenterDefaultOutbound", fields: [defaultOutboundLocId], references: [id], onDelete: Restrict)
  defaultReturnLoc     Location? @relation("CenterDefaultReturn", fields: [defaultReturnLocId], references: [id], onDelete: Restrict)
  timezone             String?   @db.VarChar(50)
  allocRule            String?   @map("alloc_rule_cd") @db.VarChar(10)
  useLot               String?   @map("lot_mgmt_yn") @db.Char(1)
  useExpiry            String?   @map("expiry_mgmt_yn") @db.Char(1)
  useSerial            String?   @map("serial_mgmt_yn") @db.Char(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy            String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy            String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion           Int       @default(1) @map("row_version")

  users         UserCenter[]
  warehouses    Warehouse[]
  shippers      ShipperCenter[]
  stocks        Stock[]
  asns          Asn[]
  // 이 센터를 배송 센터로 지정한 거래처 (0072)
  // 납품처 배송센터·권역 기준 센터 (0082)
  shipTos       ShipTo[]         @relation("ShipToDeliveryCenter")
  regionShipTos ShipTo[]         @relation("ShipToRegionCenter")
  contacts      CenterContact[]
  tempZones     CenterTempZone[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn         String              @default("N") @map("del_yn") @db.Char(1)
  // 구역·로케이션 (0075)
  zones         Zone[]
  locations     Location[]
  // 권역설정 (0076)
  regionMaps    RegionCenterMap[]
  regionBatches RegionChangeBatch[] @relation("RegionBatchTarget")

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_center_operator_id_center_cd_key")
  @@map("tb_center")
}

// 센터 담당자 (0073): 운영사 담당자와 같은 모양, 최대 10명, 대표 1명 (센터 저장 때 함께 저장)
model CenterContact {
  id           BigInt   @id @default(autoincrement()) @map("contact_id")
  centerId     BigInt   @map("center_id")
  sortOrder    Int      @map("sort_seq")
  // 담당 업무: 운영사 공통코드 CENTER_CONTACT_ROLE의 코드 (예: MANAGER)
  duty         String   @map("role_cd") @db.VarChar(20)
  name         String   @map("contact_nm") @db.VarChar(50)
  phone        String?  @map("tel_no") @db.VarChar(15)
  email        String?  @db.VarChar(100)
  isPrimary    String   @default("N") @map("primary_yn") @db.Char(1)
  // [2차] 부서·직책·알림 수신
  deptName     String?  @map("dept_nm") @db.VarChar(50)
  positionName String?  @map("position_nm") @db.VarChar(50)
  notifyYn     String   @default("Y") @map("notify_yn") @db.Char(1)
  // 감사 칸: 저장 함수가 채운다 (버전은 센터에서 검사)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  createdBy    String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy    String   @default("system") @map("updated_by") @db.VarChar(50)
  center       Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  // 센터당 대표 1명
  @@unique([centerId], where: raw("primary_yn = 'Y'"), map: "tb_center_contact_primary_key")
  @@index([centerId, sortOrder])
  @@map("tb_center_contact")
}

// 센터 취급 온도대 (0073): 운영사 TEMP_ZONE 상수 재사용
model CenterTempZone {
  centerId   BigInt   @map("center_id")
  tempZoneCd String   @map("temp_zone_cd") @db.VarChar(20)
  // [2차] 면적·관리 온도
  areaM2     Decimal? @map("area_m2") @db.Decimal(12, 2)
  minTemp    Decimal? @map("min_temp") @db.Decimal(5, 1)
  maxTemp    Decimal? @map("max_temp") @db.Decimal(5, 1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@id([centerId, tempZoneCd])
  @@map("tb_center_temp_zone")
}

// 창고: 센터 안에서 용도와 재고 성격이 같은 공간의 묶음 (docs/decisions/0027, 0074, docs/db-conventions.md)
// 유형(WAREHOUSE_TYPE)·온도대(TEMP_ZONE)·상태·기본 재고상태는 플랫폼 상수 + DB 검사 조건 (src/config/operator-codes.ts)
model Warehouse {
  id                 BigInt     @id @default(autoincrement()) @map("warehouse_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId         BigInt     @map("operator_id")
  operator           Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 등록 후 바꿀 수 없다
  centerId           BigInt     @map("center_id")
  // 시스템 코드: WH000001
  systemCode         String     @unique @map("sys_cd")
  // 창고코드: 필수, 같은 센터 안에서 중복 금지, 등록 후 수정 불가 (영문 대문자·숫자·밑줄)
  code               String     @map("warehouse_cd") @db.VarChar(20)
  name               String     @map("warehouse_nm") @db.VarChar(100)
  // ① 기본 정보 [1차]
  type               String     @default("STORAGE") @map("warehouse_type_cd") @db.VarChar(20)
  // 센터 취급 온도대(tb_center_temp_zone) 중 하나
  tempZone           String     @map("temp_zone_cd") @db.VarChar(20)
  status             String     @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 시스템 기본 창고 (센터 등록 때 자동 생성되는 입고·출고·반품 대기): 삭제·코드·유형·명칭 변경·사용 중지 불가
  systemYn           String     @default("N") @map("system_yn") @db.Char(1)
  description        String?    @db.VarChar(200)
  sortOrder          Int        @default(10) @map("sort_seq")
  // ② 위치·시설 [1차: 동·층·면적 / 2차: 나머지]
  buildingName       String?    @map("building_nm") @db.VarChar(50)
  floorNo            String?    @map("floor_no") @db.VarChar(10)
  areaM2             Decimal?   @map("area_m2") @db.Decimal(12, 2)
  ceilingHeightM     Decimal?   @map("ceiling_height_m") @db.Decimal(5, 2)
  palletCapacity     Int?       @map("pallet_capa_cnt")
  // 보관 방식: 운영사 공통코드 STORAGE_METHOD
  storageMethod      String?    @map("storage_method_cd") @db.VarChar(20)
  // 센터가 보세·위험물 자격이 있을 때만 Y
  bondedYn           String     @default("N") @map("bonded_yn") @db.Char(1)
  hazmatYn           String     @default("N") @map("hazmat_yn") @db.Char(1)
  // ③ 운영 속성 [1차]: 유형을 고르면 유형별 기본값(WAREHOUSE_TYPE_DEFAULTS)으로 채우고 고칠 수 있다
  inboundYn          String     @default("Y") @map("inbound_yn") @db.Char(1)
  outboundYn         String     @default("Y") @map("outbound_yn") @db.Char(1)
  // 이 창고 재고를 주문에 할당할 수 있는지 (가용재고 포함 여부)
  allocatableYn      String     @default("Y") @map("allocatable_yn") @db.Char(1)
  // 이 창고에 적치될 때 기본 재고상태 (STOCK_STATUS)
  defaultStockStatus String     @default("NORMAL") @map("default_stock_status_cd") @db.VarChar(20)
  // 여러 창고에 재고가 있을 때 작은 값 먼저 (1~999)
  allocPriority      Int        @default(100) @map("alloc_priority")
  // 로케이션을 정하지 않고 적치할 때 쓰는 곳 (시스템 기본 창고는 DEFAULT 로케이션)
  defaultLocId       BigInt?    @map("default_loc_id")
  defaultLocation    Location?  @relation("WarehouseDefaultLocation", fields: [defaultLocId], references: [id], onDelete: Restrict)
  // ④ 관리·담당 [2차]
  managerUserId      BigInt?    @map("manager_user_id")
  managerUser        User?      @relation(fields: [managerUserId], references: [id], onDelete: SetNull)
  // 전용 화주사 (NULL = 공용 창고)
  dedicatedShipperId BigInt?    @map("dedicated_shipper_id")
  dedicatedShipper   Shipper?   @relation(fields: [dedicatedShipperId], references: [id], onDelete: Restrict)
  // 로케이션 일괄 생성 때 쓰는 접두어·구분자 (구분자가 없으면 '-')
  locCodePrefix      String?    @map("loc_cd_prefix") @db.VarChar(10)
  locCodeSeparator   String?    @map("loc_cd_separator") @db.Char(1)
  // ⑤ 확장
  remark             String?    @db.VarChar(1000)
  extAttr            Json?      @map("ext_attr")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy          String     @default("system") @map("created_by") @db.VarChar(50)
  updatedBy          String     @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion         Int        @default(1) @map("row_version")
  center             Center     @relation(fields: [centerId], references: [id], onDelete: Restrict)
  locations          Location[]
  stocks             Stock[]

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)
  zones Zone[]

  @@unique([centerId, code], where: raw("del_yn = 'N'"), map: "tb_warehouse_center_id_warehouse_cd_key")
  // 센터마다 시스템 기본 창고는 유형별 1개 (부분 고유 인덱스, 0074)
  @@unique([centerId, type], where: raw("system_yn = 'Y'"), map: "tb_warehouse_one_system_per_center")
  @@index([centerId])
  @@index([operatorId])
  @@index([defaultLocId])
  @@map("tb_warehouse")
}

// 구역: 창고 안에서 같은 방식으로 운영되는 로케이션 묶음 (docs/decisions/0075). 예: A구역(랙 보관), P구역(피킹)
model Zone {
  id          BigInt     @id @default(autoincrement()) @map("zone_id")
  // 운영사 (멀티테넌트, 0039)
  operatorId  BigInt     @map("operator_id")
  operator    Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 창고의 센터 (조회·범위용, 저장 때 창고와 맞춰 본다)
  centerId    BigInt     @map("center_id")
  center      Center     @relation(fields: [centerId], references: [id], onDelete: Restrict)
  // 등록 후 바꿀 수 없다
  warehouseId BigInt     @map("warehouse_id")
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  // 구역코드: 영문 대문자·숫자 1~10자, 창고 안에서 중복 금지. 로케이션 코드 앞자리로 쓴다
  code        String     @map("zone_cd") @db.VarChar(10)
  name        String     @map("zone_nm") @db.VarChar(100)
  // 공통코드 ZONE_TYPE
  type        String     @default("STORAGE") @map("zone_type_cd") @db.VarChar(20)
  status      String     @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 구역 간 피킹 동선 순서
  pickSeq     Int?       @map("pick_seq")
  sortOrder   Int        @default(10) @map("sort_seq")
  description String?    @db.VarChar(200)
  remark      String?    @db.VarChar(1000)
  extAttr     Json?      @map("ext_attr")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디, 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String     @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String     @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int        @default(1) @map("row_version")
  locations   Location[]

  // 논리 삭제 (0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([warehouseId, code], where: raw("del_yn = 'N'"), map: "tb_zone_warehouse_id_zone_cd_key")
  @@index([centerId])
  @@index([operatorId])
  @@map("tb_zone")
}

// 로케이션: 재고가 실제로 놓이는 한 칸, 바코드로 스캔하는 최소 단위 (docs/decisions/0028, 0075)
model Location {
  id                  BigInt      @id @default(autoincrement()) @map("location_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId          BigInt      @map("operator_id")
  operator            Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 센터·창고는 등록 후 불변 (센터는 창고의 센터, 조회·범위용)
  centerId            BigInt      @map("center_id")
  center              Center      @relation(fields: [centerId], references: [id], onDelete: Restrict)
  warehouseId         BigInt      @map("warehouse_id")
  // 같은 창고의 구역만 (시스템 기본 로케이션 등은 비움)
  zoneId              BigInt?     @map("zone_id")
  zone                Zone?       @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  // ① 기본 정보 [1차]
  // 같은 창고 안에서 중복 금지, 등록 후 수정 불가 (라벨이 붙어 있다). 영문 대문자·숫자·'-', 글자 그대로 비교(C 정렬)
  code                String      @map("location_cd") @db.VarChar(30)
  // 목록 코드 옆 보조 문구 (예전 명칭 칸, 0071)
  description         String?     @db.VarChar(200)
  // 공통코드 LOC_TYPE
  locType             String      @default("RACK") @map("loc_type_cd") @db.VarChar(20)
  status              String      @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 시스템 기본 로케이션 (시스템 기본 창고의 DEFAULT): 사용 중지·삭제 불가
  systemYn            String      @default("N") @map("system_yn") @db.Char(1)
  remark              String?     @db.VarChar(1000)
  // ② 위치 구성 [1차: 열·단 / 2차: 연·칸·좌표] (정보용, 일괄 생성은 코드와 같은 값)
  rowNo               String?     @map("row_no") @db.VarChar(10)
  levelNo             String?     @map("level_no") @db.VarChar(10)
  bayNo               String?     @map("bay_no") @db.VarChar(10)
  cellNo              String?     @map("cell_no") @db.VarChar(10)
  posX                Decimal?    @map("pos_x") @db.Decimal(10, 2)
  posY                Decimal?    @map("pos_y") @db.Decimal(10, 2)
  // ③ 용량 [1차: 입력만] — 저장은 cm·kg, 화면은 운영사 단위로 바꿔 보여 준다
  widthCm             Decimal?    @map("width_cm") @db.Decimal(8, 2)
  depthCm             Decimal?    @map("depth_cm") @db.Decimal(8, 2)
  heightCm            Decimal?    @map("height_cm") @db.Decimal(8, 2)
  maxCbm              Decimal?    @map("max_cbm") @db.Decimal(10, 4)
  maxWeightKg         Decimal?    @map("max_weight_kg") @db.Decimal(10, 2)
  maxPalletCnt        Int?        @map("max_pallet_cnt")
  // ④ 운영 속성 [1차] — 적치·피킹·할당 가능은 NULL이면 창고 값 (getEffectiveLocationOps)
  inboundYn           String?     @map("inbound_yn") @db.Char(1)
  outboundYn          String?     @map("outbound_yn") @db.Char(1)
  allocatableYn       String?     @map("allocatable_yn") @db.Char(1)
  mixItemYn           String      @default("Y") @map("mix_item_yn") @db.Char(1)
  mixLotYn            String      @default("Y") @map("mix_lot_yn") @db.Char(1)
  // 3PL은 화주 간 재고 섞임 방지가 기본
  mixClientYn         String      @default("N") @map("mix_client_yn") @db.Char(1)
  putawaySeq          Int?        @map("putaway_seq")
  pickSeq             Int?        @map("pick_seq")
  // ⑤ 잠금·관리 [2차] — 잠금(일시적으로 작업 금지)은 사용 중지(장기간 안 씀)와 다르다
  lockYn              String      @default("N") @map("lock_yn") @db.Char(1)
  // 공통코드 LOCK_REASON, 잠그면 필수
  lockReason          String?     @map("lock_reason_cd") @db.VarChar(20)
  lockAt              DateTime?   @map("lock_at")
  // 공통코드 ABC_CLASS
  abcClass            String?     @map("abc_class_cd") @db.VarChar(5)
  dedicatedShipperId  BigInt?     @map("dedicated_shipper_id")
  dedicatedShipper    Shipper?    @relation(fields: [dedicatedShipperId], references: [id], onDelete: Restrict)
  checkDigit          String?     @map("check_digit") @db.VarChar(4)
  lastCountOn         DateTime?   @map("last_count_dt") @db.Date
  extAttr             Json?       @map("ext_attr")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy           String      @default("system") @map("created_by") @db.VarChar(50)
  updatedBy           String      @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion          Int         @default(1) @map("row_version")
  warehouse           Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stocks              Stock[]
  // 센터 기본 로케이션으로 연결된 곳 (0073)
  defaultInboundOf    Center[]    @relation("CenterDefaultInbound")
  defaultOutboundOf   Center[]    @relation("CenterDefaultOutbound")
  defaultReturnOf     Center[]    @relation("CenterDefaultReturn")
  // 창고 기본 로케이션으로 연결된 곳 (0074)
  defaultOfWarehouses Warehouse[] @relation("WarehouseDefaultLocation")

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([warehouseId, code], where: raw("del_yn = 'N'"), map: "tb_location_warehouse_id_location_cd_key")
  // 센터 안 코드 앞부분·범위 검색
  @@index([centerId, code])
  @@index([warehouseId, zoneId, status])
  @@index([centerId, status, delYn])
  @@index([zoneId])
  @@index([operatorId])
  @@map("tb_location")
}

// 화주사: 운영사에 물건 보관·배송을 맡기는 회사
// 라벨 단위: 입고 라벨을 붙이는 단위 (0003 결정 7)
enum LabelUnit {
  PLT
  BOX
}

// 화주사 (docs/decisions/0035, 0080 — 정의서 docs/specs/shipper.md, 표 이름은 tb_shipper 유지)
// 코드 3층 (0025): systemCode SH000001(자동·불변) / code(사용자 코드, 같은 운영사 안에서 중복 금지) / 외부 코드(ExternalCode)
model Shipper {
  id                   BigInt    @id @default(autoincrement()) @map("shipper_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId           BigInt    @map("operator_id")
  operator             Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  systemCode           String    @unique @map("sys_cd")
  code                 String    @map("shipper_cd")
  name                 String    @map("shipper_nm")
  // ── ① 기본 정보
  nameEn               String?   @map("shipper_nm_en") @db.VarChar(100)
  shortName            String?   @map("shipper_short_nm") @db.VarChar(30)
  // 화주 유형·업종: 공통코드 SHIPPER_TYPE·SHIPPER_INDUSTRY (표시·분류용)
  shipperType          String?   @map("shipper_type_cd") @db.VarChar(20)
  industry             String?   @map("industry_cd") @db.VarChar(20)
  // 사업자등록번호·전화번호는 하이픈 없이 숫자만 (0029). 화면에서는 필수, 기존 화주는 비어 있을 수 있다 (0080)
  businessNumber       String?   @map("biz_reg_no")
  // 사업자 구분·과세유형: 상수 BIZ_ENTITY·TAX_TYPE (운영사와 같은 값)
  bizEntity            String    @default("CORP") @map("biz_entity_cd") @db.VarChar(10)
  corpRegNo            String?   @map("corp_reg_no") @db.Char(13)
  subBizNo             String?   @map("sub_biz_no") @db.Char(4)
  taxType              String    @default("GENERAL") @map("tax_type_cd") @db.VarChar(10)
  ceoName              String?   @map("ceo_nm")
  businessType         String?   @map("biz_condition")
  businessItem         String?   @map("biz_item")
  sortOrder            Int       @default(0) @map("sort_seq")
  remark               String?   @db.VarChar(1000)
  extAttr              Json?     @map("ext_attr")
  // ── ② 연락처·주소
  phone                String?   @map("tel_no")
  fax                  String?   @map("fax_no")
  email                String?
  homepageUrl          String?   @map("homepage_url") @db.VarChar(200)
  countryCode          String    @default("KR") @map("country_cd") @db.Char(2)
  zipCode              String?   @map("zip_cd")
  address              String?   @map("addr1")
  addressDetail        String?   @map("addr2")
  addressJibun         String?   @map("addr_jibun") @db.VarChar(200)
  // ── ③ 계약·정산
  contractStartOn      DateTime  @default(dbgenerated("CURRENT_DATE")) @map("contract_start_dt") @db.Date
  // 비어 있으면 자동연장(기한 없음)
  contractEndOn        DateTime? @map("contract_end_dt") @db.Date
  autoRenewYn          String    @default("Y") @map("auto_renew_yn") @db.Char(1)
  // 정산 주기: 공통코드 SETTLE_CYCLE
  settleCycle          String    @default("MONTHLY") @map("settle_cycle_cd") @db.VarChar(10)
  // 정산 마감일 1~31, 99 = 말일. 비어 있으면 운영사 값
  closingDay           Int?      @map("closing_day") @db.SmallInt
  // 결제 조건: 마감 후 n일
  paymentTermsDays     Int?      @map("payment_terms_days")
  taxInvoiceEmail      String?   @map("tax_invoice_email") @db.VarChar(100)
  // ── ④ 운영 설정 (상속: 비어 있으면 위 단계 값 — 0073·0080, getEffectiveSetting)
  // 로트·유통기한은 품목 기본값으로도 쓴다 (품목에서 그대로 쓰거나 개별 지정, 0003 결정 2)
  useLot               String?   @map("lot_mgmt_yn") @db.Char(1)
  useExpiry            String?   @map("expiry_mgmt_yn") @db.Char(1)
  useSerial            String?   @map("serial_mgmt_yn") @db.Char(1)
  allocRule            String?   @map("alloc_rule_cd") @db.VarChar(10)
  shipCutoffTime       DateTime? @map("ship_cutoff_time") @db.Time(0)
  // 유통기한 잔여일 기준 (비어 있으면 검사 안 함, 상속 아님)
  minInboundShelfDays  Int?      @map("min_inbound_shelf_days")
  minOutboundShelfDays Int?      @map("min_outbound_shelf_days")
  partialShipYn        String    @default("Y") @map("partial_ship_yn") @db.Char(1)
  // 재고 부족 시 처리: 상수 SHORTAGE_POLICY (HOLD·PARTIAL·CANCEL_SHORT)
  shortagePolicy       String    @default("HOLD") @map("shortage_policy_cd") @db.VarChar(20)
  labelUnit            LabelUnit @default(PLT) @map("label_unit_cd")
  // ── ⑤ 거래처·주문 정책 (포털·API 공통, 상수)
  // 납품처 배송센터 미지정: AUTO_HOLD·AUTO_REJECT·REQUIRED
  shipToCenterPolicy   String    @default("AUTO_HOLD") @map("ship_to_center_policy_cd") @db.VarChar(20)
  autoCreateShipToYn   String    @default("Y") @map("auto_create_ship_to_yn") @db.Char(1)
  autoCreateItemYn     String    @default("N") @map("auto_create_item_yn") @db.Char(1)
  // 주문번호 중복 기준: CLIENT(화주 전체 기간)·CLIENT_DAY(일자별)
  orderNoScope         String    @default("CLIENT") @map("order_no_unique_scope_cd") @db.VarChar(20)
  // ── ⑥ 연동 (API 키 관리는 다음 작업 — 정의서 PART 2)
  // 연동 방식: PORTAL·API·FILE·EDI
  ifMethod             String    @default("PORTAL") @map("if_method_cd") @db.VarChar(20)
  apiEnabledYn         String    @default("N") @map("api_enabled_yn") @db.Char(1)
  // 상태 (상수 SHIPPER_STATUS, 0080): 준비중 → 운영중 → 일시정지 → 해지. 일시정지·해지는 사유 필수
  // 해지만 데이터 범위에서 빠진다 (소속 사용자 로그인 불가)
  status               String    @default("PREPARING") @map("status_cd") @db.VarChar(20)
  statusReason         String?   @map("status_reason") @db.VarChar(200)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy            String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy            String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion           Int       @default(1) @map("row_version")

  users        User[]
  centers      ShipperCenter[]
  contacts     ShipperContact[]
  items        Item[]
  itemBarcodes ItemBarcode[]
  customers    Customer[]
  stocks       Stock[]
  asns         Asn[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn               String      @default("N") @map("del_yn") @db.Char(1)
  // 전용 창고 (0074)
  dedicatedWarehouses Warehouse[]
  // 전용 로케이션 (0075)
  dedicatedLocations  Location[]
  // 연동 API 키 (0081)
  apiClients          ApiClient[]
  shipTos             ShipTo[]

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_shipper_operator_id_shipper_cd_key")
  @@map("tb_shipper")
}

// 화주사의 이용 센터 (화주사 ↔ 센터, 1개 이상) — 센터 직원은 자기 센터를 이용하는 화주사만 본다
// 기본 센터는 화주당 1개 (부분 고유), 센터별 운영 설정 재정의는 비어 있으면 화주 값 (0080, 화면은 2차)
model ShipperCenter {
  shipperId      BigInt    @map("shipper_id")
  centerId       BigInt    @map("center_id")
  isDefault      String    @default("N") @map("default_yn") @db.Char(1)
  startOn        DateTime  @default(dbgenerated("CURRENT_DATE")) @map("start_dt") @db.Date
  endOn          DateTime? @map("end_dt") @db.Date
  status         String    @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 센터별 재정의 (2차 화면)
  allocRule      String?   @map("alloc_rule_cd") @db.VarChar(10)
  useLot         String?   @map("lot_mgmt_yn") @db.Char(1)
  useExpiry      String?   @map("expiry_mgmt_yn") @db.Char(1)
  useSerial      String?   @map("serial_mgmt_yn") @db.Char(1)
  shipCutoffTime DateTime? @map("ship_cutoff_time") @db.Time(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy      String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy      String    @default("system") @map("updated_by") @db.VarChar(50)
  shipper        Shipper   @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  center         Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([shipperId, centerId])
  @@unique([shipperId], where: raw("default_yn = 'Y'"), map: "tb_shipper_center_default_key")
  @@index([centerId])
  @@map("tb_shipper_center")
}

// 화주사 담당자 (운영사 담당자와 같은 모양, 화주사만 최대 10명 — 0080), 대표 1명, 담당 업무는 공통코드 CONTACT_ROLE
// 연동 담당(if_contact_yn): 화주당 최대 1명, 이메일 필수 (API 키 발급·만료 알림 받는 사람)
model ShipperContact {
  id          BigInt  @id @default(autoincrement()) @map("contact_id")
  shipperId   BigInt  @map("shipper_id")
  sortOrder   Int     @map("sort_seq")
  duty        String  @map("role_cd")
  name        String  @map("contact_nm")
  phone       String? @map("tel_no")
  email       String?
  isPrimary   String  @default("N") @map("primary_yn") @db.Char(1)
  isIfContact String  @default("N") @map("if_contact_yn") @db.Char(1)
  shipper     Shipper @relation(fields: [shipperId], references: [id], onDelete: Cascade)

  @@unique([shipperId], where: raw("if_contact_yn = 'Y'"), map: "tb_shipper_contact_if_contact_key")
  @@index([shipperId, sortOrder])
  @@map("tb_shipper_contact")
}

// 센터 직원 ↔ 소속 센터 (한 직원이 여러 센터를 맡을 수 있다)
// 직원이 소속된 센터는 지울 수 없다 (Restrict)
model UserCenter {
  userId    BigInt   @map("user_id")
  centerId  BigInt   @map("center_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([userId, centerId])
  @@index([centerId])
  @@map("tb_user_center")
}

// 사용자별 목록 그리드 설정: 사용자 + 그리드 이름(DataGrid id) 하나에 한 줄 (docs/decisions/0021)
// settings 모양은 src/components/data-grid/settings.ts의 gridSettingsSchema (읽을 때 검사, 깨지면 기본값)
// 사용자 개인 설정 (docs/decisions/0056): 화면이 기억하는 고르기 값 (예: 라벨 인쇄 양식·코드 종류)
// 키는 코드에 정한 것만 (src/lib/prefs/user-prefs.ts), 값은 키마다 입력 규칙으로 검사한다
model UserPref {
  userId    BigInt   @map("user_id")
  prefKey   String   @map("pref_key") @db.VarChar(50)
  value     Json     @map("pref_value")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, prefKey])
  @@map("tb_user_pref")
}

model UserGridSetting {
  userId    BigInt   @map("user_id")
  gridId    String   @map("grid_cd")
  settings  Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gridId])
  @@map("tb_user_grid_setting")
}

// 사용자별 사이드바 즐겨찾기 메뉴 (docs/decisions/0022)
// 메뉴는 주소(href)로 구분한다 (메뉴 목록: src/config/navigation.ts). 추가한 순서(createdAt)대로 보여준다
// 권한이 사라지거나 목록에서 없어진 메뉴는 화면에서만 숨기고 기록은 남긴다 (권한이 돌아오면 다시 보임)
model UserFavoriteMenu {
  userId    BigInt   @map("user_id")
  href      String   @map("menu_href")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, href])
  @@map("tb_user_favorite_menu")
}

// 운영사 (docs/specs/operator.md, docs/decisions/0024·0039·0040): 플랫폼을 쓰는 3PL 회사
// 운영사마다 센터·화주사·공통코드·사용자를 따로 가진다. [1차] = DB·화면, [2차] = DB만(기본값) — 화면은 이후
// 플랫폼이 정하는 코드(유형·상태·사업자 구분·과세·요금제 등)는 상수 src/config/operator-codes.ts + DB 검사 조건
model Operator {
  id BigInt @id @default(autoincrement()) @map("operator_id")

  // ── ① 기본 정보 [1차]
  // 운영사코드: 영문 대문자·숫자·_- 2~20자, 등록 후 바꿀 수 없다. 관리자 아이디 admin.{코드 소문자}
  code           String    @map("operator_cd") @db.VarChar(20)
  name           String    @map("operator_nm") @db.VarChar(100)
  nameEn         String?   @map("operator_nm_en") @db.VarChar(100)
  shortName      String?   @map("operator_short_nm") @db.VarChar(50)
  // 운영사 유형 OPERATOR_TYPE (3PL 기본)
  type           String    @default("3PL") @map("operator_type_cd") @db.VarChar(20)
  // 운영 상태 OPERATOR_STATUS: PENDING 대기 / ACTIVE 운영 / SUSPENDED 정지 / TERMINATED 해지
  // ACTIVE가 아니면 그 운영사의 사용자는 로그인·사용할 수 없다 (플랫폼 관리자가 바꾼다, 0039)
  status         String    @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 상태변경 사유 (정지·해지로 바꿀 때 필수)
  statusReason   String?   @map("status_reason") @db.VarChar(200)
  // 사업자등록번호·법인등록번호·전화번호는 하이픈 없이 숫자만 (0029)
  businessNumber String    @map("biz_reg_no") @db.Char(10)
  // 사업자 구분 BIZ_ENTITY (CORP 법인 / INDIVIDUAL 개인), 법인등록번호는 법인일 때만
  bizEntity      String    @default("CORP") @map("biz_entity_cd") @db.VarChar(10)
  corpRegNo      String?   @map("corp_reg_no") @db.Char(13)
  subBizNo       String?   @map("sub_biz_no") @db.Char(4)
  // 과세유형 TAX_TYPE
  taxType        String    @default("GENERAL") @map("tax_type_cd") @db.VarChar(10)
  ceoName        String?   @map("ceo_nm") @db.VarChar(50)
  // 업태 / 종목 (거래명세서·세금계산서용)
  businessType   String?   @map("biz_condition") @db.VarChar(100)
  businessItem   String?   @map("biz_item") @db.VarChar(100)
  establishedOn  DateTime? @map("establish_dt") @db.Date

  // ── ② 연락처·주소 [1차]
  phone         String?  @map("tel_no") @db.VarChar(15)
  fax           String?  @map("fax_no") @db.VarChar(15)
  email         String?  @db.VarChar(100)
  homepageUrl   String?  @map("homepage_url") @db.VarChar(200)
  // 국가 ISO 3166 (화면 미노출)
  country       String   @default("KR") @map("country_cd") @db.Char(2)
  // 주소: 카카오 우편번호 서비스로 검색해 채우고, 상세주소만 직접 입력. 지번주소는 검색 결과를 자동 저장
  zipCode       String?  @map("zip_cd") @db.VarChar(10)
  address       String?  @map("addr1") @db.VarChar(200)
  addressDetail String?  @map("addr2") @db.VarChar(200)
  addressJibun  String?  @map("addr_jibun") @db.VarChar(200)
  // 좌표 (주소 검색이 주지 않아 지금은 비어 있다)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  // ── ③ 물류 자격 [2차]
  warehouseRegNo   String?            @map("warehouse_reg_no") @db.VarChar(30)
  freightLicenseNo String?            @map("freight_license_no") @db.VarChar(30)
  bondedYn         String             @default("N") @map("bonded_yn") @db.Char(1)
  customsYn        String             @default("N") @map("customs_yn") @db.Char(1)
  glnCode          String?            @map("gln_cd") @db.VarChar(13)
  // 제공 서비스(SERVICE_TYPE, 운영사 공통코드)·취급 온도대(TEMP_ZONE) — 하위 표
  services         OperatorService[]
  tempZones        OperatorTempZone[]

  // ── ④ 운영 기본값 [2차] (센터·화주가 상속)
  currency          String    @default("KRW") @map("currency_cd") @db.Char(3)
  // 기본 팔레트 종류 (품목 팔레트 적재의 기본값, 0083)
  defaultPalletType String    @default("T11") @map("default_pallet_type_cd") @db.VarChar(20)
  timezone          String    @default("Asia/Seoul") @db.VarChar(50)
  lang              String    @default("ko-KR") @map("lang_cd") @db.VarChar(5)
  // 표시 단위: 단위 기준정보의 중량·길이 단위 코드 (시스템 또는 이 운영사의 단위 — DB 트리거로 검사, 0078)
  weightUnit        String    @default("KG") @map("weight_unit_cd") @db.VarChar(10)
  lengthUnit        String    @default("CM") @map("length_unit_cd") @db.VarChar(10)
  // 재고할당 규칙 ALLOC_RULE
  allocRule         String    @default("FIFO") @map("alloc_rule_cd") @db.VarChar(10)
  useLot            String    @default("N") @map("lot_mgmt_yn") @db.Char(1)
  useExpiry         String    @default("N") @map("expiry_mgmt_yn") @db.Char(1)
  useSerial         String    @default("N") @map("serial_mgmt_yn") @db.Char(1)
  shipCutoffTime    DateTime? @map("ship_cutoff_time") @db.Time(0)
  // 정산 마감일: 1~31일, 99 = 말일
  closingDay        Int       @default(99) @map("closing_day") @db.SmallInt

  // ── ⑤ 계약·요금제 [2차] (플랫폼만)
  plan            String    @default("TRIAL") @map("plan_cd") @db.VarChar(20)
  contractStartOn DateTime  @default(dbgenerated("CURRENT_DATE")) @map("contract_start_dt") @db.Date
  // 비어 있으면 무기한
  contractEndOn   DateTime? @map("contract_end_dt") @db.Date
  billingBasis    String?   @map("billing_basis_cd") @db.VarChar(10)
  // 비어 있으면 무제한
  maxUserCount    Int?      @map("max_user_cnt")
  maxCenterCount  Int?      @map("max_center_cnt")
  maxClientCount  Int?      @map("max_client_cnt")
  billingEmail    String?   @map("billing_email") @db.VarChar(100)
  taxInvoiceEmail String?   @map("tax_invoice_email") @db.VarChar(100)
  // 유입 경로 (플랫폼 관리자만 표시, 값 목록은 아직 정하지 않음)
  salesChannel    String?   @map("sales_channel_cd") @db.VarChar(20)

  // ── ⑥ 출력 설정 [2차] (파일 표가 생기면 로고·직인에 외래 키를 건다)
  printCompanyName String? @map("print_company_nm") @db.VarChar(100)
  logoFileId       BigInt? @map("logo_file_id")
  stampFileId      BigInt? @map("stamp_file_id")

  // ── ⑦ 확장·시스템
  extAttr Json?   @map("ext_attr")
  // 비고 [1차, 기본 정보 아래]
  remark  String? @db.VarChar(1000)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  contacts OperatorContact[]

  // 이 운영사의 데이터 (운영사를 지울 수 없게 Restrict)
  users            User[]
  permissionGroups PermissionGroup[]
  centers          Center[]
  warehouses       Warehouse[]
  locations        Location[]
  shippers         Shipper[]
  externalCodes    ExternalCode[]
  codeGroups       CodeGroup[]
  codeItems        CodeItem[]
  units            Unit[]
  unitSettings     OperatorUnit[]
  items            Item[]
  itemBarcodes     ItemBarcode[]
  palletTypes      PalletType[]
  customers        Customer[]
  stocks           Stock[]
  stockTxns        StockTxn[]
  asns             Asn[]
  asnLines         AsnLine[]
  receipts         InboundReceipt[]
  receiptLines     InboundReceiptLine[]
  inspections      InboundInspection[]
  labels           InboundLabel[]
  putaways         Putaway[]
  stockAdjusts     StockAdjust[]
  stockAdjustLines StockAdjustLine[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn           String              @default("N") @map("del_yn") @db.Char(1)
  zones           Zone[]
  // 권역설정 (0076): 자동 지정을 허용할 주소 정제 등급 (기본 D = D 이상 자동)
  regionAutoGrade String              @default("D") @map("region_auto_grade") @db.Char(1)
  regionMaps      RegionCenterMap[]
  regionBatches   RegionChangeBatch[]
  apiClients      ApiClient[]
  shipTos         ShipTo[]

  // 운영사코드는 삭제 안 된 것끼리만 겹치면 안 된다 (0038)
  @@unique([code], where: raw("del_yn = 'N'"), map: "tb_operator_operator_cd_key")
  @@map("tb_operator")
}

// 운영사 담당자 [1차] (최대 5명, 화면에서 정한 순서대로). 감사 칸 없이 운영사 이력으로 본다 (0038, 사용자 결정)
model OperatorContact {
  id           BigInt   @id @default(autoincrement()) @map("contact_id")
  operatorId   BigInt   @map("operator_id")
  sortOrder    Int      @map("sort_seq")
  // 담당 업무: 운영사 공통코드 CONTACT_ROLE의 코드 (예: INBOUND, 0030)
  duty         String   @map("role_cd") @db.VarChar(20)
  name         String   @map("contact_nm") @db.VarChar(50)
  phone        String?  @map("tel_no") @db.VarChar(15)
  email        String?  @db.VarChar(100)
  // 대표 담당자 (담당자가 있으면 정확히 1명)
  isPrimary    String   @default("N") @map("primary_yn") @db.Char(1)
  // [2차] 부서·직책·알림 수신
  deptName     String?  @map("dept_nm") @db.VarChar(50)
  positionName String?  @map("position_nm") @db.VarChar(50)
  notifyYn     String   @default("Y") @map("notify_yn") @db.Char(1)
  operator     Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, sortOrder])
  @@map("tb_operator_contact")
}

// 운영사 제공 서비스 [2차]: 운영사 공통코드 SERVICE_TYPE (운영사 이력으로 본다)
model OperatorService {
  operatorId BigInt   @map("operator_id")
  serviceCd  String   @map("service_cd") @db.VarChar(20)
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@id([operatorId, serviceCd])
  @@map("tb_operator_service")
}

// 운영사 취급 온도대 [2차]: TEMP_ZONE (AMBIENT·CHILLED·FROZEN·CONSTANT, 상수 + 검사 조건)
model OperatorTempZone {
  operatorId BigInt   @map("operator_id")
  tempZoneCd String   @map("temp_zone_cd") @db.VarChar(20)
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@id([operatorId, tempZoneCd])
  @@map("tb_operator_temp_zone")
}

// 외부 코드 매핑 (docs/decisions/0025): 우리 기준정보 ↔ SAP·ERP 등 외부 시스템 코드
// 한 줄 = 연동 상대 + 대상 종류 + 대상 id + 외부 코드
// - 같은 운영사·같은 연동 상대·같은 종류 안에서 외부 코드 중복 금지
// - 한 대상은 연동 상대마다 외부 코드 1개
model ExternalCode {
  id         BigInt             @id @default(autoincrement()) @map("ext_code_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId BigInt             @map("operator_id")
  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 연동 상대 키 (src/config/external-systems.ts)
  system     String             @map("ext_system_cd")
  entityType ExternalEntityType @map("entity_type_cd")
  entityId   BigInt             @map("entity_id")
  code       String             @map("ext_cd")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([operatorId, system, entityType, code])
  // 운영사마다 따로: 시스템 단위(공유 행)도 운영사마다 다른 외부 코드로 매핑한다 (0078)
  @@unique([operatorId, system, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tb_ext_code")
}

enum ExternalEntityType {
  CENTER
  WAREHOUSE
  LOCATION
  SHIPPER
  ITEM
  CUSTOMER
  UNIT
}

// ── 공통코드 (docs/decisions/0030): 코드 그룹(서랍) → 코드(서랍 속 물건) 2단계
// 분류·표시용 값만 공통코드로 관리한다. 프로그램이 값에 따라 동작을 바꾸는 값(창고 유형 등)은 enum으로 둔다
// 업무 표에는 코드 글자(CodeItem.code)를 그대로 저장한다 (예: 담당자 업무 'INBOUND')

model CodeGroup {
  id          BigInt     @id @default(autoincrement()) @map("group_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt     @map("operator_id")
  operator    Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 그룹 코드: 영문 대문자·숫자·밑줄 (예: CONTACT_DUTY), 등록 후 변경 불가
  code        String     @map("group_cd")
  name        String     @map("group_nm")
  description String?
  sortOrder   Int        @default(0) @map("sort_seq")
  status      String     @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 시스템 그룹: 프로그램이 직접 쓰는 그룹 (시드가 만들고, 삭제할 수 없다)
  isSystem    String     @default("N") @map("system_yn") @db.Char(1)
  items       CodeItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String     @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String     @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int        @default(1) @map("row_version")

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_code_group_operator_id_group_cd_key")
  @@map("tb_code_group")
}

model CodeItem {
  id          BigInt    @id @default(autoincrement()) @map("code_item_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt    @map("operator_id")
  operator    Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  groupId     BigInt    @map("group_id")
  // 코드: 그룹 안에서 중복 금지, 등록 후 변경 불가 (업무 표에 이 글자가 저장되므로)
  code        String    @map("code_item_cd")
  name        String    @map("code_item_nm")
  description String?
  sortOrder   Int       @default(0) @map("sort_seq")
  // 사용 중지: 새로 고를 때만 숨기고, 이미 저장된 값은 이름으로 계속 보여준다
  status      String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  group       CodeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int       @default(1) @map("row_version")

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([groupId, code], where: raw("del_yn = 'N'"), map: "tb_code_item_group_id_code_item_cd_key")
  @@index([groupId, sortOrder])
  @@index([operatorId])
  @@map("tb_code_item")
}

// ── 단위 (docs/decisions/0034·0078): 수량·포장·물리(중량·부피·길이·면적) 단위
// 시스템 기본 단위는 operator_id 없이 한 벌(마이그레이션으로만 추가·수정), 운영사는 필요한 단위만 더한다
// 시스템 코드 없이 표준 코드(EA·KG·BOX…)를 그대로 쓴다 (0025). 외부 코드는 ExternalCode(UNIT)
// 포장단위 간 환산(1 BOX = 24 EA)은 품목마다 다르므로 여기 두지 않는다 (tb_item_unit)
enum UnitType {
  // 수량: EA(기준)·SET·PAIR — EA 외의 수량 단위 환산은 품목에서
  QTY
  // 포장: BOX·PLT 등 — 환산계수를 절대 두지 않는다 (품목별 입수량)
  PACK
  // 물리 단위: 유형별 기준단위(KG·L·M·M2) × 환산계수
  WEIGHT
  VOLUME
  LENGTH
  AREA
}

model Unit {
  id          BigInt    @id @default(autoincrement()) @map("unit_id")
  // 운영사: 비어 있으면 시스템 기본 단위 (모든 운영사가 함께 보고, 운영사는 고칠 수 없다)
  // prisma.ts가 읽을 때 "시스템 + 지금 운영사", 고칠 때 "지금 운영사"로 자동으로 거른다
  operatorId  BigInt?   @map("operator_id")
  operator    Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 등록 후 바꿀 수 없다 (ASN·검수에 이 글자가 저장된다)
  code        String    @map("unit_cd")
  name        String    @map("unit_nm")
  nameEn      String?   @map("unit_nm_en") @db.VarChar(50)
  // 등록 후 바꿀 수 없다
  type        UnitType  @map("unit_type_cd")
  // 소수 자리수: 수량 입력·저장·표시 자리수 (EA 0, KG 3). 0~6
  decimals    Int       @default(0) @map("decimal_cnt")
  // 송장·명세서 표기 (비우면 이름)
  printName   String?   @map("print_nm") @db.VarChar(20)
  sortOrder   Int       @default(0) @map("sort_seq")
  status      String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 시스템 기본 단위 (operator_id가 비어 있는 줄만 Y — DB 검사 조건)
  isSystem    String    @default("N") @map("system_yn") @db.Char(1)
  // 유형 기준단위 (시스템 단위 중 유형마다 하나: EA·KG·L·M·M2)
  isBase      String    @default("N") @map("base_yn") @db.Char(1)
  // 기준단위와 환산계수: 1 이 단위 = baseFactor × 기준단위 (물리 단위만, 예: G → 0.001 KG)
  baseUnitId  BigInt?   @map("base_unit_id")
  baseUnit    Unit?     @relation("UnitBase", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derived     Unit[]    @relation("UnitBase")
  baseFactor  Decimal?  @map("base_factor") @db.Decimal(20, 10)
  // UN/ECE Rec.20 표준 단위코드 (EDI·해외 연동)
  stdCode     String?   @map("std_unit_cd") @db.VarChar(10)
  description String?   @db.VarChar(200)
  extAttr     Json?     @map("ext_attr")
  remark      String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int       @default(1) @map("row_version")

  // 운영사별 사용 여부 (시스템 기본 단위만, 0079)
  operatorSettings OperatorUnit[]

  // 이 단위를 쓰는 품목 (기본단위 / 환산단위) — 쓰이고 있으면 지울 수 없다
  baseItems    Item[]        @relation("ItemBaseUnit")
  inboundItems Item[]        @relation("ItemInboundUnit")
  orderItems   Item[]        @relation("ItemOrderUnit")
  packItems    ItemUnit[]    @relation("ItemPackUnit")
  barcodes     ItemBarcode[] @relation("ItemBarcodeUnit")

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 운영사 단위끼리 / 시스템 단위끼리. 시스템 코드와 같은 운영사 코드는 저장 때 검사 (units.ts)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_unit_operator_id_unit_cd_key")
  @@unique([code], where: raw("operator_id IS NULL AND del_yn = 'N'"), map: "tb_unit_system_unit_cd_key")
  // 유형별 기준단위는 시스템 단위 중 하나
  @@unique([type], where: raw("base_yn = 'Y' AND operator_id IS NULL"), map: "tb_unit_type_base_key")
  @@index([operatorId, status])
  @@index([type])
  @@map("tb_unit")
}

// ── 운영사별 단위 설정 (docs/decisions/0079): 시스템 기본 단위를 운영사마다 사용 여부·소수 자리수
// 바꾼 단위만 줄이 생긴다 (줄이 없으면 시스템 단위의 값). 운영사 추가 단위는 자기 칸을 쓴다
// 실제 값 = 이 줄의 값 ?? 단위의 값 (src/lib/units/unit-status.ts)
model OperatorUnit {
  id         BigInt   @id @default(autoincrement()) @map("operator_unit_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  unitId     BigInt   @map("unit_id")
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status     String   @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 이 운영사의 소수 자리수 (비우면 시스템 단위 값, 0~6)
  decimals   Int?     @map("decimal_cnt")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  @@unique([operatorId, unitId])
  @@index([unitId])
  @@map("tb_operator_unit")
}

// ── 품목 (docs/decisions/0041, 0083): 화주사가 맡긴 상품의 관리 단위
// 코드 3층 (0025): systemCode IT00000001(자동·불변) / code(품목코드: 화주 코드 그대로, 필수, 화주사 안에서 고유, 등록 후 변경 불가 — 0083) / 외부 코드(ExternalCode ITEM)
// 기한·LOT·시리얼 관리 여부는 상속하지 않는 명시값: 신규 등록 때 화주 실제 값을 복사하고, 이후 화주 설정이 바뀌어도 그대로 (재고 구조를 정하므로, 0083)
model Item {
  id            BigInt   @id @default(autoincrement()) @map("item_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId    BigInt   @map("operator_id")
  operator      Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  shipperId     BigInt   @map("shipper_id")
  shipper       Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  systemCode    String   @unique @map("sys_cd")
  // ── ① 기본 정보 (0083): 품목코드는 화주 코드 그대로, 화주 안에서 고유·수정 불가
  code          String   @map("item_cd") @db.VarChar(50)
  name          String   @map("item_nm") @db.VarChar(200)
  nameEn        String?  @map("item_nm_en") @db.VarChar(200)
  shortName     String?  @map("item_short_nm") @db.VarChar(50)
  // 규격 (예: 500g×24입, 1.8L)
  spec          String?  @map("spec_nm") @db.VarChar(100)
  // 품목 유형 (상수 ITEM_TYPE — SET이면 세트 품목)
  itemType      String   @default("GOODS") @map("item_type_cd") @db.VarChar(20)
  category1     String?  @map("category1") @db.VarChar(50)
  category2     String?  @map("category2") @db.VarChar(50)
  category3     String?  @map("category3") @db.VarChar(50)
  brandName     String?  @map("brand_nm") @db.VarChar(100)
  makerName     String?  @map("maker_nm") @db.VarChar(100)
  // 원산지 (ISO 3166 두 글자)
  originCountry String?  @map("origin_country_cd") @db.Char(2)
  hsCode        String?  @map("hs_cd") @db.VarChar(12)
  // 품목 가액 (기본단위 1개 기준, 파손·분실 보상용)
  itemValue     Decimal? @map("item_value_amt") @db.Decimal(15, 2)
  currency      String?  @map("currency_cd") @db.Char(3)

  // ── ② 단위: 기본단위 = 재고를 세는 단위 (PACK 불가, 재고·거래가 생기면 수정 불가). 단위별 환산·규격은 tb_item_unit
  baseUnitId           BigInt @map("base_unit_id")
  baseUnit             Unit   @relation("ItemBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  defaultInboundUnitId BigInt @map("default_inbound_unit_id")
  defaultInboundUnit   Unit   @relation("ItemInboundUnit", fields: [defaultInboundUnitId], references: [id], onDelete: Restrict)
  defaultOrderUnitId   BigInt @map("default_order_unit_id")
  defaultOrderUnit     Unit   @relation("ItemOrderUnit", fields: [defaultOrderUnitId], references: [id], onDelete: Restrict)

  // ── ③ 팔레트 적재: 종류 + 단당 박스 수(TI) × 단수(HI) → PLT 행 자동 계산. TI·HI 없이 팔레트당 박스 수만 넣어도 된다
  palletTypeCode String? @map("pallet_type_cd") @db.VarChar(20)
  palletTi       Int?    @map("pallet_ti")
  palletHi       Int?    @map("pallet_hi")
  palletBoxQty   Int?    @map("pallet_box_qty")

  // ── ④ 보관 조건
  tempZone       String   @default("AMBIENT") @map("temp_zone_cd") @db.VarChar(20)
  storageTempMin Decimal? @map("storage_temp_min") @db.Decimal(5, 1)
  storageTempMax Decimal? @map("storage_temp_max") @db.Decimal(5, 1)
  hazmatYn       String   @default("N") @map("hazmat_yn") @db.Char(1)
  hazmatClass    String?  @map("hazmat_class_cd") @db.VarChar(20)
  fragileYn      String   @default("N") @map("fragile_yn") @db.Char(1)
  maxStackBox    Int?     @map("max_stack_box")
  uprightYn      String   @default("N") @map("upright_yn") @db.Char(1)
  abcClass       String?  @map("abc_class_cd") @db.VarChar(5)

  // ── ⑤ 소비기한·LOT: 관리 여부 3개는 상속하지 않는 명시값 (신규 때 화주 실제 값을 복사, 이후 화주 설정 변경에 영향 없음)
  useExpiry            String     @default("N") @map("expiry_mgmt_yn") @db.Char(1)
  expiryType           String?    @map("expiry_type_cd") @db.VarChar(20)
  expiryInput          String?    @map("expiry_input_cd") @db.VarChar(20)
  shelfLifeDays        Int?       @map("shelf_life_days")
  // NULL = 화주 값 (상속)
  minInboundShelfDays  Int?       @map("min_inbound_shelf_days")
  minOutboundShelfDays Int?       @map("min_outbound_shelf_days")
  // 임박 알림 기준일 (잔여일이 이보다 짧으면 "임박")
  expiryAlertDays      Int?       @map("expiry_alert_day_cnt")
  useLot               String     @default("N") @map("lot_mgmt_yn") @db.Char(1)
  lotSource            String?    @map("lot_source_cd") @db.VarChar(20)
  useSerial            String     @default("N") @map("serial_mgmt_yn") @db.Char(1)
  // NULL = 화주 값 (상속)
  allocRule            String?    @map("alloc_rule_cd") @db.VarChar(10)
  // 라벨 단위 (입고 라벨 출력, 0041)
  labelUnit            LabelUnit? @map("label_unit_cd")

  // ── ⑥ 출고 조건
  boxOnlyShipYn String   @default("N") @map("box_only_ship_yn") @db.Char(1)
  minOrderQty   Decimal? @map("min_order_qty") @db.Decimal(15, 3)
  setYn         String   @default("N") @map("set_yn") @db.Char(1)

  // ── ⑦ 연동 정보 (거래처와 같다)
  source        String    @default("SCREEN") @map("source_cd") @db.VarChar(20)
  lastIfAt      DateTime? @map("last_if_at")
  lastRequestId String?   @map("last_request_id") @db.VarChar(40)
  extAttr       Json?     @map("ext_attr")

  remark     String?  @db.VarChar(1000)
  // ACTIVE 사용 / INACTIVE 사용중지 / DISCONTINUED 단종 (신규 입고 불가, 재고 출고는 가능)
  status     String   @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  // 단위별 환산·규격 (BASE·INNER·BOX·PLT), 바코드
  units       ItemUnit[]
  unitHistory ItemUnitHist[]
  barcodes    ItemBarcode[]
  stocks      Stock[]
  asnLines    AsnLine[]
  inspections InboundInspection[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 품목코드는 같은 화주사의 삭제 안 된 것끼리만 겹치면 안 된다 (0038)
  @@unique([shipperId, code], where: raw("del_yn = 'N'"), map: "tb_item_shipper_id_item_cd_key")
  @@index([operatorId, shipperId, status])
  @@index([shipperId, name])
  @@index([shipperId, category1])
  @@index([baseUnitId])
  @@index([defaultInboundUnitId])
  @@index([defaultOrderUnitId])
  @@map("tb_item")
}

// 품목 단위·환산·규격 (0083): 품목이 쓰는 단위마다 1행, 레벨(BASE·INNER·BOX·PLT)별 1행. 기본단위 행도 반드시 있다
// 환산수량은 기본단위 기준 (예: 생수 BOX = 24 EA, PLT = 1,440 EA), 소수 자리는 기본단위의 소수 자리수까지 (KG면 2.5 가능)
// 체적은 BOX 기준, PLT 행은 팔레트 적재 정보(종류·TI·HI)로 자동 계산
model ItemUnit {
  id            BigInt   @id @default(autoincrement()) @map("item_unit_id")
  itemId        BigInt   @map("item_id")
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // 단위 (기본단위 행은 품목의 기본단위, 나머지는 환산단위)
  unitId        BigInt   @map("unit_id")
  unit          Unit     @relation("ItemPackUnit", fields: [unitId], references: [id], onDelete: Restrict)
  // 단위 레벨 (상수 UNIT_LEVEL): BASE 기본 · INNER 내포장 · BOX 박스 · PLT 팔레트 — 품목마다 레벨별 1행 (0083)
  level         String   @default("BOX") @map("unit_level_cd") @db.VarChar(10)
  // 기본단위 환산수량: 이 단위 1개 = 기본단위 n개 (BASE는 1)
  convQty       Decimal  @map("conv_cnt") @db.Decimal(18, 3)
  // 규격 (저장은 cm·kg 고정, 화면은 운영사 표시 단위로 — 0078). CBM은 가로·세로·높이로 자동 계산
  widthCm       Decimal? @map("width_cm") @db.Decimal(8, 2)
  depthCm       Decimal? @map("depth_cm") @db.Decimal(8, 2)
  heightCm      Decimal? @map("height_cm") @db.Decimal(8, 2)
  cbm           Decimal? @map("cbm") @db.Decimal(12, 6)
  grossWeightKg Decimal? @map("gross_weight_kg") @db.Decimal(10, 3)
  netWeightKg   Decimal? @map("net_weight_kg") @db.Decimal(10, 3)
  // 자동 계산 행 (PLT: 팔레트 적재 정보로 다시 계산, 화면에서 고칠 수 없음)
  autoCalcYn    String   @default("N") @map("auto_calc_yn") @db.Char(1)
  sortOrder     Int      @default(0) @map("sort_seq")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy     String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion    Int      @default(1) @map("row_version")

  @@unique([itemId, unitId])
  @@unique([itemId, level])
  @@index([unitId])
  @@map("tb_item_unit")
}

// 품목 단위 환산수량 변경 이력 (0083): 미완료 ASN·주문이 없을 때만 바꿀 수 있고, 바꾸면 남긴다
model ItemUnitHist {
  id        BigInt   @id @default(autoincrement()) @map("item_unit_hist_id")
  itemId    BigInt   @map("item_id")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitCode  String   @map("unit_cd") @db.VarChar(20)
  level     String   @map("unit_level_cd") @db.VarChar(10)
  // 바뀌기 전·후 환산수량 (추가는 before null, 삭제는 after null)
  beforeQty Decimal? @map("before_conv_cnt") @db.Decimal(18, 3)
  afterQty  Decimal? @map("after_conv_cnt") @db.Decimal(18, 3)
  changedAt DateTime @default(now()) @map("changed_at")
  changedBy String   @map("changed_by") @db.VarChar(50)

  @@index([itemId, changedAt])
  @@map("tb_item_unit_hist")
}

// 품목 바코드 (0083): 단위별 여러 개, 단위별 대표 1개. 같은 화주 안에서 바코드 하나는 품목·단위 하나만 가리킨다
model ItemBarcode {
  id          BigInt   @id @default(autoincrement()) @map("barcode_id")
  operatorId  BigInt   @map("operator_id")
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  shipperId   BigInt   @map("shipper_id")
  shipper     Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  itemId      BigInt   @map("item_id")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // 이 바코드를 스캔하면 이 단위로 본다 (EA 바코드, BOX 바코드)
  unitId      BigInt   @map("unit_id")
  unit        Unit     @relation("ItemBarcodeUnit", fields: [unitId], references: [id], onDelete: Restrict)
  barcode     String   @map("barcode") @db.VarChar(50)
  // 상수 BARCODE_TYPE (EAN13·ITF14 등은 체크디지트 검사)
  barcodeType String   @map("barcode_type_cd") @db.VarChar(20)
  isPrimary   String   @default("N") @map("primary_yn") @db.Char(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int      @default(1) @map("row_version")

  @@unique([shipperId, barcode])
  @@unique([itemId, unitId], where: raw("primary_yn = 'Y'"), map: "tb_item_barcode_primary_key")
  @@index([itemId])
  @@index([operatorId])
  @@index([unitId])
  @@map("tb_item_barcode")
}

// 팔레트 종류 (0083): PLT 계산 기준. 시스템 기본(operator_id NULL) + 운영사 행 — 운영사 행이 같은 코드의 시스템 행을 덮어쓴다
model PalletType {
  id              BigInt    @id @default(autoincrement()) @map("pallet_type_id")
  operatorId      BigInt?   @map("operator_id")
  operator        Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  code            String    @map("pallet_type_cd") @db.VarChar(20)
  name            String    @map("pallet_type_nm") @db.VarChar(50)
  // 팔레트 자체 규격·중량
  widthCm         Decimal   @map("width_cm") @db.Decimal(8, 2)
  depthCm         Decimal   @map("depth_cm") @db.Decimal(8, 2)
  heightCm        Decimal   @map("height_cm") @db.Decimal(8, 2)
  weightKg        Decimal   @map("weight_kg") @db.Decimal(8, 2)
  // 권장 최대 적재 높이 (팔레트 포함)·최대 적재 중량 — 넘으면 경고
  maxLoadHeightCm Decimal?  @map("max_load_height_cm") @db.Decimal(8, 2)
  maxLoadWeightKg Decimal?  @map("max_load_weight_kg") @db.Decimal(10, 2)
  isSystem        String    @default("N") @map("system_yn") @db.Char(1)
  status          String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  sortOrder       Int       @default(0) @map("sort_seq")
  remark          String?   @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy       String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion      Int       @default(1) @map("row_version")
  delYn           String    @default("N") @map("del_yn") @db.Char(1)

  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_pallet_type_operator_id_cd_key")
  @@unique([code], where: raw("operator_id IS NULL AND del_yn = 'N'"), map: "tb_pallet_type_system_cd_key")
  @@index([operatorId])
  @@map("tb_pallet_type")
}

// ── 거래처 (docs/decisions/0043): 화주사의 고객사 — 출고(MVP 이후) 때 물건을 받는 곳
// 코드 3층 (0025): systemCode CU00000001(자동·불변) / code(거래처코드, 같은 화주사 안에서 중복 금지, 비우면 시스템 코드) / 외부 코드(ExternalCode CUSTOMER)
model Customer {
  id             BigInt   @id @default(autoincrement()) @map("customer_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId     BigInt   @map("operator_id")
  operator       Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  shipperId      BigInt   @map("shipper_id")
  shipper        Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  // 시스템 코드는 내부용. 거래처코드는 화주가 쓰는 코드 그대로 — 필수·등록 후 변경 불가 (0082, API 업무 키)
  systemCode     String   @unique @map("sys_cd")
  code           String   @map("customer_cd") @db.VarChar(30)
  name           String   @map("customer_nm") @db.VarChar(200)
  shortName      String?  @map("customer_short_nm") @db.VarChar(30)
  // 거래처 유형: 공통코드 PARTNER_TYPE (분류·표시), 거래처 그룹: 화주가 쓰는 그룹 (자유 입력)
  customerType   String?  @map("customer_type_cd") @db.VarChar(20)
  customerGroup  String?  @map("customer_group_cd") @db.VarChar(30)
  // 사업자등록번호·전화번호는 하이픈 없이 숫자만 (0029)
  businessNumber String?  @map("biz_reg_no") @db.Char(10)
  ceoName        String?  @map("ceo_nm") @db.VarChar(50)
  // 주문 주소 사용 방식 (상수): SHIP_TO(납품처 지정) / ORDER_ADDR(주문의 수령인 주소 — 온라인몰·B2C)
  orderAddrMode  String   @default("SHIP_TO") @map("order_addr_mode_cd") @db.VarChar(20)
  phone          String?  @map("tel_no") @db.VarChar(15)
  fax            String?  @map("fax_no") @db.VarChar(15)
  email          String?  @db.VarChar(100)

  // ── 주소: 원본(입력·연동 그대로)은 보존하고 정제 결과는 따로 (0082)
  rawZipCode    String?   @map("raw_zip_cd") @db.VarChar(10)
  rawAddress    String?   @map("raw_addr") @db.VarChar(500)
  zipCode       String?   @map("zip_cd") @db.VarChar(10)
  address       String?   @map("addr1") @db.VarChar(200)
  addressDetail String?   @map("addr2") @db.VarChar(200)
  addressJibun  String?   @map("addr_jibun") @db.VarChar(200)
  // 법정동코드 10자리 (정제 결과)
  regionCode    String?   @map("region_cd") @db.Char(10)
  // 주소 정제 등급 A~F (0076 ADDR_GRADE)
  addressGrade  String?   @map("addr_grade") @db.Char(1)
  addressNormAt DateTime? @map("addr_norm_at")

  // ── 출고 조건 (거래처가 요구, 화주 설정보다 우선 — 적용은 출고 할당 작업에서)
  // 비어 있으면 화주 출고 최소 잔여일
  minShelfDays  Int?     @map("min_shelf_days")
  // 전체 유통기간 대비 잔여 비율 % (예: 66.67). 일수와 둘 다 있으면 더 엄격한 쪽
  minShelfRatio Decimal? @map("min_shelf_ratio") @db.Decimal(5, 2)

  // ── 연동 정보 (읽기 전용): 등록 경로 DATA_SOURCE, 최근 연동
  source        String    @default("SCREEN") @map("source_cd") @db.VarChar(20)
  lastIfAt      DateTime? @map("last_if_at")
  lastRequestId String?   @map("last_request_id") @db.VarChar(40)

  remark     String?  @db.VarChar(1000)
  extAttr    Json?    @map("ext_attr")
  // 상태 (상수 CUSTOMER_STATUS): ACTIVE 거래중 / SUSPENDED 거래중지 (신규 출고요청만 막는다)
  status     String   @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  contacts CustomerContact[]
  shipTos  ShipTo[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 거래처코드는 같은 화주사의 삭제 안 된 것끼리만 겹치면 안 된다 (0038)
  @@unique([shipperId, code], where: raw("del_yn = 'N'"), map: "tb_customer_shipper_id_customer_cd_key")
  @@index([operatorId, shipperId, status])
  @@index([shipperId, name])
  @@index([businessNumber])
  @@index([regionCode])
  @@map("tb_customer")
}

// 납품처: 물건이 실제로 도착하는 곳 (0082). 거래처 하나에 여러 곳, 기본 납품처 정확히 1곳, 사용 중 1곳 이상
// 납품처마다 배송센터가 정해진다 (assignShipToCenter: 연동 IF / 권역 자동 AUTO / 화면 수동 MANUAL)
model ShipTo {
  id              BigInt   @id @default(autoincrement()) @map("ship_to_id")
  operatorId      BigInt   @map("operator_id")
  operator        Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 조회 성능용 (거래처의 화주사와 같다)
  shipperId       BigInt   @map("shipper_id")
  shipper         Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  customerId      BigInt   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // 거래처 안에서 고유, 등록 후 변경 불가. 자동 생성 기본 납품처는 거래처코드와 같다
  code            String   @map("ship_to_cd") @db.VarChar(30)
  name            String   @map("ship_to_nm") @db.VarChar(100)
  isDefault       String   @default("N") @map("default_yn") @db.Char(1)
  // 거래처 주소로 자동 만든 납품처
  systemCreatedYn String   @default("N") @map("system_created_yn") @db.Char(1)
  // 기본 납품처에서만 의미: Y면 거래처 주소가 바뀔 때 함께 바뀐다 (직접 고치면 N)
  addrSyncYn      String   @default("N") @map("addr_sync_yn") @db.Char(1)
  status          String   @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  sortOrder       Int      @default(0) @map("sort_seq")

  // ── 주소·수령 정보: 원본 보존 + 정제 결과 (정제 실패면 원본을 addr1에 두고 등급 F)
  rawZipCode        String?   @map("raw_zip_cd") @db.VarChar(10)
  rawAddress        String    @map("raw_addr") @db.VarChar(500)
  zipCode           String?   @map("zip_cd") @db.VarChar(10)
  address           String    @map("addr1") @db.VarChar(200)
  addressDetail     String?   @map("addr2") @db.VarChar(200)
  addressJibun      String?   @map("addr_jibun") @db.VarChar(200)
  regionCode        String?   @map("bjd_cd") @db.Char(10)
  sigunguName       String?   @map("sigungu_nm") @db.VarChar(50)
  bdMgtSn           String?   @map("bd_mgt_sn") @db.VarChar(30)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  addressGrade      String    @default("F") @map("addr_grade") @db.Char(1)
  addressNormMethod String?   @map("addr_norm_method_cd") @db.VarChar(20)
  addressNormAt     DateTime? @map("addr_norm_at")
  receiverName      String?   @map("receiver_nm") @db.VarChar(50)
  receiverPhone     String?   @map("receiver_tel_no") @db.VarChar(15)
  receiverPhone2    String?   @map("receiver_tel_no2") @db.VarChar(15)
  // 배송 메모 (기사 전달, 예: 정문 경비실)
  deliveryMemo      String?   @map("delivery_memo") @db.VarChar(200)

  // ── 배송센터 (상수 CENTER_ASSIGN_TYPE·STATUS·CONFIRM_REASON)
  deliveryCenterId    BigInt?   @map("delivery_center_id")
  deliveryCenter      Center?   @relation("ShipToDeliveryCenter", fields: [deliveryCenterId], references: [id], onDelete: Restrict)
  centerAssignType    String?   @map("center_assign_type_cd") @db.VarChar(10)
  // 센터가 없으면 반드시 NEED_CONFIRM (DB 검사)
  centerAssignStatus  String    @default("NEED_CONFIRM") @map("center_assign_status_cd") @db.VarChar(20)
  centerConfirmReason String?   @map("center_confirm_reason_cd") @db.VarChar(30)
  // 권역설정 결과 (지정 센터와 비교용 — 권역 변경 때 갱신)
  regionCenterId      BigInt?   @map("region_center_id")
  regionCenter        Center?   @relation("ShipToRegionCenter", fields: [regionCenterId], references: [id], onDelete: Restrict)
  regionMismatchYn    String    @default("N") @map("region_mismatch_yn") @db.Char(1)
  // 결정 기준 ZIP / BJD / SIGUNGU (resolveCenterByAddress)
  resolveLevel        String?   @map("resolve_level_cd") @db.VarChar(20)
  centerAssignedAt    DateTime? @map("center_assigned_at")
  centerAssignedBy    String?   @map("center_assigned_by") @db.VarChar(50)

  // ── 연동 정보
  source        String    @default("SCREEN") @map("source_cd") @db.VarChar(20)
  lastIfAt      DateTime? @map("last_if_at")
  lastRequestId String?   @map("last_request_id") @db.VarChar(40)

  remark     String?  @db.VarChar(1000)
  extAttr    Json?    @map("ext_attr")
  delYn      String   @default("N") @map("del_yn") @db.Char(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  // 코드는 같은 거래처의 삭제 안 된 것끼리만 겹치면 안 된다
  @@unique([customerId, code], where: raw("del_yn = 'N'"), map: "tb_ship_to_customer_id_ship_to_cd_key")
  // 기본 납품처는 거래처당 하나 (삭제 안 된 것 중)
  @@unique([customerId], where: raw("default_yn = 'Y' AND del_yn = 'N'"), map: "tb_ship_to_default_key")
  @@index([shipperId, centerAssignStatus])
  @@index([deliveryCenterId])
  @@index([shipperId, zipCode])
  @@index([operatorId, regionMismatchYn])
  @@map("tb_ship_to")
}

model CustomerContact {
  id         BigInt   @id @default(autoincrement()) @map("contact_id")
  customerId BigInt   @map("customer_id")
  sortOrder  Int      @map("sort_seq")
  duty       String   @map("role_cd") @db.VarChar(20)
  name       String   @map("contact_nm") @db.VarChar(50)
  phone      String?  @map("tel_no") @db.VarChar(15)
  email      String?  @db.VarChar(100)
  isPrimary  String   @default("N") @map("primary_yn") @db.Char(1)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sortOrder])
  @@map("tb_customer_contact")
}

// ── 재고 (docs/decisions/0044, 0003 결정 4): 한 줄 = 재고 주소 하나의 지금 수량
// 재고 주소: 센터 + 창고 + 로케이션 + 화주사 + 품목 + 로트번호 + 유통기한
// - 수량은 직접 고치지 않는다: 재고 변경 공통 함수(이력 기록과 한 트랜잭션)로만 바꾼다 (CLAUDE.md)
// - 수량은 기본단위, Decimal. 로트·유통기한을 쓰지 않는 품목은 비어 있다(null)
// - 같은 주소는 한 줄: 로케이션 + 품목 + 로트 + 유통기한 고유 (빈 칸도 같게 본다 — NULLS NOT DISTINCT, 마이그레이션 SQL에서)
// - 센터·창고·화주사는 로케이션·품목에서 정해지지만 조회가 빠르도록 함께 둔다 (재고 변경 함수가 맞춰 넣는다)
// - 수량이 0이 돼도 줄은 남긴다 (이력이 이 줄을 가리킨다)
model Stock {
  id          BigInt    @id @default(autoincrement()) @map("stock_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt    @map("operator_id")
  operator    Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  centerId    BigInt    @map("center_id")
  center      Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  warehouseId BigInt    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId  BigInt    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shipperId   BigInt    @map("shipper_id")
  shipper     Shipper   @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  itemId      BigInt    @map("item_id")
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotNo       String?   @map("lot_no") @db.VarChar(50)
  expiryOn    DateTime? @map("expiry_dt") @db.Date

  // 수량 (기본단위). 0 이상
  qty          Decimal @default(0) @map("stock_qty") @db.Decimal(18, 3)
  // 할당(출고 예약) 수량: 0 이상, 수량 이하 (출고 작업에서 쓴다, 사용자 결정으로 미리 둔다)
  allocatedQty Decimal @default(0) @map("alloc_qty") @db.Decimal(18, 3)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 동시 처리 안전: 재고 변경 함수가 줄을 잠그고 바꾼다. 버전은 화면 확인용
  rowVersion Int      @default(1) @map("row_version")

  txns         StockTxn[]
  receiptLines InboundReceiptLine[]
  adjustLines  StockAdjustLine[]

  @@unique([locationId, itemId, lotNo, expiryOn], map: "tb_stock_address_key")
  @@index([operatorId])
  @@index([centerId, shipperId, itemId])
  @@index([itemId])
  @@map("tb_stock")
}

// 재고 이력 유형 (프로그램이 값에 따라 동작이 다르므로 enum, 0030)
enum StockTxnType {
  // 입고 확정: 입고대기 창고에 재고가 생긴다
  RECEIVE
  // 이동(적치 포함): 출발 로케이션에서 나감 / 도착 로케이션에 들어옴 (두 줄, 같은 묶음 번호)
  MOVE_OUT
  MOVE_IN
  // 재고 조정: 사유 필수
  ADJUST
}

// 재고 이력 (docs/decisions/0044): 수량이 바뀐 한 번 = 한 줄. 지우거나 고치지 않는 기록 (DB가 막는다)
// 주소 칸은 그때 모습 그대로 함께 둔다 (재고 줄과 같지만, 이력만 봐도 알 수 있게)
model StockTxn {
  id          BigInt       @id @default(autoincrement()) @map("stock_txn_id")
  operatorId  BigInt       @map("operator_id")
  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  stockId     BigInt       @map("stock_id")
  stock       Stock        @relation(fields: [stockId], references: [id], onDelete: Restrict)
  centerId    BigInt       @map("center_id")
  warehouseId BigInt       @map("warehouse_id")
  locationId  BigInt       @map("location_id")
  shipperId   BigInt       @map("shipper_id")
  itemId      BigInt       @map("item_id")
  lotNo       String?      @map("lot_no") @db.VarChar(50)
  expiryOn    DateTime?    @map("expiry_dt") @db.Date
  type        StockTxnType @map("txn_type_cd")
  // 변동 수량 (+ 늘어남 / − 줄어듦, 기본단위, 0 아님)과 변동 후 수량
  qtyChange   Decimal      @map("chg_qty") @db.Decimal(18, 3)
  qtyAfter    Decimal      @map("after_qty") @db.Decimal(18, 3)
  // 묶음 번호: 이동처럼 여러 줄이 한 번의 작업일 때 같은 값 (첫 줄의 이력 키)
  groupId     BigInt?      @map("txn_group_id")
  // 원본 문서: 종류(예: RECEIPT 입고확정, ADJUSTMENT 조정) + 키 + 화면에 보일 번호
  refType     String?      @map("ref_type_cd") @db.VarChar(20)
  refId       BigInt?      @map("ref_id")
  refNo       String?      @map("ref_no") @db.VarChar(50)
  // 사유 (조정은 필수)
  reason      String?      @db.VarChar(200)
  txnAt       DateTime     @default(now()) @map("txn_at")
  // 처리한 사람 아이디 (재고 변경 함수가 지금 작업자로 채운다)
  createdBy   String       @default("system") @map("created_by") @db.VarChar(50)

  @@index([stockId, txnAt])
  @@index([operatorId, txnAt])
  @@index([itemId, txnAt])
  @@index([locationId, txnAt])
  @@index([refType, refId])
  @@index([groupId])
  @@map("tb_stock_txn")
}

// ─── 입고 (M5, docs/decisions/0047) ─────────────────────────
// ASN(입고예정) 하나에 검수·입고 확정이 여러 번 나눠 일어날 수 있다 (0003 결정 5)
// ASN (헤더 + 라인) └ 입고확정 1차 (문서 + 라인) → 입고대기 창고에 재고 생성 └ 적치 …

// 입고 유형: 화주사가 보낸 물건 / 다른 센터에서 이동해 온 물건 (MVP 이후)
enum InboundType {
  SHIPPER
  TRANSFER
}

// 등록 경로: 화주 포털 / 센터 대리 등록 / 엑셀 업로드
enum AsnChannel {
  PORTAL
  PROXY
  EXCEL
}

// 입고 상태: 예정 → 검수중 → 부분확정 → 확정완료, 또는 → 마감
enum AsnStatus {
  PLANNED
  INSPECTING
  PARTIAL
  COMPLETED
  CLOSED
}

// 적치 상태: 적치대기 → 부분적치 → 적치완료
enum PutawayStatus {
  WAITING
  PARTIAL
  DONE
}

// ASN 헤더
model Asn {
  id         BigInt   @id @default(autoincrement()) @map("asn_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  centerId   BigInt   @map("center_id")
  center     Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)
  shipperId  BigInt   @map("shipper_id")
  shipper    Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  // ASN 번호 (자동: AS + 등록일 YYMMDD + '-' + 일련번호, 운영사 전체에서 하나)
  asnNo      String   @unique @map("asn_no") @db.VarChar(20)

  type         InboundType @default(SHIPPER) @map("inbound_type_cd")
  channel      AsnChannel  @map("reg_channel_cd")
  // 입고 예정일
  expectedOn   DateTime    @map("expected_dt") @db.Date
  // 화주사 쪽 문서 번호 (발주번호 등, 선택)
  shipperRefNo String?     @map("shipper_ref_no") @db.VarChar(50)
  remark       String?     @db.VarChar(1000)

  status        AsnStatus     @default(PLANNED) @map("asn_status_cd")
  putawayStatus PutawayStatus @default(WAITING) @map("putaway_status_cd")
  // 잔량 마감 (사유 필수, 마감자·일시)
  closeReason   String?       @map("close_reason") @db.VarChar(200)
  closedAt      DateTime?     @map("closed_at")
  closedBy      String?       @map("closed_by") @db.VarChar(50)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  lines       AsnLine[]
  receipts    InboundReceipt[]
  inspections InboundInspection[]

  // 논리 삭제: 예정(PLANNED) 상태에서만 지울 수 있다
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@index([operatorId])
  @@index([centerId, status])
  @@index([shipperId, expectedOn])
  @@map("tb_asn")
}

// ASN 라인 (헤더와 통째로 바뀌는 하위 표: 감사 칸은 헤더 이력으로 본다)
// 수량은 모두 기본단위. 잔량 = max(예정 − 누적 확정, 0), 초과 = max(누적 확정 − 예정, 0) 은 저장하지 않고 계산한다
model AsnLine {
  id         BigInt   @id @default(autoincrement()) @map("asn_line_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  asnId      BigInt   @map("asn_id")
  asn        Asn      @relation(fields: [asnId], references: [id], onDelete: Restrict)
  lineNo     Int      @map("line_no")
  itemId     BigInt   @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // 예정 수량 (기본단위)
  expectedQty Decimal   @map("expected_qty") @db.Decimal(18, 3)
  // 입력한 단위·수량 (화면 표시용, 예: BOX 3 → 예정 72 EA)
  entryUnit   String?   @map("entry_unit_cd") @db.VarChar(20)
  entryQty    Decimal?  @map("entry_qty") @db.Decimal(18, 3)
  // 화주사가 알려 준 로트·유통기한 (참고용, 검수에서 실제 값을 넣는다)
  lotNo       String?   @map("lot_no") @db.VarChar(50)
  expiryOn    DateTime? @map("expiry_dt") @db.Date

  // 누적 수량 (입고 확정·적치·마감 때 함께 바뀐다)
  confirmedQty Decimal @default(0) @map("confirmed_qty") @db.Decimal(18, 3)
  putawayQty   Decimal @default(0) @map("putaway_qty") @db.Decimal(18, 3)
  // 마감 때 남아 있던 잔량 (보고서용)
  closedQty    Decimal @default(0) @map("closed_qty") @db.Decimal(18, 3)
  remark       String? @db.VarChar(200)

  receiptLines InboundReceiptLine[]
  inspections  InboundInspection[]

  @@unique([asnId, lineNo])
  @@index([itemId])
  @@index([operatorId])
  @@map("tb_asn_line")
}

// 입고확정 문서: 확정할 때마다 하나 (부분 확정이면 ASN 하나에 여러 개)
model InboundReceipt {
  id          BigInt   @id @default(autoincrement()) @map("receipt_id")
  operatorId  BigInt   @map("operator_id")
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  asnId       BigInt   @map("asn_id")
  asn         Asn      @relation(fields: [asnId], references: [id], onDelete: Restrict)
  // 확정 번호 (자동: RC + YYMMDD + '-' + 일련번호)
  receiptNo   String   @unique @map("receipt_no") @db.VarChar(20)
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  confirmedBy String   @default("system") @map("confirmed_by") @db.VarChar(50)
  remark      String?  @db.VarChar(200)

  lines InboundReceiptLine[]

  @@index([asnId])
  @@index([operatorId, confirmedAt])
  @@map("tb_inbound_receipt")
}

// 입고확정 라인: 확정 수량이 입고대기 창고의 어느 재고 줄이 됐는지 (적치는 이 줄의 재고만)
model InboundReceiptLine {
  id           BigInt            @id @default(autoincrement()) @map("receipt_line_id")
  operatorId   BigInt            @map("operator_id")
  operator     Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  receiptId    BigInt            @map("receipt_id")
  receipt      InboundReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  asnLineId    BigInt            @map("asn_line_id")
  asnLine      AsnLine           @relation(fields: [asnLineId], references: [id], onDelete: Restrict)
  // 어느 검수 결과를 확정했는지 (확정은 검수된 수량에서만)
  inspectionId BigInt            @map("inspection_id")
  inspection   InboundInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  // 만들어진(또는 더해진) 재고 줄 = 입고대기 창고 로케이션 + 품목 + 로트 + 유통기한
  stockId      BigInt            @map("stock_id")
  stock        Stock             @relation(fields: [stockId], references: [id], onDelete: Restrict)
  stockTxnId   BigInt            @map("stock_txn_id")
  lotNo        String?           @map("lot_no") @db.VarChar(50)
  expiryOn     DateTime?         @map("expiry_dt") @db.Date

  // 확정 수량 (기본단위)과 그중 적치한 수량
  qty        Decimal @map("confirm_qty") @db.Decimal(18, 3)
  putawayQty Decimal @default(0) @map("putaway_qty") @db.Decimal(18, 3)

  putaways Putaway[]

  @@index([receiptId])
  @@index([asnLineId])
  @@index([inspectionId])
  @@index([stockId])
  @@index([operatorId])
  @@map("tb_inbound_receipt_line")
}

// 입고 검수 결과 (docs/decisions/0053): ASN 라인 하나에 여러 건 (로트·유통기한이 다르게 도착하면 나눠 적는다)
// 검수 수량(정상)만 입고 확정할 수 있고, 불량 수량은 기록만 한다. 수량은 모두 기본단위
model InboundInspection {
  id         BigInt   @id @default(autoincrement()) @map("inspection_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  asnId      BigInt   @map("asn_id")
  asn        Asn      @relation(fields: [asnId], references: [id], onDelete: Restrict)
  asnLineId  BigInt   @map("asn_line_id")
  asnLine    AsnLine  @relation(fields: [asnLineId], references: [id], onDelete: Restrict)
  itemId     BigInt   @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // 로트·유통기한: 품목 설정에 따라 필수 또는 null
  lotNo    String?   @map("lot_no") @db.VarChar(50)
  expiryOn DateTime? @map("expiry_dt") @db.Date

  // 검수 수량(정상, 확정 가능) · 불량 수량 · 그중 확정한 수량
  inspectedQty Decimal  @map("inspect_qty") @db.Decimal(18, 3)
  defectQty    Decimal  @default(0) @map("defect_qty") @db.Decimal(18, 3)
  confirmedQty Decimal  @default(0) @map("confirmed_qty") @db.Decimal(18, 3)
  // 입력한 단위·수량 (화면 표시용, 예: BOX 5)
  entryUnit    String?  @map("entry_unit_cd") @db.VarChar(20)
  entryQty     Decimal? @map("entry_qty") @db.Decimal(18, 3)
  remark       String?  @db.VarChar(200)

  inspectedAt DateTime @default(now()) @map("inspected_at")
  inspectedBy String   @default("system") @map("inspected_by") @db.VarChar(50)

  receiptLines InboundReceiptLine[]
  labels       InboundLabel[]

  @@index([asnId])
  @@index([asnLineId])
  @@index([operatorId])
  @@map("tb_inbound_inspection")
}

// 관리 라벨 (docs/decisions/0054): 검수 결과 하나 → 라벨 여러 장 (라벨 단위 입수량으로 나누고 마지막 장은 나머지, 0003 결정 6)
// 라벨 번호는 하나뿐이고, 같은 라벨을 다시 인쇄(재발행)하면 인쇄 횟수만 는다
model InboundLabel {
  id            BigInt            @id @default(autoincrement()) @map("label_id")
  operatorId    BigInt            @map("operator_id")
  operator      Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 라벨 번호 (자동: LB + YYMMDD + '-' + 일련번호)
  labelNo       String            @unique @map("label_no") @db.VarChar(20)
  inspectionId  BigInt            @map("inspection_id")
  inspection    InboundInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  // 몇 번째 장 / 모두 몇 장 (예: 2 / 3)
  seq           Int               @map("label_seq")
  total         Int               @map("label_cnt")
  // 라벨 단위(PLT·BOX)와 이 장의 수량 (기본단위)
  labelUnit     LabelUnit         @map("label_unit_cd")
  qty           Decimal           @map("label_qty") @db.Decimal(18, 3)
  // 2D 코드에 담은 글자와 그 형식 버전 (항목이 늘어도 스캐너가 구분하게, 0003)
  formatVersion Int               @map("format_ver")
  payload       String            @db.VarChar(500)

  printCount    Int       @default(0) @map("print_cnt")
  lastPrintedAt DateTime? @map("last_printed_at")
  lastPrintedBy String?   @map("last_printed_by") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @default("system") @map("created_by") @db.VarChar(50)

  @@unique([inspectionId, seq])
  @@index([operatorId])
  @@map("tb_inbound_label")
}

// 적치 기록 (docs/decisions/0058): 입고확정 라인의 재고를 입고대기 창고 → 보관 로케이션으로 옮긴 한 번
// 실제 재고 이동은 재고 변경 공통 함수(moveStock)가 하고, 여기는 어느 확정분을 어디로 얼마나 옮겼는지 남긴다
model Putaway {
  id             BigInt             @id @default(autoincrement()) @map("putaway_id")
  operatorId     BigInt             @map("operator_id")
  operator       Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  receiptLineId  BigInt             @map("receipt_line_id")
  receiptLine    InboundReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  asnId          BigInt             @map("asn_id")
  itemId         BigInt             @map("item_id")
  fromLocationId BigInt             @map("from_location_id")
  toLocationId   BigInt             @map("to_location_id")
  lotNo          String?            @map("lot_no") @db.VarChar(50)
  expiryOn       DateTime?          @map("expiry_dt") @db.Date
  qty            Decimal            @map("putaway_qty") @db.Decimal(18, 3)
  // 재고 이력의 묶음 번호 (나감·들어옴 두 줄)
  txnGroupId     BigInt             @map("txn_group_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  createdBy      String             @default("system") @map("created_by") @db.VarChar(50)

  @@index([receiptLineId])
  @@index([asnId])
  @@index([operatorId, createdAt])
  @@map("tb_putaway")
}

// ─── 재고 실사·조정 (M6, docs/decisions/0061) ─────────────────
// 작업자가 등록하고(등록) 관리자가 확정하면(확정) 재고가 바뀐다 (권한 stock.adjustments.create / confirm)

// 실사: 센 수량을 적고 확정 때 (센 수량 − 그때 재고)만큼 바꾼다 / 조정: 늘리거나 줄일 수량(±)을 적는다
enum StockAdjustType {
  COUNT
  ADJUST
}

enum StockAdjustStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

model StockAdjust {
  id         BigInt            @id @default(autoincrement()) @map("adjust_id")
  operatorId BigInt            @map("operator_id")
  operator   Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 번호 (자동: AJ + YYMMDD + '-' + 일련번호)
  adjustNo   String            @unique @map("adjust_no") @db.VarChar(20)
  type       StockAdjustType   @map("adjust_type_cd")
  centerId   BigInt            @map("center_id")
  status     StockAdjustStatus @default(DRAFT) @map("adjust_status_cd")
  // 사유 (필수)
  reason     String            @db.VarChar(200)
  remark     String?           @db.VarChar(500)

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") @db.VarChar(50)
  canceledAt  DateTime? @map("canceled_at")
  canceledBy  String?   @map("canceled_by") @db.VarChar(50)

  lines StockAdjustLine[]

  @@index([operatorId, createdAt])
  @@index([centerId, status])
  @@map("tb_stock_adjust")
}

// 실사·조정 줄: 재고 줄 하나 (로케이션 + 품목 + 로트 + 유통기한)
model StockAdjustLine {
  id         BigInt      @id @default(autoincrement()) @map("adjust_line_id")
  operatorId BigInt      @map("operator_id")
  operator   Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  adjustId   BigInt      @map("adjust_id")
  adjust     StockAdjust @relation(fields: [adjustId], references: [id], onDelete: Cascade)
  lineNo     Int         @map("line_no")
  stockId    BigInt      @map("stock_id")
  stock      Stock       @relation(fields: [stockId], references: [id], onDelete: Restrict)

  // 등록 때 재고 (참고) / 실사: 센 수량 / 조정: 바꿀 수량(±)
  systemQty  Decimal  @map("system_qty") @db.Decimal(18, 3)
  countedQty Decimal? @map("counted_qty") @db.Decimal(18, 3)
  changeQty  Decimal? @map("chg_qty") @db.Decimal(18, 3)
  // 확정 때 실제로 바꾼 수량과 재고 이력 (0이면 바꾸지 않음 → 이력 없음)
  appliedQty Decimal? @map("applied_qty") @db.Decimal(18, 3)
  stockTxnId BigInt?  @map("stock_txn_id")

  @@unique([adjustId, lineNo])
  @@unique([adjustId, stockId])
  @@index([stockId])
  @@index([operatorId])
  @@map("tb_stock_adjust_line")
}

// ── 권역설정 (docs/decisions/0076) ─────────────────────────────────────────

// 지역 마스터 적재 이력 (운영사 공통): 적재 한 번 = 한 줄
model RegionLoadHist {
  id             BigInt    @id @default(autoincrement()) @map("load_id")
  // 기준 데이터 버전 (예: 202611)
  loadVer        String    @map("load_ver") @db.VarChar(20)
  sourceName     String    @map("source_nm") @db.VarChar(500)
  // FULL 전체분 / DELTA 변동분
  loadType       String    @map("load_type_cd") @db.VarChar(10)
  // RUNNING / DONE / FAILED
  status         String    @default("RUNNING") @map("status_cd") @db.VarChar(10)
  bjdCount       Int       @default(0) @map("bjd_cnt")
  zipCount       Int       @default(0) @map("zip_cnt")
  newCount       Int       @default(0) @map("new_cnt")
  changedCount   Int       @default(0) @map("changed_cnt")
  abolishedCount Int       @default(0) @map("abolished_cnt")
  errorMessage   String?   @map("error_msg") @db.VarChar(2000)
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdBy      String    @default("system") @map("created_by") @db.VarChar(50)

  @@map("tb_region_load_hist")
}

// 법정동 (운영사 공통, 적재 스크립트로만 갱신): 시도2 + 시군구3 + 읍면동3 + 리2
model RegionBjd {
  code        String         @id @map("bjd_cd") @db.Char(10)
  sidoCode    String         @map("sido_cd") @db.Char(2)
  sidoName    String         @map("sido_nm") @db.VarChar(30)
  sigunguCode String         @map("sigungu_cd") @db.Char(5)
  sigunguName String         @default("") @map("sigungu_nm") @db.VarChar(50)
  emdName     String?        @map("emd_nm") @db.VarChar(50)
  riName      String?        @map("ri_nm") @db.VarChar(50)
  // 1 시도 / 2 시군구 / 3 읍면동 / 4 리
  level       Int            @map("bjd_level") @db.SmallInt
  abolishedYn String         @default("N") @map("abolished_yn") @db.Char(1)
  abolishedOn DateTime?      @map("abolished_dt") @db.Date
  loadVer     String         @map("load_ver") @db.VarChar(20)
  zips        RegionZipBjd[]

  @@index([sigunguCode])
  @@index([sidoCode])
  @@map("tb_region_bjd")
}

// 우편번호 (5자리 기초구역번호, 운영사 공통)
model RegionZip {
  code         String            @id @map("zip_cd") @db.Char(5)
  sidoCode     String            @map("sido_cd") @db.Char(2)
  sigunguCode  String            @map("sigungu_cd") @db.Char(5)
  // 화면에서 우편번호 대신 보여 줄 설명 (예: 권선로 300~420, 세권로 1~88)
  repAddress   String?           @map("rep_addr") @db.VarChar(200)
  addressCount Int?              @map("addr_cnt")
  abolishedYn  String            @default("N") @map("abolished_yn") @db.Char(1)
  // 신규 우편번호 판별용
  firstLoadVer String            @map("first_load_ver") @db.VarChar(20)
  lastLoadVer  String            @map("last_load_ver") @db.VarChar(20)
  bjds         RegionZipBjd[]
  centerMaps   RegionCenterMap[]

  @@index([sigunguCode])
  @@map("tb_region_zip")
}

// 우편번호 ↔ 법정동 (N:M): 2개 이상 법정동에 걸치면 경계 우편번호
model RegionZipBjd {
  zipCode      String    @map("zip_cd") @db.Char(5)
  bjdCode      String    @map("bjd_cd") @db.Char(10)
  addressCount Int?      @map("addr_cnt")
  zip          RegionZip @relation(fields: [zipCode], references: [code], onDelete: Cascade)
  bjd          RegionBjd @relation(fields: [bjdCode], references: [code], onDelete: Cascade)

  @@id([zipCode, bjdCode])
  @@index([bjdCode])
  @@map("tb_region_zip_bjd")
}

// 권역 변경 작업 단위 (운영사별): 사용자 작업 한 번 = 한 줄. 작업 유형은 상수 REGION_CHANGE_TYPE
model RegionChangeBatch {
  id             BigInt                @id @default(autoincrement()) @map("batch_id")
  operatorId     BigInt                @map("operator_id")
  operator       Operator              @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  changeType     String                @map("change_type_cd") @db.VarChar(20)
  scopeDesc      String                @map("scope_desc") @db.VarChar(500)
  tempZone       String                @default("ALL") @map("temp_zone_cd") @db.VarChar(20)
  // 해제 작업이면 비움
  targetCenterId BigInt?               @map("target_center_id")
  targetCenter   Center?               @relation("RegionBatchTarget", fields: [targetCenterId], references: [id], onDelete: Restrict)
  changedCount   Int                   @default(0) @map("changed_cnt")
  reason         String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at")
  createdBy      String                @default("system") @map("created_by") @db.VarChar(50)
  maps           RegionCenterMap[]
  hists          RegionCenterMapHist[]

  @@index([operatorId, createdAt])
  @@map("tb_region_change_batch")
}

// 우편번호별 배송센터 배정 (운영사별): (운영사, 우편번호, 온도대)에 센터 하나. 행이 없으면 미배정
model RegionCenterMap {
  id          BigInt            @id @default(autoincrement()) @map("map_id")
  operatorId  BigInt            @map("operator_id")
  operator    Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  zipCode     String            @map("zip_cd") @db.Char(5)
  zip         RegionZip         @relation(fields: [zipCode], references: [code], onDelete: Restrict)
  // 'ALL' 또는 온도대 (온도대 행이 ALL보다 먼저)
  tempZone    String            @default("ALL") @map("temp_zone_cd") @db.VarChar(20)
  centerId    BigInt            @map("center_id")
  center      Center            @relation(fields: [centerId], references: [id], onDelete: Restrict)
  // MANUAL 사용자 지정 / SUGGESTED 신규 우편번호 자동 추천 / UPLOAD 엑셀
  assignType  String            @default("MANUAL") @map("assign_type_cd") @db.VarChar(20)
  // 추천 배정은 N으로 시작, 사용자가 확인하면 Y
  confirmYn   String            @default("Y") @map("confirm_yn") @db.Char(1)
  lastBatchId BigInt            @map("last_batch_id")
  lastBatch   RegionChangeBatch @relation(fields: [lastBatchId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  createdBy   String            @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String            @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int               @default(1) @map("row_version")

  @@unique([operatorId, zipCode, tempZone], map: "tb_region_center_map_operator_zip_temp_key")
  @@index([operatorId, centerId])
  @@index([operatorId, confirmYn])
  @@map("tb_region_center_map")
}

// 배정 변경 이력: 우편번호마다 전·후 센터 (비어 있으면 미배정)
model RegionCenterMapHist {
  id             BigInt            @id @default(autoincrement()) @map("hist_id")
  batchId        BigInt            @map("batch_id")
  batch          RegionChangeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  operatorId     BigInt            @map("operator_id")
  zipCode        String            @map("zip_cd") @db.Char(5)
  tempZone       String            @map("temp_zone_cd") @db.VarChar(20)
  beforeCenterId BigInt?           @map("before_center_id")
  afterCenterId  BigInt?           @map("after_center_id")
  changedAt      DateTime          @default(now()) @map("changed_at")

  @@index([batchId])
  @@index([operatorId, zipCode, tempZone, changedAt], map: "tb_region_center_map_hist_lookup_idx")
  @@map("tb_region_center_map_hist")
}

// 주소 정제 결과 캐시 (운영사 공통): 정리한 주소 + 원본 우편번호의 해시
model AddressNormCache {
  addrHash     String    @id @map("addr_hash") @db.Char(64)
  rawAddress   String    @map("raw_addr") @db.VarChar(500)
  // A~D, F (상수 ADDR_GRADE)
  grade        String    @db.Char(1)
  method       String    @map("method_cd") @db.VarChar(20)
  zipCode      String?   @map("zip_cd") @db.Char(5)
  bjdCode      String?   @map("bjd_cd") @db.Char(10)
  sigunguCode  String?   @map("sigungu_cd") @db.Char(5)
  sidoCode     String?   @map("sido_cd") @db.Char(2)
  roadAddress  String?   @map("road_addr") @db.VarChar(300)
  jibunAddress String?   @map("jibun_addr") @db.VarChar(300)
  bdMgtSn      String?   @map("bd_mgt_sn") @db.VarChar(30)
  // 주소 기준 데이터 버전 (갱신 후 C·D·F 재정제 판단)
  addrLoadVer  String?   @map("addr_load_ver") @db.VarChar(20)
  hitCount     Int       @default(0) @map("hit_cnt")
  lastHitAt    DateTime? @map("last_hit_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("tb_address_norm_cache")
}

// ─────────────────────────────────────────────
// 화주 연동 API (docs/decisions/0081, 정의서 docs/specs/shipper.md PART 2)
// API 키 하나가 운영사·화주를 정한다. 키 원문은 저장하지 않고 HMAC-SHA256 해시만 (API_KEY_SECRET)
// ─────────────────────────────────────────────

// API 키: 형식 {환경}_{식별부}_{비밀부} (예: live_ak7f2c9x_…) — 식별부로 찾고 전체를 해시 비교
// 화주·환경별 사용 중(ACTIVE) 키는 최대 2개 (교체 기간에 새 키·옛 키를 함께 쓰게)
model ApiClient {
  id              BigInt    @id @default(autoincrement()) @map("api_client_id")
  operatorId      BigInt    @map("operator_id")
  operator        Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  shipperId       BigInt    @map("shipper_id")
  shipper         Shipper   @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  name            String    @map("key_nm") @db.VarChar(50)
  // 환경: TEST(검증만, 저장 안 함 — dry-run) / LIVE
  env             String    @map("env_cd") @db.VarChar(10)
  keyPrefix       String    @unique @map("key_prefix") @db.VarChar(20)
  keyHash         String    @map("key_hash") @db.Char(64)
  // 상태: ACTIVE / REVOKED(폐기) / EXPIRED(만료 — 만료일 지난 키를 처음 쓸 때 바뀜)
  status          String    @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 비어 있으면 무기한
  expiresAt       DateTime? @map("expires_at")
  rateLimitPerMin Int       @default(120) @map("rate_limit_per_min")
  lastUsedAt      DateTime? @map("last_used_at")
  lastUsedIp      String?   @map("last_used_ip") @db.VarChar(45)
  issuedAt        DateTime  @default(now()) @map("issued_at")
  issuedBy        String    @map("issued_by") @db.VarChar(50)
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by") @db.VarChar(50)
  revokeReason    String?   @map("revoke_reason") @db.VarChar(200)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy       String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion      Int       @default(1) @map("row_version")

  scopes ApiClientScope[]
  ips    ApiClientIp[]
  events ApiClientEvent[]

  @@index([shipperId, env, status])
  @@map("tb_api_client")
}

// 키 권한 (상수 API_SCOPE: PARTNER_READ … STOCK_READ)
model ApiClientScope {
  apiClientId BigInt    @map("api_client_id")
  scope       String    @map("scope_cd") @db.VarChar(30)
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@id([apiClientId, scope])
  @@map("tb_api_client_scope")
}

// 허용 IP (하나도 없으면 모든 IP 허용)
model ApiClientIp {
  id          BigInt    @id @default(autoincrement()) @map("api_client_ip_id")
  apiClientId BigInt    @map("api_client_id")
  ipCidr      String    @map("ip_cidr") @db.VarChar(50)
  description String?   @db.VarChar(100)
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@index([apiClientId])
  @@map("tb_api_client_ip")
}

// 키 이력 (감사 로그): 발급·수정·폐기·만료를 한 줄씩 (누가·언제·바뀐 내용)
model ApiClientEvent {
  id          BigInt    @id @default(autoincrement()) @map("event_id")
  operatorId  BigInt    @map("operator_id")
  apiClientId BigInt    @map("api_client_id")
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  // ISSUED / UPDATED / REVOKED / EXPIRED
  event       String    @map("event_cd") @db.VarChar(20)
  detail      Json?
  actor       String    @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([apiClientId, createdAt])
  @@map("tb_api_client_event")
}

// API 요청 로그: 요청 하나에 한 줄 (응답을 보낸 뒤 저장). 본문은 개인정보를 가린 뒤 저장하고 90일 뒤 비운다
model ApiRequestLog {
  // 응답에도 넣어 화주가 문의할 때 쓴다 (req_YYYYMMDD_무작위)
  requestId      String   @id @map("request_id") @db.VarChar(40)
  // 키 확인 전에 실패하면 비어 있다
  operatorId     BigInt?  @map("operator_id")
  shipperId      BigInt?  @map("shipper_id")
  apiClientId    BigInt?  @map("api_client_id")
  env            String?  @map("env_cd") @db.VarChar(10)
  // API 구분 (예: ME, PARTNER_UPSERT, ORDER_CREATE)
  apiCode        String   @map("api_cd") @db.VarChar(50)
  httpMethod     String   @map("http_method") @db.VarChar(10)
  path           String   @db.VarChar(300)
  clientIp       String?  @map("client_ip") @db.VarChar(45)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(100)
  requestedAt    DateTime @map("req_at") @db.Timestamp(3)
  durationMs     Int      @map("duration_ms")
  httpStatus     Int      @map("http_status")
  // SUCCESS / PARTIAL / FAIL
  result         String   @map("result_cd") @db.VarChar(20)
  totalCount     Int      @default(0) @map("total_cnt")
  successCount   Int      @default(0) @map("success_cnt")
  failCount      Int      @default(0) @map("fail_cnt")
  errorCode      String?  @map("error_cd") @db.VarChar(30)
  requestBody    String?  @map("req_body")
  responseBody   String?  @map("resp_body")

  items ApiRequestItem[]

  @@index([operatorId, requestedAt])
  @@index([shipperId, requestedAt])
  @@index([apiClientId, requestedAt])
  @@map("tb_api_request_log")
}

// 건별 결과 (등록 API의 배열 한 건마다)
model ApiRequestItem {
  requestId  String        @map("request_id") @db.VarChar(40)
  seq        Int
  // 화주 문서번호 (거래처코드·품목코드·ASN번호·주문번호)
  extDocNo   String?       @map("ext_doc_no") @db.VarChar(50)
  // CREATED / UPDATED / UNCHANGED / DUPLICATE / FAIL
  result     String        @map("result_cd") @db.VarChar(20)
  errorCode  String?       @map("error_cd") @db.VarChar(30)
  errorMsg   String?       @map("error_msg") @db.VarChar(500)
  internalId BigInt?       @map("internal_id")
  request    ApiRequestLog @relation(fields: [requestId], references: [requestId], onDelete: Cascade)

  @@id([requestId, seq])
  @@map("tb_api_request_item")
}

// 멱등 처리: 같은 키 + 같은 Idempotency-Key → 처음 응답을 그대로 (24시간 뒤 지움)
model ApiIdempotency {
  apiClientId    BigInt   @map("api_client_id")
  idempotencyKey String   @map("idempotency_key") @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.Char(64)
  requestId      String   @map("request_id") @db.VarChar(40)
  httpStatus     Int      @map("http_status")
  responseBody   String   @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@id([apiClientId, idempotencyKey])
  @@index([createdAt])
  @@map("tb_api_idempotency")
}

// 호출 한도 카운터: 키별 1분 구간마다 한 줄 (고정 구간, 지난 구간은 지움)
model ApiRateBucket {
  apiClientId BigInt   @map("api_client_id")
  windowStart DateTime @map("window_start")
  count       Int      @default(0) @map("req_cnt")

  @@id([apiClientId, windowStart])
  @@map("tb_api_rate_bucket")
}
