// DB 구조 설계도
// 문서: https://pris.ly/d/prisma-schema
// 데이터 구조 결정: docs/decisions/0003-domain-model.md, 0010-auth-and-permission-model.md

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// 연결 주소는 prisma.config.ts(명령어용)와 src/lib/prisma.ts(앱 실행용)에서 지정한다
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증 (Better Auth)
// user / session / account / verification 은 Better Auth가 사용하는 표다.
// `npx auth generate`로 만든 뒤 우리 정보(userType, status, 권한 연결)를 더했다.
// Better Auth 필드 이름·구조는 바꾸지 않는다.
// ─────────────────────────────────────────────

// 사용자 유형: 데이터 범위(볼 수 있는 데이터)를 정하는 기준
enum UserType {
  OPERATOR // 운영사 관리자 → 자기 운영사 전체
  CENTER // 센터 운영자·작업자 → 소속 센터
  SHIPPER // 화주사 사용자 → 자기 화주사
  PLATFORM // 플랫폼 관리자 → 운영사에 속하지 않음, /platform (운영사를 골라 그 운영사로 작업할 수 있다, 0039)
}

model User {
  id              BigInt    @id @default(autoincrement()) @map("user_id")
  // 운영사 (멀티테넌트, 0039). 플랫폼 관리자만 비어 있고 나머지 유형은 반드시 있다 (DB 검사 조건 tb_user_operator_matches_type)
  operatorId      BigInt?   @map("operator_id")
  operator        Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  name            String    @map("user_nm")
  // 아이디 로그인을 쓰므로 이메일이 없는 사용자는 내부용 주소를 자동으로 채운다 (사용자 관리 작업에서)
  email           String
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy       String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy       String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion      Int       @default(1) @map("row_version")
  // 로그인 아이디 (username 플러그인)
  username        String?
  displayUsername String?   @map("display_username")
  userType        UserType  @map("user_type_cd")
  // false면 로그인·사용 불가 (퇴사자 등). 기록 보존을 위해 계정을 지우지 않고 막는다
  status          String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 화주사 사용자의 소속 화주사 (화주사 사용자만, DB 검사 조건으로 강제: tb_user_shipper_matches_type)
  shipperId       BigInt?   @map("shipper_id")
  shipper         Shipper?  @relation(fields: [shipperId], references: [id], onDelete: Restrict)

  sessions            Session[]
  accounts            Account[]
  permissionGroups    UserPermissionGroup[]
  permissionOverrides UserPermissionOverride[]
  // 센터 직원의 소속 센터 (여러 개 가능)
  centers             UserCenter[]
  // 목록 그리드 개인 설정 (숨긴 컬럼·순서·너비 등)
  gridSettings        UserGridSetting[]
  prefs               UserPref[]
  // 사이드바 즐겨찾기 메뉴
  favoriteMenus       UserFavoriteMenu[]

  @@unique([email])
  @@unique([username])
  @@index([shipperId])
  @@index([operatorId])
  @@map("tb_user")
}

model Session {
  id        BigInt   @id @default(autoincrement()) @map("session_id")
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("tb_session")
}

// 로그인 수단: 아이디·비밀번호 로그인의 비밀번호(암호화된 값)가 여기에 저장된다
model Account {
  id                    BigInt    @id @default(autoincrement()) @map("acct_id")
  accountId             String    @map("provider_account_id")
  providerId            String    @map("provider_id")
  userId                BigInt    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("tb_account")
}

model Verification {
  id         BigInt   @id @default(autoincrement()) @map("verification_id")
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("tb_verification")
}

// ─────────────────────────────────────────────
// 권한 (0003 결정 7)
// 최종 권한 = 그룹 권한 합 + 사용자 추가(GRANT) − 사용자 제외(DENY)
// 권한 코드(예: inbound.asn.create)는 코드 한 곳에서 목록으로 관리하고, DB에는 코드 글자만 저장한다
// ─────────────────────────────────────────────

// 화면 영역: ADMIN = 운영사 화면(/admin), PORTAL = 화주 포털(/portal)
enum AppArea {
  ADMIN
  PORTAL
}

// 권한그룹: 권한 코드 묶음 (예: "센터 운영자", "화주 담당자")
model PermissionGroup {
  id          BigInt   @id @default(autoincrement()) @map("perm_group_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt   @map("operator_id")
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  name        String   @map("perm_group_nm")
  // 이 그룹이 다루는 영역: 그 영역의 권한만 담고, 맞는 유형의 사용자에게만 배정한다 (등록 후 변경 불가)
  area        AppArea  @default(ADMIN) @map("app_area_cd")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int      @default(1) @map("row_version")

  permissions PermissionGroupPermission[]
  users       UserPermissionGroup[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 이름는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, name], where: raw("del_yn = 'N'"), map: "tb_perm_group_operator_id_perm_group_nm_key")
  @@map("tb_perm_group")
}

// 권한그룹에 들어 있는 권한 코드 (그룹을 지우면 함께 지워진다)
model PermissionGroupPermission {
  groupId        BigInt          @map("group_id")
  permissionCode String          @map("perm_cd")
  group          PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionCode])
  @@map("tb_perm_group_perm")
}

// 사용자 ↔ 권한그룹 (한 사용자가 여러 그룹에 속할 수 있다)
// 사용자가 남아 있는 그룹은 지울 수 없다 (Restrict): 실수로 여러 사람의 권한이 사라지는 것을 막는다
model UserPermissionGroup {
  userId    BigInt          @map("user_id")
  groupId   BigInt          @map("group_id")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("tb_user_perm_group")
}

enum PermissionEffect {
  GRANT // 그룹에 없어도 이 사용자에게 추가
  DENY // 그룹에 있어도 이 사용자에게서 제외
}

// 사용자별 권한 예외: 같은 사용자·같은 코드에는 하나만 (추가와 제외가 동시에 있을 수 없다)
model UserPermissionOverride {
  userId         BigInt           @map("user_id")
  permissionCode String           @map("perm_cd")
  effect         PermissionEffect @map("effect_cd")
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("tb_user_perm_override")
}

// ─────────────────────────────────────────────
// 조직 (0003 결정 1) — 데이터 범위에 필요한 최소 정보만. 자세한 정보는 M2(센터)·M3(화주사)에서 추가
// ─────────────────────────────────────────────

// 센터: 운영사의 물류센터
// 센터: 운영사의 물류센터 (docs/decisions/0026)
// 코드 3층 (0025): systemCode(자동·불변) / code(사용자 코드, 같은 운영사 안에서 중복 금지) / 외부 코드(ExternalCode)
model Center {
  id                   BigInt    @id @default(autoincrement()) @map("center_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId           BigInt    @map("operator_id")
  operator             Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 시스템 코드: CT000001 (내부용 불변 코드)
  systemCode           String    @unique @map("sys_cd")
  // ① 기본 정보 (docs/decisions/0073, docs/specs/center.md)
  // 센터코드: 영문 대문자·숫자 1~20자, 필수, 등록 후 바꿀 수 없음 (라벨·문서에 찍힌다)
  code                 String    @map("center_cd") @db.VarChar(20)
  name                 String    @map("center_nm") @db.VarChar(100)
  nameEn               String?   @map("center_nm_en") @db.VarChar(100)
  shortName            String?   @map("center_short_nm") @db.VarChar(30)
  // 센터 유형 (상수 CENTER_TYPE): OWN 자가 / LEASE 임차 / PARTNER 협력·위탁 / VIRTUAL 가상
  type                 String    @default("LEASE") @map("center_type_cd") @db.VarChar(20)
  // 운영 상태 (상수 CENTER_STATUS): PREPARING 준비중 / ACTIVE 운영중 / SUSPENDED 일시중지 / CLOSED 폐쇄
  // 폐쇄만 데이터 범위에서 빠지고, 새 업무(입고·재고 등) 고르기는 운영중만
  status               String    @default("PREPARING") @map("status_cd") @db.VarChar(20)
  statusReason         String?   @map("status_reason") @db.VarChar(200)
  openedOn             DateTime? @map("open_dt") @db.Date
  closedOn             DateTime? @map("close_dt") @db.Date
  // 운영사와 다를 때만 (NULL = 운영사 값), 숫자만
  businessNumber       String?   @map("biz_reg_no") @db.Char(10)
  subBizNo             String?   @map("sub_biz_no") @db.Char(4)
  sortOrder            Int       @default(0) @map("sort_seq")
  remark               String?   @db.VarChar(1000)
  extAttr              Json?     @map("ext_attr")
  // ② 위치·연락처 (전화번호는 하이픈 없이 숫자만, 0029)
  countryCode          String    @default("KR") @map("country_cd") @db.Char(2)
  zipCode              String?   @map("zip_cd") @db.VarChar(10)
  address              String?   @map("addr1") @db.VarChar(200)
  addressDetail        String?   @map("addr2") @db.VarChar(200)
  addressJibun         String?   @map("addr_jibun") @db.VarChar(200)
  regionName           String?   @map("region_nm") @db.VarChar(50)
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  phone                String?   @map("tel_no") @db.VarChar(15)
  fax                  String?   @map("fax_no") @db.VarChar(15)
  email                String?   @db.VarChar(100)
  directions           String?   @db.VarChar(1000)
  // 예전 센터장 칸 (사용자 결정으로 유지, 담당자 표와 별개)
  managerName          String?   @map("manager_nm")
  managerPhone         String?   @map("manager_tel_no")
  // ③ 시설 정보 (1차: 연면적·보관면적·도크 / 2차: 나머지)
  floorAreaM2          Decimal?  @map("floor_area_m2") @db.Decimal(12, 2)
  storageAreaM2        Decimal?  @map("storage_area_m2") @db.Decimal(12, 2)
  dockCount            Int?      @map("dock_cnt")
  landAreaM2           Decimal?  @map("land_area_m2") @db.Decimal(12, 2)
  floorCount           Int?      @map("floor_cnt")
  ceilingHeightM       Decimal?  @map("ceiling_height_m") @db.Decimal(5, 2)
  palletCapacity       Int?      @map("pallet_capa_cnt")
  // ④ 시설 자격 (1차: 보세 여부 / 2차: 나머지 — 보세 칸은 나중에 tb_center_bonded로 옮길 수 있다)
  bondedYn             String    @default("N") @map("bonded_yn") @db.Char(1)
  warehouseRegNo       String?   @map("warehouse_reg_no") @db.VarChar(30)
  glnCode              String?   @map("gln_cd") @db.VarChar(13)
  bondedType           String?   @map("bonded_type_cd") @db.VarChar(20)
  bondedLicenseNo      String?   @map("bonded_license_no") @db.VarChar(30)
  bondedAreaCode       String?   @map("bonded_area_cd") @db.VarChar(20)
  customsOfficeCode    String?   @map("customs_office_cd") @db.VarChar(10)
  hazmatYn             String    @default("N") @map("hazmat_yn") @db.Char(1)
  foodStorageYn        String    @default("N") @map("food_storage_yn") @db.Char(1)
  pharmaYn             String    @default("N") @map("pharma_yn") @db.Char(1)
  // ⑤ 운영 설정 — 상속 칸(출고 마감·타임존·할당 규칙·로트·유통기한·시리얼)은 NULL = 운영사 값
  workStartTime        DateTime? @map("work_start_time") @db.Time(0)
  workEndTime          DateTime? @map("work_end_time") @db.Time(0)
  // 월~일 Y/N 7글자
  workDays             String    @default("YYYYYNN") @map("work_days") @db.Char(7)
  inboundCutoffTime    DateTime? @map("inbound_cutoff_time") @db.Time(0)
  shipCutoffTime       DateTime? @map("ship_cutoff_time") @db.Time(0)
  // 기본 로케이션 3개: 센터 생성·보정 때 입고대기·출고대기·반품대기 창고의 DEFAULT를 연결 (ensureCenterDefaults)
  defaultInboundLocId  BigInt?   @map("default_inbound_loc_id")
  defaultOutboundLocId BigInt?   @map("default_outbound_loc_id")
  defaultReturnLocId   BigInt?   @map("default_return_loc_id")
  defaultInboundLoc    Location? @relation("CenterDefaultInbound", fields: [defaultInboundLocId], references: [id], onDelete: Restrict)
  defaultOutboundLoc   Location? @relation("CenterDefaultOutbound", fields: [defaultOutboundLocId], references: [id], onDelete: Restrict)
  defaultReturnLoc     Location? @relation("CenterDefaultReturn", fields: [defaultReturnLocId], references: [id], onDelete: Restrict)
  timezone             String?   @db.VarChar(50)
  allocRule            String?   @map("alloc_rule_cd") @db.VarChar(10)
  useLot               String?   @map("lot_mgmt_yn") @db.Char(1)
  useExpiry            String?   @map("expiry_mgmt_yn") @db.Char(1)
  useSerial            String?   @map("serial_mgmt_yn") @db.Char(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy            String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy            String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion           Int       @default(1) @map("row_version")

  users             UserCenter[]
  warehouses        Warehouse[]
  deliveryZones     DeliveryZone[]
  shippers          ShipperCenter[]
  stocks            Stock[]
  asns              Asn[]
  // 이 센터를 배송 센터로 지정한 거래처 (0072)
  deliveryCustomers Customer[]
  contacts          CenterContact[]
  tempZones         CenterTempZone[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_center_operator_id_center_cd_key")
  @@map("tb_center")
}

// 센터 담당자 (0073): 운영사 담당자와 같은 모양, 최대 10명, 대표 1명 (센터 저장 때 함께 저장)
model CenterContact {
  id           BigInt   @id @default(autoincrement()) @map("contact_id")
  centerId     BigInt   @map("center_id")
  sortOrder    Int      @map("sort_seq")
  // 담당 업무: 운영사 공통코드 CENTER_CONTACT_ROLE의 코드 (예: MANAGER)
  duty         String   @map("role_cd") @db.VarChar(20)
  name         String   @map("contact_nm") @db.VarChar(50)
  phone        String?  @map("tel_no") @db.VarChar(15)
  email        String?  @db.VarChar(100)
  isPrimary    String   @default("N") @map("primary_yn") @db.Char(1)
  // [2차] 부서·직책·알림 수신
  deptName     String?  @map("dept_nm") @db.VarChar(50)
  positionName String?  @map("position_nm") @db.VarChar(50)
  notifyYn     String   @default("Y") @map("notify_yn") @db.Char(1)
  // 감사 칸: 저장 함수가 채운다 (버전은 센터에서 검사)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  createdBy    String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy    String   @default("system") @map("updated_by") @db.VarChar(50)
  center       Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, sortOrder])
  // 센터당 대표 1명
  @@unique([centerId], where: raw("primary_yn = 'Y'"), map: "tb_center_contact_primary_key")
  @@map("tb_center_contact")
}

// 센터 취급 온도대 (0073): 운영사 TEMP_ZONE 상수 재사용
model CenterTempZone {
  centerId   BigInt   @map("center_id")
  tempZoneCd String   @map("temp_zone_cd") @db.VarChar(20)
  // [2차] 면적·관리 온도
  areaM2     Decimal? @map("area_m2") @db.Decimal(12, 2)
  minTemp    Decimal? @map("min_temp") @db.Decimal(5, 1)
  maxTemp    Decimal? @map("max_temp") @db.Decimal(5, 1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@id([centerId, tempZoneCd])
  @@map("tb_center_temp_zone")
}

// 창고 보관 조건 (docs/decisions/0027): 냉장 물건을 상온 창고에 적치하는 실수를 나중에 경고하는 데 쓴다
enum StorageCondition {
  // 상온
  AMBIENT
  // 냉장
  CHILLED
  // 냉동
  FROZEN
}

enum WarehouseType {
  // 일반 보관 창고
  GENERAL
  // 입고대기 창고: 입고 확정 후 적치 전까지 재고가 머무는 곳 (센터마다 1개, 센터 등록 시 자동 생성)
  INBOUND_STAGING
  // 출고대기 창고: 피킹·검수 후 출고 전까지 (센터마다 1개, 0073)
  OUTBOUND_STAGING
  // 반품대기 창고: 반품 입고 후 판정 전까지 (센터마다 1개, 0073)
  RETURN_STAGING
}

// 창고: 센터 안의 보관 구역 (관리 화면은 "센터별 창고 관리" 작업에서)
model Warehouse {
  id               BigInt           @id @default(autoincrement()) @map("warehouse_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId       BigInt           @map("operator_id")
  operator         Operator         @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  centerId         BigInt           @map("center_id")
  // 시스템 코드: WH000001
  systemCode       String           @unique @map("sys_cd")
  // 사용자 코드: 같은 센터 안에서 중복 금지
  code             String           @map("warehouse_cd")
  name             String           @map("warehouse_nm")
  type             WarehouseType    @default(GENERAL) @map("warehouse_type_cd")
  storageCondition StorageCondition @default(AMBIENT) @map("temp_zone_cd")
  status           String           @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy        String           @default("system") @map("created_by") @db.VarChar(50)
  updatedBy        String           @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion       Int              @default(1) @map("row_version")
  center           Center           @relation(fields: [centerId], references: [id], onDelete: Restrict)
  locations        Location[]
  stocks           Stock[]

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([centerId, code], where: raw("del_yn = 'N'"), map: "tb_warehouse_center_id_warehouse_cd_key")
  // 센터마다 대기 창고(입고·출고·반품)는 유형별로 1개 (부분 고유 인덱스, 0073)
  @@unique([centerId, type], where: raw("warehouse_type_cd <> 'GENERAL'::\"WarehouseType\""), map: "tb_warehouse_one_staging_per_center")
  @@index([centerId])
  @@index([operatorId])
  @@map("tb_warehouse")
}

// 로케이션: 창고 안의 보관 위치. 코드 자체가 위치라 시스템 코드는 없다 (0025)
// 코드는 등록 후 바꿀 수 없다 (재고·적치 기록이 이 주소를 가리킨다, 0028)
model Location {
  id                BigInt    @id @default(autoincrement()) @map("location_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId        BigInt    @map("operator_id")
  operator          Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  warehouseId       BigInt    @map("warehouse_id")
  // 같은 창고 안에서 중복 금지 (예: A-01-01, DEFAULT)
  code              String    @map("location_cd")
  // 로케이션 명칭 (한글 가능, 0071): 비우면 코드와 같게 — 일괄 생성·기존 줄도 코드와 같다
  name              String    @map("location_nm") @db.VarChar(100)
  remark            String?   @db.VarChar(1000)
  // 일괄 생성으로 만들면 함께 저장: 구역(A) / 열(01) / 단(02) — 구역별 거르기·정렬용 (docs/decisions/0028)
  zone              String?   @map("zone_cd")
  aisle             String?   @map("aisle_cd")
  level             String?   @map("level_cd")
  status            String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy         String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy         String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion        Int       @default(1) @map("row_version")
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stocks            Stock[]
  // 센터 기본 로케이션으로 연결된 곳 (0073)
  defaultInboundOf  Center[]  @relation("CenterDefaultInbound")
  defaultOutboundOf Center[]  @relation("CenterDefaultOutbound")
  defaultReturnOf   Center[]  @relation("CenterDefaultReturn")

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([warehouseId, code], where: raw("del_yn = 'N'"), map: "tb_location_warehouse_id_location_cd_key")
  @@index([warehouseId, zone])
  @@index([operatorId])
  @@map("tb_location")
}

// 화주사: 운영사에 물건 보관·배송을 맡기는 회사
// 라벨 단위: 입고 라벨을 붙이는 단위 (0003 결정 7)
enum LabelUnit {
  PLT
  BOX
}

// 화주사 (docs/decisions/0035)
// 코드 3층 (0025): systemCode SH000001(자동·불변) / code(사용자 코드, 같은 운영사 안에서 중복 금지) / 외부 코드(ExternalCode)
model Shipper {
  id             BigInt    @id @default(autoincrement()) @map("shipper_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId     BigInt    @map("operator_id")
  operator       Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  systemCode     String    @unique @map("sys_cd")
  code           String    @map("shipper_cd")
  name           String    @map("shipper_nm")
  // 사업자등록번호·전화번호는 하이픈 없이 숫자만 (0029)
  businessNumber String?   @map("biz_reg_no")
  ceoName        String?   @map("ceo_nm")
  businessType   String?   @map("biz_condition")
  businessItem   String?   @map("biz_item")
  phone          String?   @map("tel_no")
  fax            String?   @map("fax_no")
  email          String?
  zipCode        String?   @map("zip_cd")
  address        String?   @map("addr1")
  addressDetail  String?   @map("addr2")
  // 품목 기본값: 품목에서 그대로 쓰거나 개별 지정한다 (0003 결정 2)
  useLot         String    @default("N") @map("lot_mgmt_yn") @db.Char(1)
  useExpiry      String    @default("N") @map("expiry_mgmt_yn") @db.Char(1)
  labelUnit      LabelUnit @default(PLT) @map("label_unit_cd")
  // false면 데이터 범위에서 빠진다 (소속 사용자도 데이터를 볼 수 없음)
  status         String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy      String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy      String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion     Int       @default(1) @map("row_version")

  users     User[]
  centers   ShipperCenter[]
  contacts  ShipperContact[]
  items     Item[]
  customers Customer[]
  stocks    Stock[]
  asns      Asn[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_shipper_operator_id_shipper_cd_key")
  @@map("tb_shipper")
}

// 화주사의 이용 센터 (화주사 ↔ 센터, 1개 이상) — 센터 직원은 자기 센터를 이용하는 화주사만 본다
model ShipperCenter {
  shipperId BigInt  @map("shipper_id")
  centerId  BigInt  @map("center_id")
  shipper   Shipper @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([shipperId, centerId])
  @@index([centerId])
  @@map("tb_shipper_center")
}

// 화주사 담당자 (운영사 담당자와 같은 모양: 최대 5명, 대표 1명, 담당 업무는 공통코드 CONTACT_DUTY)
model ShipperContact {
  id        BigInt  @id @default(autoincrement()) @map("contact_id")
  shipperId BigInt  @map("shipper_id")
  sortOrder Int     @map("sort_seq")
  duty      String  @map("role_cd")
  name      String  @map("contact_nm")
  phone     String? @map("tel_no")
  email     String?
  isPrimary String  @default("N") @map("primary_yn") @db.Char(1)
  shipper   Shipper @relation(fields: [shipperId], references: [id], onDelete: Cascade)

  @@index([shipperId, sortOrder])
  @@map("tb_shipper_contact")
}

// 센터 직원 ↔ 소속 센터 (한 직원이 여러 센터를 맡을 수 있다)
// 직원이 소속된 센터는 지울 수 없다 (Restrict)
model UserCenter {
  userId    BigInt   @map("user_id")
  centerId  BigInt   @map("center_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([userId, centerId])
  @@index([centerId])
  @@map("tb_user_center")
}

// 사용자별 목록 그리드 설정: 사용자 + 그리드 이름(DataGrid id) 하나에 한 줄 (docs/decisions/0021)
// settings 모양은 src/components/data-grid/settings.ts의 gridSettingsSchema (읽을 때 검사, 깨지면 기본값)
// 사용자 개인 설정 (docs/decisions/0056): 화면이 기억하는 고르기 값 (예: 라벨 인쇄 양식·코드 종류)
// 키는 코드에 정한 것만 (src/lib/prefs/user-prefs.ts), 값은 키마다 입력 규칙으로 검사한다
model UserPref {
  userId    BigInt   @map("user_id")
  prefKey   String   @map("pref_key") @db.VarChar(50)
  value     Json     @map("pref_value")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, prefKey])
  @@map("tb_user_pref")
}

model UserGridSetting {
  userId    BigInt   @map("user_id")
  gridId    String   @map("grid_cd")
  settings  Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gridId])
  @@map("tb_user_grid_setting")
}

// 사용자별 사이드바 즐겨찾기 메뉴 (docs/decisions/0022)
// 메뉴는 주소(href)로 구분한다 (메뉴 목록: src/config/navigation.ts). 추가한 순서(createdAt)대로 보여준다
// 권한이 사라지거나 목록에서 없어진 메뉴는 화면에서만 숨기고 기록은 남긴다 (권한이 돌아오면 다시 보임)
model UserFavoriteMenu {
  userId    BigInt   @map("user_id")
  href      String   @map("menu_href")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, href])
  @@map("tb_user_favorite_menu")
}

// 운영사 (docs/specs/operator.md, docs/decisions/0024·0039·0040): 플랫폼을 쓰는 3PL 회사
// 운영사마다 센터·화주사·공통코드·사용자를 따로 가진다. [1차] = DB·화면, [2차] = DB만(기본값) — 화면은 이후
// 플랫폼이 정하는 코드(유형·상태·사업자 구분·과세·요금제 등)는 상수 src/config/operator-codes.ts + DB 검사 조건
model Operator {
  id BigInt @id @default(autoincrement()) @map("operator_id")

  // ── ① 기본 정보 [1차]
  // 운영사코드: 영문 대문자·숫자·_- 2~20자, 등록 후 바꿀 수 없다. 관리자 아이디 admin.{코드 소문자}
  code           String    @map("operator_cd") @db.VarChar(20)
  name           String    @map("operator_nm") @db.VarChar(100)
  nameEn         String?   @map("operator_nm_en") @db.VarChar(100)
  shortName      String?   @map("operator_short_nm") @db.VarChar(50)
  // 운영사 유형 OPERATOR_TYPE (3PL 기본)
  type           String    @default("3PL") @map("operator_type_cd") @db.VarChar(20)
  // 운영 상태 OPERATOR_STATUS: PENDING 대기 / ACTIVE 운영 / SUSPENDED 정지 / TERMINATED 해지
  // ACTIVE가 아니면 그 운영사의 사용자는 로그인·사용할 수 없다 (플랫폼 관리자가 바꾼다, 0039)
  status         String    @default("ACTIVE") @map("status_cd") @db.VarChar(20)
  // 상태변경 사유 (정지·해지로 바꿀 때 필수)
  statusReason   String?   @map("status_reason") @db.VarChar(200)
  // 사업자등록번호·법인등록번호·전화번호는 하이픈 없이 숫자만 (0029)
  businessNumber String    @map("biz_reg_no") @db.Char(10)
  // 사업자 구분 BIZ_ENTITY (CORP 법인 / INDIVIDUAL 개인), 법인등록번호는 법인일 때만
  bizEntity      String    @default("CORP") @map("biz_entity_cd") @db.VarChar(10)
  corpRegNo      String?   @map("corp_reg_no") @db.Char(13)
  subBizNo       String?   @map("sub_biz_no") @db.Char(4)
  // 과세유형 TAX_TYPE
  taxType        String    @default("GENERAL") @map("tax_type_cd") @db.VarChar(10)
  ceoName        String?   @map("ceo_nm") @db.VarChar(50)
  // 업태 / 종목 (거래명세서·세금계산서용)
  businessType   String?   @map("biz_condition") @db.VarChar(100)
  businessItem   String?   @map("biz_item") @db.VarChar(100)
  establishedOn  DateTime? @map("establish_dt") @db.Date

  // ── ② 연락처·주소 [1차]
  phone         String?  @map("tel_no") @db.VarChar(15)
  fax           String?  @map("fax_no") @db.VarChar(15)
  email         String?  @db.VarChar(100)
  homepageUrl   String?  @map("homepage_url") @db.VarChar(200)
  // 국가 ISO 3166 (화면 미노출)
  country       String   @default("KR") @map("country_cd") @db.Char(2)
  // 주소: 카카오 우편번호 서비스로 검색해 채우고, 상세주소만 직접 입력. 지번주소는 검색 결과를 자동 저장
  zipCode       String?  @map("zip_cd") @db.VarChar(10)
  address       String?  @map("addr1") @db.VarChar(200)
  addressDetail String?  @map("addr2") @db.VarChar(200)
  addressJibun  String?  @map("addr_jibun") @db.VarChar(200)
  // 좌표 (주소 검색이 주지 않아 지금은 비어 있다)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  // ── ③ 물류 자격 [2차]
  warehouseRegNo   String?            @map("warehouse_reg_no") @db.VarChar(30)
  freightLicenseNo String?            @map("freight_license_no") @db.VarChar(30)
  bondedYn         String             @default("N") @map("bonded_yn") @db.Char(1)
  customsYn        String             @default("N") @map("customs_yn") @db.Char(1)
  glnCode          String?            @map("gln_cd") @db.VarChar(13)
  // 제공 서비스(SERVICE_TYPE, 운영사 공통코드)·취급 온도대(TEMP_ZONE) — 하위 표
  services         OperatorService[]
  tempZones        OperatorTempZone[]

  // ── ④ 운영 기본값 [2차] (센터·화주가 상속)
  currency       String    @default("KRW") @map("currency_cd") @db.Char(3)
  timezone       String    @default("Asia/Seoul") @db.VarChar(50)
  lang           String    @default("ko-KR") @map("lang_cd") @db.VarChar(5)
  weightUnit     String    @default("KG") @map("weight_unit_cd") @db.VarChar(5)
  lengthUnit     String    @default("CM") @map("length_unit_cd") @db.VarChar(5)
  // 재고할당 규칙 ALLOC_RULE
  allocRule      String    @default("FIFO") @map("alloc_rule_cd") @db.VarChar(10)
  useLot         String    @default("N") @map("lot_mgmt_yn") @db.Char(1)
  useExpiry      String    @default("N") @map("expiry_mgmt_yn") @db.Char(1)
  useSerial      String    @default("N") @map("serial_mgmt_yn") @db.Char(1)
  shipCutoffTime DateTime? @map("ship_cutoff_time") @db.Time(0)
  // 정산 마감일: 1~31일, 99 = 말일
  closingDay     Int       @default(99) @map("closing_day") @db.SmallInt

  // ── ⑤ 계약·요금제 [2차] (플랫폼만)
  plan            String    @default("TRIAL") @map("plan_cd") @db.VarChar(20)
  contractStartOn DateTime  @default(dbgenerated("CURRENT_DATE")) @map("contract_start_dt") @db.Date
  // 비어 있으면 무기한
  contractEndOn   DateTime? @map("contract_end_dt") @db.Date
  billingBasis    String?   @map("billing_basis_cd") @db.VarChar(10)
  // 비어 있으면 무제한
  maxUserCount    Int?      @map("max_user_cnt")
  maxCenterCount  Int?      @map("max_center_cnt")
  maxClientCount  Int?      @map("max_client_cnt")
  billingEmail    String?   @map("billing_email") @db.VarChar(100)
  taxInvoiceEmail String?   @map("tax_invoice_email") @db.VarChar(100)
  // 유입 경로 (플랫폼 관리자만 표시, 값 목록은 아직 정하지 않음)
  salesChannel    String?   @map("sales_channel_cd") @db.VarChar(20)

  // ── ⑥ 출력 설정 [2차] (파일 표가 생기면 로고·직인에 외래 키를 건다)
  printCompanyName String? @map("print_company_nm") @db.VarChar(100)
  logoFileId       BigInt? @map("logo_file_id")
  stampFileId      BigInt? @map("stamp_file_id")

  // ── ⑦ 확장·시스템
  extAttr Json?   @map("ext_attr")
  // 비고 [1차, 기본 정보 아래]
  remark  String? @db.VarChar(1000)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  contacts OperatorContact[]

  // 이 운영사의 데이터 (운영사를 지울 수 없게 Restrict)
  users            User[]
  permissionGroups PermissionGroup[]
  centers          Center[]
  warehouses       Warehouse[]
  locations        Location[]
  shippers         Shipper[]
  externalCodes    ExternalCode[]
  codeGroups       CodeGroup[]
  codeItems        CodeItem[]
  deliveryZones    DeliveryZone[]
  units            Unit[]
  items            Item[]
  customers        Customer[]
  stocks           Stock[]
  stockTxns        StockTxn[]
  asns             Asn[]
  asnLines         AsnLine[]
  receipts         InboundReceipt[]
  receiptLines     InboundReceiptLine[]
  inspections      InboundInspection[]
  labels           InboundLabel[]
  putaways         Putaway[]
  stockAdjusts     StockAdjust[]
  stockAdjustLines StockAdjustLine[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 운영사코드는 삭제 안 된 것끼리만 겹치면 안 된다 (0038)
  @@unique([code], where: raw("del_yn = 'N'"), map: "tb_operator_operator_cd_key")
  @@map("tb_operator")
}

// 운영사 담당자 [1차] (최대 5명, 화면에서 정한 순서대로). 감사 칸 없이 운영사 이력으로 본다 (0038, 사용자 결정)
model OperatorContact {
  id           BigInt   @id @default(autoincrement()) @map("contact_id")
  operatorId   BigInt   @map("operator_id")
  sortOrder    Int      @map("sort_seq")
  // 담당 업무: 운영사 공통코드 CONTACT_ROLE의 코드 (예: INBOUND, 0030)
  duty         String   @map("role_cd") @db.VarChar(20)
  name         String   @map("contact_nm") @db.VarChar(50)
  phone        String?  @map("tel_no") @db.VarChar(15)
  email        String?  @db.VarChar(100)
  // 대표 담당자 (담당자가 있으면 정확히 1명)
  isPrimary    String   @default("N") @map("primary_yn") @db.Char(1)
  // [2차] 부서·직책·알림 수신
  deptName     String?  @map("dept_nm") @db.VarChar(50)
  positionName String?  @map("position_nm") @db.VarChar(50)
  notifyYn     String   @default("Y") @map("notify_yn") @db.Char(1)
  operator     Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, sortOrder])
  @@map("tb_operator_contact")
}

// 운영사 제공 서비스 [2차]: 운영사 공통코드 SERVICE_TYPE (운영사 이력으로 본다)
model OperatorService {
  operatorId BigInt   @map("operator_id")
  serviceCd  String   @map("service_cd") @db.VarChar(20)
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@id([operatorId, serviceCd])
  @@map("tb_operator_service")
}

// 운영사 취급 온도대 [2차]: TEMP_ZONE (AMBIENT·CHILLED·FROZEN·CONSTANT, 상수 + 검사 조건)
model OperatorTempZone {
  operatorId BigInt   @map("operator_id")
  tempZoneCd String   @map("temp_zone_cd") @db.VarChar(20)
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@id([operatorId, tempZoneCd])
  @@map("tb_operator_temp_zone")
}

// 외부 코드 매핑 (docs/decisions/0025): 우리 기준정보 ↔ SAP·ERP 등 외부 시스템 코드
// 한 줄 = 연동 상대 + 대상 종류 + 대상 id + 외부 코드
// - 같은 운영사·같은 연동 상대·같은 종류 안에서 외부 코드 중복 금지
// - 한 대상은 연동 상대마다 외부 코드 1개
model ExternalCode {
  id         BigInt             @id @default(autoincrement()) @map("ext_code_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId BigInt             @map("operator_id")
  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 연동 상대 키 (src/config/external-systems.ts)
  system     String             @map("ext_system_cd")
  entityType ExternalEntityType @map("entity_type_cd")
  entityId   BigInt             @map("entity_id")
  code       String             @map("ext_cd")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([operatorId, system, entityType, code])
  @@unique([system, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tb_ext_code")
}

enum ExternalEntityType {
  CENTER
  WAREHOUSE
  LOCATION
  SHIPPER
  ITEM
  CUSTOMER
  DELIVERY_ZONE
  UNIT
}

// ── 공통코드 (docs/decisions/0030): 코드 그룹(서랍) → 코드(서랍 속 물건) 2단계
// 분류·표시용 값만 공통코드로 관리한다. 프로그램이 값에 따라 동작을 바꾸는 값(창고 유형 등)은 enum으로 둔다
// 업무 표에는 코드 글자(CodeItem.code)를 그대로 저장한다 (예: 담당자 업무 'INBOUND')

model CodeGroup {
  id          BigInt     @id @default(autoincrement()) @map("group_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt     @map("operator_id")
  operator    Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 그룹 코드: 영문 대문자·숫자·밑줄 (예: CONTACT_DUTY), 등록 후 변경 불가
  code        String     @map("group_cd")
  name        String     @map("group_nm")
  description String?
  sortOrder   Int        @default(0) @map("sort_seq")
  status      String     @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 시스템 그룹: 프로그램이 직접 쓰는 그룹 (시드가 만들고, 삭제할 수 없다)
  isSystem    String     @default("N") @map("system_yn") @db.Char(1)
  items       CodeItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String     @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String     @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int        @default(1) @map("row_version")

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 것은 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_code_group_operator_id_group_cd_key")
  @@map("tb_code_group")
}

model CodeItem {
  id          BigInt    @id @default(autoincrement()) @map("code_item_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt    @map("operator_id")
  operator    Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  groupId     BigInt    @map("group_id")
  // 코드: 그룹 안에서 중복 금지, 등록 후 변경 불가 (업무 표에 이 글자가 저장되므로)
  code        String    @map("code_item_cd")
  name        String    @map("code_item_nm")
  description String?
  sortOrder   Int       @default(0) @map("sort_seq")
  // 사용 중지: 새로 고를 때만 숨기고, 이미 저장된 값은 이름으로 계속 보여준다
  status      String    @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  group       CodeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String    @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int       @default(1) @map("row_version")

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([groupId, code], where: raw("del_yn = 'N'"), map: "tb_code_item_group_id_code_item_cd_key")
  @@index([groupId, sortOrder])
  @@index([operatorId])
  @@map("tb_code_item")
}

// ── 배송권역 (docs/decisions/0033): 센터가 배송을 담당하는 지역 묶음
// 코드 3층 (0025): systemCode DZ000001(자동·불변) / code(사용자 코드, 같은 센터 안 중복 금지) / 외부 코드(ExternalCode)
model DeliveryZone {
  id          BigInt               @id @default(autoincrement()) @map("zone_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt               @map("operator_id")
  operator    Operator             @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  centerId    BigInt               @map("center_id")
  systemCode  String               @unique @map("sys_cd")
  code        String               @map("zone_cd")
  name        String               @map("zone_nm")
  description String?
  // 우선순위 (0072): 다른 센터 권역과 같은 수준으로 겹칠 때 작은 번호가 먼저 (1~999, 기본 100)
  priority    Int                  @default(100) @map("priority_no")
  status      String               @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy   String               @default("system") @map("created_by") @db.VarChar(50)
  updatedBy   String               @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion  Int                  @default(1) @map("row_version")
  center      Center               @relation(fields: [centerId], references: [id], onDelete: Restrict)
  regions     DeliveryZoneRegion[]

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@unique([centerId, code], where: raw("del_yn = 'N'"), map: "tb_delivery_zone_center_id_zone_cd_key")
  @@index([centerId])
  @@index([operatorId])
  @@map("tb_delivery_zone")
}

// 배송권역의 담당 지역: 법정동코드 앞자리 (시·도 2자리 = 그 시·도 전체, 시·군·구 5자리)
// 같은 센터 안에서는 한 지역이 권역 하나에만 (서울 전체 + 서울 종로구처럼 겹치는 것도 금지) — 저장할 때 검사
// 센터끼리는 겹쳐도 된다 (출고 때 화주사 이용 센터 기준으로 고른다)
model DeliveryZoneRegion {
  id         BigInt       @id @default(autoincrement()) @map("zone_region_id")
  zoneId     BigInt       @map("zone_id")
  regionCode String       @map("region_cd")
  zone       DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, regionCode])
  @@index([regionCode])
  @@map("tb_delivery_zone_region")
}

// ── 단위 (docs/decisions/0034): 품목의 기본단위·환산단위로 고르는 목록
// 시스템 코드 없이 표준 코드(EA·KG·BOX…)를 그대로 쓴다 (0025). 외부 코드는 ExternalCode(UNIT)
enum UnitKind {
  // 기본단위: 재고를 세는 단위 (재고는 항상 이 단위로 저장)
  BASE
  // 환산단위: 기본단위를 묶은 단위 (품목마다 입수량을 정한다)
  PACK
}

model Unit {
  id         BigInt   @id @default(autoincrement()) @map("unit_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 등록 후 바꿀 수 없다 (품목·재고에 이 글자가 저장된다)
  code       String   @map("unit_cd")
  name       String   @map("unit_nm")
  kind       UnitKind @map("unit_kind_cd")
  // 소수 자리수: 기본단위의 수량 입력·검사 기준 (EA 0, KG 3). 환산단위는 0
  decimals   Int      @default(0) @map("decimal_cnt")
  sortOrder  Int      @default(0) @map("sort_seq")
  status     String   @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  // 시스템 단위: 프로그램이 직접 쓰는 단위 (EA, 라벨 단위 BOX·PLT) — 삭제·사용 중지·종류 변경 불가
  isSystem   String   @default("N") @map("system_yn") @db.Char(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  // 이 단위를 쓰는 품목 (기본단위 / 환산단위) — 쓰이고 있으면 지울 수 없다
  baseItems Item[]     @relation("ItemBaseUnit")
  packItems ItemUnit[] @relation("ItemPackUnit")

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 코드는 삭제 안 된 것끼리만 겹치면 안 된다 (지운 코드는 다시 쓸 수 있다, 0038)
  @@unique([operatorId, code], where: raw("del_yn = 'N'"), map: "tb_unit_operator_id_unit_cd_key")
  @@map("tb_unit")
}

// ── 품목 (docs/decisions/0041, 0003 결정 2·3·6): 화주사가 맡긴 상품의 관리 단위
// 코드 3층 (0025): systemCode IT00000001(자동·불변) / code(품목코드, 같은 화주사 안에서 중복 금지, 비우면 시스템 코드) / 외부 코드(ExternalCode ITEM)
// 로트·유통기한 사용·라벨 단위는 비어 있으면 "화주사 기본값 따름" (화주사 기본값을 바꾸면 함께 바뀐다, 사용자 결정)
model Item {
  id         BigInt   @id @default(autoincrement()) @map("item_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  shipperId  BigInt   @map("shipper_id")
  shipper    Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  systemCode String   @unique @map("sys_cd")
  code       String   @map("item_cd") @db.VarChar(30)
  name       String   @map("item_nm") @db.VarChar(200)
  // 규격 (예: 500ml × 20, 선택)
  spec       String?  @map("spec_nm") @db.VarChar(100)
  // 바코드 (선택, 같은 화주사 안에서 중복 금지 — 나중에 스캐너 검수용)
  barcode    String?  @map("barcode_cd") @db.VarChar(50)
  // 기본단위: 재고를 세는 단위 (단위 표의 기본단위만). 재고는 항상 이 단위로 저장한다
  baseUnitId BigInt   @map("base_unit_id")
  baseUnit   Unit     @relation("ItemBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  // 관리 옵션: null = 화주사 기본값 따름, 'Y'/'N' = 이 품목만 따로
  useLot          String?    @map("lot_mgmt_yn") @db.Char(1)
  useExpiry       String?    @map("expiry_mgmt_yn") @db.Char(1)
  labelUnit       LabelUnit? @map("label_unit_cd")
  // 유통기한 임박 기준 일수 (유통기한을 쓸 때만, 유통기한까지 이 일수 이하로 남으면 "임박")
  expiryAlertDays Int?       @map("expiry_alert_day_cnt")

  remark     String?  @db.VarChar(1000)
  status     String   @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  // 환산단위 (BOX·CARTON·PLT… + 입수량)
  units       ItemUnit[]
  stocks      Stock[]
  asnLines    AsnLine[]
  inspections InboundInspection[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 품목코드·바코드는 같은 화주사의 삭제 안 된 것끼리만 겹치면 안 된다 (0038)
  @@unique([shipperId, code], where: raw("del_yn = 'N'"), map: "tb_item_shipper_id_item_cd_key")
  @@unique([shipperId, barcode], where: raw("del_yn = 'N' AND barcode_cd IS NOT NULL"), map: "tb_item_shipper_id_barcode_cd_key")
  @@index([operatorId])
  @@index([baseUnitId])
  @@map("tb_item")
}

// 품목 환산단위: 기본단위를 묶은 단위와 입수량 (예: 생수 BOX = 24 EA, PLT = 1,440 EA)
// 입수량은 기본단위 기준이고, 소수 자리는 기본단위의 소수 자리수까지 (KG면 2.5 가능). 품목의 이력으로 본다 (0038)
model ItemUnit {
  id        BigInt  @id @default(autoincrement()) @map("item_unit_id")
  itemId    BigInt  @map("item_id")
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // 환산단위 (단위 표의 환산단위만)
  unitId    BigInt  @map("unit_id")
  unit      Unit    @relation("ItemPackUnit", fields: [unitId], references: [id], onDelete: Restrict)
  // 입수량: 이 단위 1개에 든 기본단위 수
  convQty   Decimal @map("conv_cnt") @db.Decimal(18, 3)
  sortOrder Int     @default(0) @map("sort_seq")

  @@unique([itemId, unitId])
  @@index([unitId])
  @@map("tb_item_unit")
}

// ── 거래처 (docs/decisions/0043): 화주사의 고객사 — 출고(MVP 이후) 때 물건을 받는 곳
// 코드 3층 (0025): systemCode CU00000001(자동·불변) / code(거래처코드, 같은 화주사 안에서 중복 금지, 비우면 시스템 코드) / 외부 코드(ExternalCode CUSTOMER)
model Customer {
  id             BigInt   @id @default(autoincrement()) @map("customer_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId     BigInt   @map("operator_id")
  operator       Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  shipperId      BigInt   @map("shipper_id")
  shipper        Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  systemCode     String   @unique @map("sys_cd")
  code           String   @map("customer_cd") @db.VarChar(30)
  name           String   @map("customer_nm") @db.VarChar(200)
  // 사업자등록번호·전화번호는 하이픈 없이 숫자만 (0029)
  businessNumber String?  @map("biz_reg_no") @db.Char(10)
  ceoName        String?  @map("ceo_nm") @db.VarChar(50)
  phone          String?  @map("tel_no") @db.VarChar(15)
  email          String?  @db.VarChar(100)

  // ── 배송지: 카카오 우편번호 서비스로 검색해 채우고, 상세주소만 직접 입력
  zipCode          String? @map("zip_cd") @db.VarChar(10)
  address          String? @map("addr1") @db.VarChar(200)
  addressDetail    String? @map("addr2") @db.VarChar(200)
  // 법정동코드 10자리 (주소 검색 결과를 자동 저장, 화면 미노출) — 배송권역(앞 2·5자리)과 맞춰 본다
  regionCode       String? @map("region_cd") @db.Char(10)
  receiverName     String? @map("receiver_nm") @db.VarChar(50)
  receiverPhone    String? @map("receiver_tel_no") @db.VarChar(15)
  // 배송 메모 (예: 정문 경비실에 맡겨 주세요)
  deliveryMemo     String? @map("delivery_memo") @db.VarChar(200)
  // 배송 센터 (0072): 배송권역이 겹칠 때 맨 먼저 따르는 지정. 화주사 이용 센터 중 하나, 비우면 권역 규칙으로
  deliveryCenterId BigInt? @map("delivery_center_id")
  deliveryCenter   Center? @relation(fields: [deliveryCenterId], references: [id], onDelete: Restrict)

  remark     String?  @db.VarChar(1000)
  status     String   @default("ACTIVE") @map("status_cd") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 등록·수정한 사람 아이디(username, 자동: 현재 작업자 / 시드 seed / 기존 데이터 system), 동시 수정 막기용 버전 (docs/db-conventions.md 공통 칸)
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  contacts CustomerContact[]

  // 논리 삭제: 'Y'면 지운 것 (목록·조회에서 빠지고 되살릴 수 있다, 0038)
  delYn String @default("N") @map("del_yn") @db.Char(1)

  // 거래처코드는 같은 화주사의 삭제 안 된 것끼리만 겹치면 안 된다 (0038)
  @@unique([shipperId, code], where: raw("del_yn = 'N'"), map: "tb_customer_shipper_id_customer_cd_key")
  @@index([operatorId])
  @@index([regionCode])
  @@index([deliveryCenterId])
  @@map("tb_customer")
}

// 거래처 담당자 (화주사·운영사 담당자와 같은 모양: 최대 5명, 대표 1명, 담당 업무는 공통코드 CONTACT_ROLE). 거래처의 이력으로 본다 (0038)
model CustomerContact {
  id         BigInt   @id @default(autoincrement()) @map("contact_id")
  customerId BigInt   @map("customer_id")
  sortOrder  Int      @map("sort_seq")
  duty       String   @map("role_cd") @db.VarChar(20)
  name       String   @map("contact_nm") @db.VarChar(50)
  phone      String?  @map("tel_no") @db.VarChar(15)
  email      String?  @db.VarChar(100)
  isPrimary  String   @default("N") @map("primary_yn") @db.Char(1)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sortOrder])
  @@map("tb_customer_contact")
}

// ── 재고 (docs/decisions/0044, 0003 결정 4): 한 줄 = 재고 주소 하나의 지금 수량
// 재고 주소: 센터 + 창고 + 로케이션 + 화주사 + 품목 + 로트번호 + 유통기한
// - 수량은 직접 고치지 않는다: 재고 변경 공통 함수(이력 기록과 한 트랜잭션)로만 바꾼다 (CLAUDE.md)
// - 수량은 기본단위, Decimal. 로트·유통기한을 쓰지 않는 품목은 비어 있다(null)
// - 같은 주소는 한 줄: 로케이션 + 품목 + 로트 + 유통기한 고유 (빈 칸도 같게 본다 — NULLS NOT DISTINCT, 마이그레이션 SQL에서)
// - 센터·창고·화주사는 로케이션·품목에서 정해지지만 조회가 빠르도록 함께 둔다 (재고 변경 함수가 맞춰 넣는다)
// - 수량이 0이 돼도 줄은 남긴다 (이력이 이 줄을 가리킨다)
model Stock {
  id          BigInt    @id @default(autoincrement()) @map("stock_id")
  // 운영사 (멀티테넌트: 같은 운영사 사람만 보고 고친다, docs/decisions/0039)
  operatorId  BigInt    @map("operator_id")
  operator    Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  centerId    BigInt    @map("center_id")
  center      Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  warehouseId BigInt    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId  BigInt    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shipperId   BigInt    @map("shipper_id")
  shipper     Shipper   @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  itemId      BigInt    @map("item_id")
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotNo       String?   @map("lot_no") @db.VarChar(50)
  expiryOn    DateTime? @map("expiry_dt") @db.Date

  // 수량 (기본단위). 0 이상
  qty          Decimal @default(0) @map("stock_qty") @db.Decimal(18, 3)
  // 할당(출고 예약) 수량: 0 이상, 수량 이하 (출고 작업에서 쓴다, 사용자 결정으로 미리 둔다)
  allocatedQty Decimal @default(0) @map("alloc_qty") @db.Decimal(18, 3)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // 동시 처리 안전: 재고 변경 함수가 줄을 잠그고 바꾼다. 버전은 화면 확인용
  rowVersion Int      @default(1) @map("row_version")

  txns         StockTxn[]
  receiptLines InboundReceiptLine[]
  adjustLines  StockAdjustLine[]

  @@unique([locationId, itemId, lotNo, expiryOn], map: "tb_stock_address_key")
  @@index([operatorId])
  @@index([centerId, shipperId, itemId])
  @@index([itemId])
  @@map("tb_stock")
}

// 재고 이력 유형 (프로그램이 값에 따라 동작이 다르므로 enum, 0030)
enum StockTxnType {
  // 입고 확정: 입고대기 창고에 재고가 생긴다
  RECEIVE
  // 이동(적치 포함): 출발 로케이션에서 나감 / 도착 로케이션에 들어옴 (두 줄, 같은 묶음 번호)
  MOVE_OUT
  MOVE_IN
  // 재고 조정: 사유 필수
  ADJUST
}

// 재고 이력 (docs/decisions/0044): 수량이 바뀐 한 번 = 한 줄. 지우거나 고치지 않는 기록 (DB가 막는다)
// 주소 칸은 그때 모습 그대로 함께 둔다 (재고 줄과 같지만, 이력만 봐도 알 수 있게)
model StockTxn {
  id          BigInt       @id @default(autoincrement()) @map("stock_txn_id")
  operatorId  BigInt       @map("operator_id")
  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  stockId     BigInt       @map("stock_id")
  stock       Stock        @relation(fields: [stockId], references: [id], onDelete: Restrict)
  centerId    BigInt       @map("center_id")
  warehouseId BigInt       @map("warehouse_id")
  locationId  BigInt       @map("location_id")
  shipperId   BigInt       @map("shipper_id")
  itemId      BigInt       @map("item_id")
  lotNo       String?      @map("lot_no") @db.VarChar(50)
  expiryOn    DateTime?    @map("expiry_dt") @db.Date
  type        StockTxnType @map("txn_type_cd")
  // 변동 수량 (+ 늘어남 / − 줄어듦, 기본단위, 0 아님)과 변동 후 수량
  qtyChange   Decimal      @map("chg_qty") @db.Decimal(18, 3)
  qtyAfter    Decimal      @map("after_qty") @db.Decimal(18, 3)
  // 묶음 번호: 이동처럼 여러 줄이 한 번의 작업일 때 같은 값 (첫 줄의 이력 키)
  groupId     BigInt?      @map("txn_group_id")
  // 원본 문서: 종류(예: RECEIPT 입고확정, ADJUSTMENT 조정) + 키 + 화면에 보일 번호
  refType     String?      @map("ref_type_cd") @db.VarChar(20)
  refId       BigInt?      @map("ref_id")
  refNo       String?      @map("ref_no") @db.VarChar(50)
  // 사유 (조정은 필수)
  reason      String?      @db.VarChar(200)
  txnAt       DateTime     @default(now()) @map("txn_at")
  // 처리한 사람 아이디 (재고 변경 함수가 지금 작업자로 채운다)
  createdBy   String       @default("system") @map("created_by") @db.VarChar(50)

  @@index([stockId, txnAt])
  @@index([operatorId, txnAt])
  @@index([itemId, txnAt])
  @@index([locationId, txnAt])
  @@index([refType, refId])
  @@index([groupId])
  @@map("tb_stock_txn")
}

// ─── 입고 (M5, docs/decisions/0047) ─────────────────────────
// ASN(입고예정) 하나에 검수·입고 확정이 여러 번 나눠 일어날 수 있다 (0003 결정 5)
// ASN (헤더 + 라인) └ 입고확정 1차 (문서 + 라인) → 입고대기 창고에 재고 생성 └ 적치 …

// 입고 유형: 화주사가 보낸 물건 / 다른 센터에서 이동해 온 물건 (MVP 이후)
enum InboundType {
  SHIPPER
  TRANSFER
}

// 등록 경로: 화주 포털 / 센터 대리 등록 / 엑셀 업로드
enum AsnChannel {
  PORTAL
  PROXY
  EXCEL
}

// 입고 상태: 예정 → 검수중 → 부분확정 → 확정완료, 또는 → 마감
enum AsnStatus {
  PLANNED
  INSPECTING
  PARTIAL
  COMPLETED
  CLOSED
}

// 적치 상태: 적치대기 → 부분적치 → 적치완료
enum PutawayStatus {
  WAITING
  PARTIAL
  DONE
}

// ASN 헤더
model Asn {
  id         BigInt   @id @default(autoincrement()) @map("asn_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  centerId   BigInt   @map("center_id")
  center     Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)
  shipperId  BigInt   @map("shipper_id")
  shipper    Shipper  @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  // ASN 번호 (자동: AS + 등록일 YYMMDD + '-' + 일련번호, 운영사 전체에서 하나)
  asnNo      String   @unique @map("asn_no") @db.VarChar(20)

  type         InboundType @default(SHIPPER) @map("inbound_type_cd")
  channel      AsnChannel  @map("reg_channel_cd")
  // 입고 예정일
  expectedOn   DateTime    @map("expected_dt") @db.Date
  // 화주사 쪽 문서 번호 (발주번호 등, 선택)
  shipperRefNo String?     @map("shipper_ref_no") @db.VarChar(50)
  remark       String?     @db.VarChar(1000)

  status        AsnStatus     @default(PLANNED) @map("asn_status_cd")
  putawayStatus PutawayStatus @default(WAITING) @map("putaway_status_cd")
  // 잔량 마감 (사유 필수, 마감자·일시)
  closeReason   String?       @map("close_reason") @db.VarChar(200)
  closedAt      DateTime?     @map("closed_at")
  closedBy      String?       @map("closed_by") @db.VarChar(50)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @default("system") @map("created_by") @db.VarChar(50)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(50)
  rowVersion Int      @default(1) @map("row_version")

  lines       AsnLine[]
  receipts    InboundReceipt[]
  inspections InboundInspection[]

  // 논리 삭제: 예정(PLANNED) 상태에서만 지울 수 있다
  delYn String @default("N") @map("del_yn") @db.Char(1)

  @@index([operatorId])
  @@index([centerId, status])
  @@index([shipperId, expectedOn])
  @@map("tb_asn")
}

// ASN 라인 (헤더와 통째로 바뀌는 하위 표: 감사 칸은 헤더 이력으로 본다)
// 수량은 모두 기본단위. 잔량 = max(예정 − 누적 확정, 0), 초과 = max(누적 확정 − 예정, 0) 은 저장하지 않고 계산한다
model AsnLine {
  id         BigInt   @id @default(autoincrement()) @map("asn_line_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  asnId      BigInt   @map("asn_id")
  asn        Asn      @relation(fields: [asnId], references: [id], onDelete: Restrict)
  lineNo     Int      @map("line_no")
  itemId     BigInt   @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // 예정 수량 (기본단위)
  expectedQty Decimal   @map("expected_qty") @db.Decimal(18, 3)
  // 입력한 단위·수량 (화면 표시용, 예: BOX 3 → 예정 72 EA)
  entryUnit   String?   @map("entry_unit_cd") @db.VarChar(20)
  entryQty    Decimal?  @map("entry_qty") @db.Decimal(18, 3)
  // 화주사가 알려 준 로트·유통기한 (참고용, 검수에서 실제 값을 넣는다)
  lotNo       String?   @map("lot_no") @db.VarChar(50)
  expiryOn    DateTime? @map("expiry_dt") @db.Date

  // 누적 수량 (입고 확정·적치·마감 때 함께 바뀐다)
  confirmedQty Decimal @default(0) @map("confirmed_qty") @db.Decimal(18, 3)
  putawayQty   Decimal @default(0) @map("putaway_qty") @db.Decimal(18, 3)
  // 마감 때 남아 있던 잔량 (보고서용)
  closedQty    Decimal @default(0) @map("closed_qty") @db.Decimal(18, 3)
  remark       String? @db.VarChar(200)

  receiptLines InboundReceiptLine[]
  inspections  InboundInspection[]

  @@unique([asnId, lineNo])
  @@index([itemId])
  @@index([operatorId])
  @@map("tb_asn_line")
}

// 입고확정 문서: 확정할 때마다 하나 (부분 확정이면 ASN 하나에 여러 개)
model InboundReceipt {
  id          BigInt   @id @default(autoincrement()) @map("receipt_id")
  operatorId  BigInt   @map("operator_id")
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  asnId       BigInt   @map("asn_id")
  asn         Asn      @relation(fields: [asnId], references: [id], onDelete: Restrict)
  // 확정 번호 (자동: RC + YYMMDD + '-' + 일련번호)
  receiptNo   String   @unique @map("receipt_no") @db.VarChar(20)
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  confirmedBy String   @default("system") @map("confirmed_by") @db.VarChar(50)
  remark      String?  @db.VarChar(200)

  lines InboundReceiptLine[]

  @@index([asnId])
  @@index([operatorId, confirmedAt])
  @@map("tb_inbound_receipt")
}

// 입고확정 라인: 확정 수량이 입고대기 창고의 어느 재고 줄이 됐는지 (적치는 이 줄의 재고만)
model InboundReceiptLine {
  id           BigInt            @id @default(autoincrement()) @map("receipt_line_id")
  operatorId   BigInt            @map("operator_id")
  operator     Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  receiptId    BigInt            @map("receipt_id")
  receipt      InboundReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  asnLineId    BigInt            @map("asn_line_id")
  asnLine      AsnLine           @relation(fields: [asnLineId], references: [id], onDelete: Restrict)
  // 어느 검수 결과를 확정했는지 (확정은 검수된 수량에서만)
  inspectionId BigInt            @map("inspection_id")
  inspection   InboundInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  // 만들어진(또는 더해진) 재고 줄 = 입고대기 창고 로케이션 + 품목 + 로트 + 유통기한
  stockId      BigInt            @map("stock_id")
  stock        Stock             @relation(fields: [stockId], references: [id], onDelete: Restrict)
  stockTxnId   BigInt            @map("stock_txn_id")
  lotNo        String?           @map("lot_no") @db.VarChar(50)
  expiryOn     DateTime?         @map("expiry_dt") @db.Date

  // 확정 수량 (기본단위)과 그중 적치한 수량
  qty        Decimal @map("confirm_qty") @db.Decimal(18, 3)
  putawayQty Decimal @default(0) @map("putaway_qty") @db.Decimal(18, 3)

  putaways Putaway[]

  @@index([receiptId])
  @@index([asnLineId])
  @@index([inspectionId])
  @@index([stockId])
  @@index([operatorId])
  @@map("tb_inbound_receipt_line")
}

// 입고 검수 결과 (docs/decisions/0053): ASN 라인 하나에 여러 건 (로트·유통기한이 다르게 도착하면 나눠 적는다)
// 검수 수량(정상)만 입고 확정할 수 있고, 불량 수량은 기록만 한다. 수량은 모두 기본단위
model InboundInspection {
  id         BigInt   @id @default(autoincrement()) @map("inspection_id")
  operatorId BigInt   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  asnId      BigInt   @map("asn_id")
  asn        Asn      @relation(fields: [asnId], references: [id], onDelete: Restrict)
  asnLineId  BigInt   @map("asn_line_id")
  asnLine    AsnLine  @relation(fields: [asnLineId], references: [id], onDelete: Restrict)
  itemId     BigInt   @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // 로트·유통기한: 품목 설정에 따라 필수 또는 null
  lotNo    String?   @map("lot_no") @db.VarChar(50)
  expiryOn DateTime? @map("expiry_dt") @db.Date

  // 검수 수량(정상, 확정 가능) · 불량 수량 · 그중 확정한 수량
  inspectedQty Decimal  @map("inspect_qty") @db.Decimal(18, 3)
  defectQty    Decimal  @default(0) @map("defect_qty") @db.Decimal(18, 3)
  confirmedQty Decimal  @default(0) @map("confirmed_qty") @db.Decimal(18, 3)
  // 입력한 단위·수량 (화면 표시용, 예: BOX 5)
  entryUnit    String?  @map("entry_unit_cd") @db.VarChar(20)
  entryQty     Decimal? @map("entry_qty") @db.Decimal(18, 3)
  remark       String?  @db.VarChar(200)

  inspectedAt DateTime @default(now()) @map("inspected_at")
  inspectedBy String   @default("system") @map("inspected_by") @db.VarChar(50)

  receiptLines InboundReceiptLine[]
  labels       InboundLabel[]

  @@index([asnId])
  @@index([asnLineId])
  @@index([operatorId])
  @@map("tb_inbound_inspection")
}

// 관리 라벨 (docs/decisions/0054): 검수 결과 하나 → 라벨 여러 장 (라벨 단위 입수량으로 나누고 마지막 장은 나머지, 0003 결정 6)
// 라벨 번호는 하나뿐이고, 같은 라벨을 다시 인쇄(재발행)하면 인쇄 횟수만 는다
model InboundLabel {
  id            BigInt            @id @default(autoincrement()) @map("label_id")
  operatorId    BigInt            @map("operator_id")
  operator      Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 라벨 번호 (자동: LB + YYMMDD + '-' + 일련번호)
  labelNo       String            @unique @map("label_no") @db.VarChar(20)
  inspectionId  BigInt            @map("inspection_id")
  inspection    InboundInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  // 몇 번째 장 / 모두 몇 장 (예: 2 / 3)
  seq           Int               @map("label_seq")
  total         Int               @map("label_cnt")
  // 라벨 단위(PLT·BOX)와 이 장의 수량 (기본단위)
  labelUnit     LabelUnit         @map("label_unit_cd")
  qty           Decimal           @map("label_qty") @db.Decimal(18, 3)
  // 2D 코드에 담은 글자와 그 형식 버전 (항목이 늘어도 스캐너가 구분하게, 0003)
  formatVersion Int               @map("format_ver")
  payload       String            @db.VarChar(500)

  printCount    Int       @default(0) @map("print_cnt")
  lastPrintedAt DateTime? @map("last_printed_at")
  lastPrintedBy String?   @map("last_printed_by") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @default("system") @map("created_by") @db.VarChar(50)

  @@unique([inspectionId, seq])
  @@index([operatorId])
  @@map("tb_inbound_label")
}

// 적치 기록 (docs/decisions/0058): 입고확정 라인의 재고를 입고대기 창고 → 보관 로케이션으로 옮긴 한 번
// 실제 재고 이동은 재고 변경 공통 함수(moveStock)가 하고, 여기는 어느 확정분을 어디로 얼마나 옮겼는지 남긴다
model Putaway {
  id             BigInt             @id @default(autoincrement()) @map("putaway_id")
  operatorId     BigInt             @map("operator_id")
  operator       Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  receiptLineId  BigInt             @map("receipt_line_id")
  receiptLine    InboundReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  asnId          BigInt             @map("asn_id")
  itemId         BigInt             @map("item_id")
  fromLocationId BigInt             @map("from_location_id")
  toLocationId   BigInt             @map("to_location_id")
  lotNo          String?            @map("lot_no") @db.VarChar(50)
  expiryOn       DateTime?          @map("expiry_dt") @db.Date
  qty            Decimal            @map("putaway_qty") @db.Decimal(18, 3)
  // 재고 이력의 묶음 번호 (나감·들어옴 두 줄)
  txnGroupId     BigInt             @map("txn_group_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  createdBy      String             @default("system") @map("created_by") @db.VarChar(50)

  @@index([receiptLineId])
  @@index([asnId])
  @@index([operatorId, createdAt])
  @@map("tb_putaway")
}

// ─── 재고 실사·조정 (M6, docs/decisions/0061) ─────────────────
// 작업자가 등록하고(등록) 관리자가 확정하면(확정) 재고가 바뀐다 (권한 stock.adjustments.create / confirm)

// 실사: 센 수량을 적고 확정 때 (센 수량 − 그때 재고)만큼 바꾼다 / 조정: 늘리거나 줄일 수량(±)을 적는다
enum StockAdjustType {
  COUNT
  ADJUST
}

enum StockAdjustStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

model StockAdjust {
  id         BigInt            @id @default(autoincrement()) @map("adjust_id")
  operatorId BigInt            @map("operator_id")
  operator   Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // 번호 (자동: AJ + YYMMDD + '-' + 일련번호)
  adjustNo   String            @unique @map("adjust_no") @db.VarChar(20)
  type       StockAdjustType   @map("adjust_type_cd")
  centerId   BigInt            @map("center_id")
  status     StockAdjustStatus @default(DRAFT) @map("adjust_status_cd")
  // 사유 (필수)
  reason     String            @db.VarChar(200)
  remark     String?           @db.VarChar(500)

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @default("system") @map("created_by") @db.VarChar(50)
  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") @db.VarChar(50)
  canceledAt  DateTime? @map("canceled_at")
  canceledBy  String?   @map("canceled_by") @db.VarChar(50)

  lines StockAdjustLine[]

  @@index([operatorId, createdAt])
  @@index([centerId, status])
  @@map("tb_stock_adjust")
}

// 실사·조정 줄: 재고 줄 하나 (로케이션 + 품목 + 로트 + 유통기한)
model StockAdjustLine {
  id         BigInt      @id @default(autoincrement()) @map("adjust_line_id")
  operatorId BigInt      @map("operator_id")
  operator   Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  adjustId   BigInt      @map("adjust_id")
  adjust     StockAdjust @relation(fields: [adjustId], references: [id], onDelete: Cascade)
  lineNo     Int         @map("line_no")
  stockId    BigInt      @map("stock_id")
  stock      Stock       @relation(fields: [stockId], references: [id], onDelete: Restrict)

  // 등록 때 재고 (참고) / 실사: 센 수량 / 조정: 바꿀 수량(±)
  systemQty  Decimal  @map("system_qty") @db.Decimal(18, 3)
  countedQty Decimal? @map("counted_qty") @db.Decimal(18, 3)
  changeQty  Decimal? @map("chg_qty") @db.Decimal(18, 3)
  // 확정 때 실제로 바꾼 수량과 재고 이력 (0이면 바꾸지 않음 → 이력 없음)
  appliedQty Decimal? @map("applied_qty") @db.Decimal(18, 3)
  stockTxnId BigInt?  @map("stock_txn_id")

  @@unique([adjustId, lineNo])
  @@unique([adjustId, stockId])
  @@index([stockId])
  @@index([operatorId])
  @@map("tb_stock_adjust_line")
}
